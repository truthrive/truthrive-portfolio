---
import { caseStudies } from '../data/caseStudies';
---

<!-- Featured Case Study Showcase (Sticky Horizontal Story Slider) -->
<section class="case-showcase-section" id="case-studies">
  <div class="case-showcase-wrapper" id="case-showcase-wrapper">
    <div class="case-showcase-sticky" id="case-showcase-sticky">
      <!-- Row 1: Section Header + Story Progress (inside container) -->
      <div class="container">
        <div class="case-showcase-header-row">
          <div class="section-heading case-showcase-heading">
            <p class="section-kicker">SELECTED SEO CASE STUDIES</p>
            <h2 class="section-title">Case Study nổi bật</h2>
            <p class="section-subtitle">
              Hành trình tăng trưởng Organic Search qua các dự án thực tế tiêu biểu.
            </p>
          </div>

          <!-- Compact Story Progress Indicator -->
          <div class="case-story-progress" id="case-story-progress">
            <span class="story-progress__count">
              <strong id="story-current-num">01</strong> / 04
            </span>
            <div class="story-progress__bar" aria-hidden="true">
              <div class="story-progress__fill" id="story-progress-fill" style="width: 25%;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2: Full-Bleed Viewport & Track (100vw width) -->
      <div class="case-showcase-viewport">
        <div class="case-showcase__track" id="case-showcase-track">
          {caseStudies.map((cs) => (
            <article class={`card case-story-card case-story-card--${cs.status} ${cs.cardModifierClass || ''}`} data-card-seq={cs.seq}>
              {/* Subtle Background Watermark (single background decoration) */}
              {cs.watermarkSrc && (
                <div class={`case-card__watermark ${cs.watermarkModifierClass || ''}`} aria-hidden="true">
                  <img src={cs.watermarkSrc} alt="" loading="lazy" />
                </div>
              )}

              {/* Left Column: Project Info (~58%) */}
              <div class="case-story-card__body">
                {/* Header: Logo & Badge */}
                <div class="case-story-card__header">
                  <div class="case-story-card__identity">
                    <div class="case-card__logo">
                      {cs.logoSrc ? (
                        <img src={cs.logoSrc} alt={cs.logoAlt} loading="lazy" width="52" height="52" />
                      ) : (
                        <span class="case-card__monogram">{cs.monogram}</span>
                      )}
                    </div>
                    <span class="pill" style="margin-bottom: 0;">{cs.badge}</span>
                  </div>
                  <span class="case-story-card__seq-badge">{cs.seq} / 04</span>
                </div>

                {/* Grouped Title, Role & Summary Content Block */}
                <div class="case-story-card__content-group">
                  <div class="case-story-card__title-area">
                    <h3 class="case-story-card__title">{cs.headline || cs.title}</h3>
                    {cs.compactRole && (
                      <span class="case-story-card__role-tag">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                          <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        {cs.compactRole}
                      </span>
                    )}
                  </div>

                  <p class="case-story-card__summary">{cs.summary}</p>

                  {/* Thách thức chính block */}
                  {cs.challenge && cs.challenge.length > 0 && (
                    <div class="case-story-card__challenges">
                      <span class="case-story-card__challenge-label">{cs.highlightsLabel || 'THÁCH THỨC CHÍNH'}</span>
                      <ul class="case-story-card__challenge-list">
                        {cs.challenge.slice(0, cs.highlightsLabel ? 3 : 2).map((item) => (
                          <li class="case-story-card__challenge-item">
                            <svg class="case-story-card__challenge-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <circle cx="12" cy="12" r="10"></circle>
                              <line x1="12" y1="8" x2="12" y2="12"></line>
                              <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>

              {/* Right Column: Results Panel (~42%) */}
              {cs.status === 'available' ? (
                <div class="results-panel">
                  <div class="results-panel__tiles">
                    {/* Primary Metric Tile */}
                    {cs.metrics && cs.metrics.length > 0 && (
                      <div class="results-tile results-tile--primary">
                        <span class="results-tile__icon" aria-hidden="true">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                            <polyline points="17 6 23 6 23 12"></polyline>
                          </svg>
                        </span>
                        <strong
                          class="results-tile__value animated-number"
                          data-scramble
                          data-final={cs.metrics[0].value}
                          aria-label={cs.metrics[0].value}
                          data-count-to={cs.metrics[0].countTo}
                          {...(cs.metrics[0].format ? { 'data-count-format': cs.metrics[0].format } : {})}
                          {...(cs.metrics[0].decimals ? { 'data-count-decimals': cs.metrics[0].decimals } : {})}
                          {...(cs.metrics[0].prefix ? { 'data-count-prefix': cs.metrics[0].prefix } : {})}
                          {...(cs.metrics[0].suffix ? { 'data-count-suffix': cs.metrics[0].suffix } : {})}
                        >{cs.metrics[0].value}</strong>
                        <span class="results-tile__label">{cs.metrics[0].label}</span>
                      </div>
                    )}

                    {/* Secondary Metrics (side by side below primary) */}
                    {cs.metrics && cs.metrics.length > 1 && (
                      <div class="results-panel__secondary-grid">
                        <div class="results-tile results-tile--secondary">
                          <span class="results-tile__icon" aria-hidden="true">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="11" cy="11" r="8"></circle>
                              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                          </span>
                          <strong
                            class={'results-tile__value' + (cs.metrics[1].countTo ? ' animated-number' : '')}
                            data-scramble
                            data-final={cs.metrics[1].value}
                            aria-label={cs.metrics[1].value}
                            {...(cs.metrics[1].countTo ? { 'data-count-to': cs.metrics[1].countTo } : {})}
                            {...(cs.metrics[1].format ? { 'data-count-format': cs.metrics[1].format } : {})}
                            {...(cs.metrics[1].decimals ? { 'data-count-decimals': cs.metrics[1].decimals } : {})}
                            {...(cs.metrics[1].prefix ? { 'data-count-prefix': cs.metrics[1].prefix } : {})}
                            {...(cs.metrics[1].suffix ? { 'data-count-suffix': cs.metrics[1].suffix } : {})}
                          >{cs.metrics[1].value}</strong>
                          <span class="results-tile__label">{cs.metrics[1].label}</span>
                        </div>

                        {cs.metrics[2] && (
                          <div class="results-tile results-tile--secondary">
                            <span class="results-tile__icon" aria-hidden="true">
                              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                              </svg>
                            </span>
                            <strong
                              class="results-tile__value animated-number"
                              data-scramble
                              data-final={cs.metrics[2].value}
                              aria-label={cs.metrics[2].value}
                              data-count-to={cs.metrics[2].countTo}
                              {...(cs.metrics[2].format ? { 'data-count-format': cs.metrics[2].format } : {})}
                              {...(cs.metrics[2].decimals ? { 'data-count-decimals': cs.metrics[2].decimals } : {})}
                              {...(cs.metrics[2].prefix ? { 'data-count-prefix': cs.metrics[2].prefix } : {})}
                              {...(cs.metrics[2].suffix ? { 'data-count-suffix': cs.metrics[2].suffix } : {})}
                            >{cs.metrics[2].value}</strong>
                            <span class="results-tile__label">{cs.metrics[2].label}</span>
                          </div>
                        )}

                        {cs.metrics[3] && (
                          <div class="results-tile results-tile--secondary">
                            <span class="results-tile__icon" aria-hidden="true">
                              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 3v18h18"></path>
                                <path d="m7 16 4-4 3 3 5-6"></path>
                              </svg>
                            </span>
                            <strong
                              class="results-tile__value animated-number"
                              data-scramble
                              data-final={cs.metrics[3].value}
                              aria-label={cs.metrics[3].value}
                              data-count-to={cs.metrics[3].countTo}
                              {...(cs.metrics[3].format ? { 'data-count-format': cs.metrics[3].format } : {})}
                              {...(cs.metrics[3].decimals ? { 'data-count-decimals': cs.metrics[3].decimals } : {})}
                              {...(cs.metrics[3].prefix ? { 'data-count-prefix': cs.metrics[3].prefix } : {})}
                              {...(cs.metrics[3].suffix ? { 'data-count-suffix': cs.metrics[3].suffix } : {})}
                            >{cs.metrics[3].value}</strong>
                            <span class="results-tile__label">{cs.metrics[3].label}</span>
                          </div>
                        )}
                      </div>
                    )}
                  </div>

                  {/* CTA Action visually separate from metric tiles */}
                  {cs.href && (
                    <div class="results-panel__action">
                      <a class="btn case-card__cta" href={cs.href}>
                        {cs.ctaText || 'Xem Case Study'} →
                      </a>
                    </div>
                  )}
                </div>
              ) : (
                <div class="results-panel results-panel--muted">
                  <div class="results-panel__tiles">
                    {/* Primary — shows collecting state */}
                    <div class="results-tile results-tile--primary">
                      <span class="results-tile__icon" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                          <polyline points="17 6 23 6 23 12"></polyline>
                        </svg>
                      </span>
                      <span class="results-tile__value results-tile__value--muted" aria-hidden="true">—</span>
                      <span class="results-tile__label">Đang tổng hợp dữ liệu</span>
                    </div>

                    {/* Secondary Metrics — masked */}
                    <div class="results-panel__secondary-grid">
                      <div class="results-tile results-tile--secondary results-tile--masked" aria-hidden="true">
                        <span class="results-tile__icon">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          </svg>
                        </span>
                        <span class="results-tile__value results-tile__value--muted">—</span>
                        <span class="results-tile__label">Đang tổng hợp</span>
                      </div>

                      <div class="results-tile results-tile--secondary results-tile--masked" aria-hidden="true">
                        <span class="results-tile__icon">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                          </svg>
                        </span>
                        <span class="results-tile__value results-tile__value--muted">—</span>
                        <span class="results-tile__label">Đang tổng hợp</span>
                      </div>
                    </div>
                  </div>

                  {/* Disabled CTA */}
                  <div class="results-panel__action">
                    <span class="btn case-card__cta case-card__cta--disabled" aria-disabled="true">
                      Coming soon
                    </span>
                  </div>

                  <div class="case-story-card__notice">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Full case study đang được chuẩn hóa</span>
                  </div>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>

      <!-- Mobile Slider Navigation Controls (Prev, Dots, Next) -->
      <div class="cs-mobile-controls" id="cs-mobile-controls">
        <button type="button" class="cs-mobile-btn" id="cs-mobile-prev" aria-label="Previous slide" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="cs-mobile-dots" id="cs-mobile-dots" aria-label="Slide indicators">
          {caseStudies.map((_, idx) => (
            <button
              type="button"
              class={`cs-mobile-dot ${idx === 0 ? 'is-active' : ''}`}
              data-slide-index={idx}
              aria-label={`Go to slide ${idx + 1}`}
            ></button>
          ))}
        </div>

        <button type="button" class="cs-mobile-btn" id="cs-mobile-next" aria-label="Next slide">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initCaseStudiesShowcase() {
    const wrapper = document.getElementById('case-showcase-wrapper');
    const sticky = document.getElementById('case-showcase-sticky');
    const track = document.getElementById('case-showcase-track');

    if (!(wrapper instanceof HTMLElement) || !(sticky instanceof HTMLElement) || !(track instanceof HTMLElement)) return;
    if (wrapper.dataset.showcaseInitialized === 'true') return;
    wrapper.dataset.showcaseInitialized = 'true';

    const header = document.querySelector('header');
    const currentNumEl = document.getElementById('story-current-num');
    const fillEl = document.getElementById('story-progress-fill');
    const cards = Array.from(track.children).filter((card): card is HTMLElement => card instanceof HTMLElement);
    const cardCount = cards.length;
    let scrollWidth = 0;
    let viewportWidth = 0;
    let isDesktop = false;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let maxTranslate = 0;
    let headerHeight = 0;
    let scrollRange = 0;

    const calculateDimensions = () => {
      isDesktop = window.innerWidth >= 1024;
      headerHeight = header instanceof HTMLElement ? header.offsetHeight : 80;

      if (isDesktop && !prefersReducedMotion) {
        wrapper.style.height = '';
        track.style.transform = 'translate3d(0, 0, 0)';
        track.style.paddingRight = '';
        sticky.style.top = '';
        sticky.style.height = '';

        viewportWidth = track.parentElement?.clientWidth || 0;

        const lastCard = cards[cards.length - 1];
        const cardWidth = lastCard ? lastCard.offsetWidth : 0;
        const centeringOffset = cardWidth > 0
          ? Math.max(0, (viewportWidth - cardWidth) / 2)
          : 0;

        if (centeringOffset > 0) {
          track.style.paddingRight = `${centeringOffset}px`;
        }

        scrollWidth = track.scrollWidth;
        maxTranslate = scrollWidth - viewportWidth;

        if (maxTranslate > 0) {
          sticky.style.top = `${headerHeight}px`;
          const availableStickyHeight = window.innerHeight - headerHeight;
          sticky.style.height = `${availableStickyHeight}px`;

          const vhStep = window.innerHeight * 0.55;
          const stepScroll = Math.min(Math.max(vhStep, 360), 560);
          scrollRange = (cardCount - 1) * stepScroll;

          const stickyHeight = sticky.offsetHeight;
          wrapper.style.height = `${stickyHeight + scrollRange}px`;
          wrapper.classList.add('is-pinned-mode');
        } else {
          wrapper.style.height = 'auto';
          track.style.transform = '';
          track.style.paddingRight = '';
          sticky.style.top = '';
          sticky.style.height = '';
          wrapper.classList.remove('is-pinned-mode');
        }
      } else {
        wrapper.style.height = '';
        track.style.transform = '';
        track.style.paddingRight = '';
        sticky.style.top = '';
        sticky.style.height = '';
        wrapper.classList.remove('is-pinned-mode');
      }
    };

    calculateDimensions();
    window.addEventListener('resize', calculateDimensions);
    if (document.fonts) {
      document.fonts.ready.then(calculateDimensions);
    }
    if (window.ResizeObserver) {
      const resizeObserver = new ResizeObserver(() => calculateDimensions());
      resizeObserver.observe(track);
    }

    const SCRAMBLE_CHARS = '0123456789';
    const REVEAL_STEP_MS = 50;
    const SCRAMBLE_FRAMES = 6;
    const FRAME_MS = 40;
    const elTimers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();

    const scrambleEl = (el: HTMLElement) => {
      const finalText = el.dataset.final;
      if (!finalText || !/\d/.test(finalText)) return;

      if (prefersReducedMotion) {
        el.textContent = finalText;
        return;
      }

      const existing = elTimers.get(el);
      if (existing) {
        clearTimeout(existing);
        elTimers.delete(el);
      }

      const chars = finalText.split('');
      const digitPositions = chars
        .map((character, index) => (/\d/.test(character) ? index : null))
        .filter((index): index is number => index !== null);

      let revealedCount = 0;
      const totalDigits = digitPositions.length;
      const frameCounters = new Array(totalDigits).fill(0);
      const randomChar = () => SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];

      const buildDisplay = () => {
        const output = chars.slice();
        digitPositions.forEach((position, digitIndex) => {
          output[position] = digitIndex < revealedCount ? chars[position] : randomChar();
        });
        return output.join('');
      };

      const tick = () => {
        if (revealedCount >= totalDigits) {
          el.textContent = finalText;
          elTimers.delete(el);
          return;
        }

        frameCounters[revealedCount]++;
        if (frameCounters[revealedCount] >= SCRAMBLE_FRAMES) {
          revealedCount++;
        }

        el.textContent = buildDisplay();
        elTimers.set(el, setTimeout(tick, revealedCount >= totalDigits ? REVEAL_STEP_MS : FRAME_MS));
      };

      tick();
    };

    const triggerScrambleForCard = (card: HTMLElement) => {
      card.querySelectorAll<HTMLElement>('[data-scramble]').forEach((element) => {
        if (prefersReducedMotion) {
          element.textContent = element.dataset.final || element.textContent;
          return;
        }
        scrambleEl(element);
      });
    };

    let lastActiveIndex = -1;
    let ticking = false;

    window.addEventListener('scroll', () => {
      if (!isDesktop || prefersReducedMotion || !wrapper.classList.contains('is-pinned-mode')) return;

      if (!ticking) {
        window.requestAnimationFrame(() => {
          const rect = wrapper.getBoundingClientRect();
          let progress = 0;

          if (rect.top <= headerHeight) {
            const scrolledDistance = headerHeight - rect.top;
            if (scrollRange > 0) {
              progress = Math.min(Math.max(scrolledDistance / scrollRange, 0), 1);
            }
          }

          const translate = progress * maxTranslate;
          track.style.transform = `translate3d(-${translate}px, 0, 0)`;

          const activeIndex = Math.min(
            Math.floor(progress * cardCount * 0.999),
            cardCount - 1
          );

          cards.forEach((card, index) => {
            card.classList.toggle('is-active', index === activeIndex);
          });

          if (activeIndex !== lastActiveIndex) {
            triggerScrambleForCard(cards[activeIndex]);
            lastActiveIndex = activeIndex;
          }

          if (currentNumEl) {
            currentNumEl.textContent = `0${activeIndex + 1}`;
          }
          if (fillEl instanceof HTMLElement) {
            fillEl.style.width = `${Math.max(25, progress * 100)}%`;
          }

          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    const mobilePrevBtn = document.getElementById('cs-mobile-prev') as HTMLButtonElement | null;
    const mobileNextBtn = document.getElementById('cs-mobile-next') as HTMLButtonElement | null;
    const mobileDotsContainer = document.getElementById('cs-mobile-dots');
    const mobileDots = mobileDotsContainer
      ? Array.from(mobileDotsContainer.querySelectorAll<HTMLButtonElement>('.cs-mobile-dot'))
      : [];
    let isTrackScrolling = false;

    const getActiveMobileIndex = () => {
      const trackRect = track.getBoundingClientRect();
      const viewportCenter = trackRect.left + trackRect.width / 2;
      let closestIndex = 0;
      let minDistance = Infinity;

      cards.forEach((card, index) => {
        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const distance = Math.abs(cardCenter - viewportCenter);

        if (distance < minDistance) {
          minDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    const updateMobileSlider = () => {
      if (isDesktop || !cards.length) return;

      const activeIndex = getActiveMobileIndex();
      cards.forEach((card, index) => {
        card.classList.toggle('is-active', index === activeIndex);
      });
      mobileDots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === activeIndex);
      });

      if (mobilePrevBtn) mobilePrevBtn.disabled = activeIndex === 0;
      if (mobileNextBtn) mobileNextBtn.disabled = activeIndex === cardCount - 1;

      if (activeIndex !== lastActiveIndex) {
        triggerScrambleForCard(cards[activeIndex]);
        lastActiveIndex = activeIndex;
      }
    };

    const scrollToMobileCard = (card: HTMLElement) => {
      const targetLeft = Math.max(0, card.offsetLeft - 16);
      track.scrollTo({
        left: targetLeft,
        behavior: prefersReducedMotion ? 'auto' : 'smooth'
      });
    };

    track.addEventListener('scroll', () => {
      if (isDesktop) return;
      if (!isTrackScrolling) {
        window.requestAnimationFrame(() => {
          updateMobileSlider();
          isTrackScrolling = false;
        });
        isTrackScrolling = true;
      }
    }, { passive: true });

    mobilePrevBtn?.addEventListener('click', () => {
      if (isDesktop) return;
      const targetCard = cards[Math.max(0, getActiveMobileIndex() - 1)];
      if (targetCard) scrollToMobileCard(targetCard);
    });

    mobileNextBtn?.addEventListener('click', () => {
      if (isDesktop) return;
      const targetCard = cards[Math.min(cardCount - 1, getActiveMobileIndex() + 1)];
      if (targetCard) scrollToMobileCard(targetCard);
    });

    mobileDots.forEach((dot) => {
      dot.addEventListener('click', () => {
        if (isDesktop) return;
        const targetCard = cards[Number.parseInt(dot.dataset.slideIndex || '0', 10)];
        if (targetCard) scrollToMobileCard(targetCard);
      });
    });

    if (!prefersReducedMotion && cards.length > 0) {
      setTimeout(() => {
        if (!isDesktop) updateMobileSlider();
        triggerScrambleForCard(cards[0]);
      }, 600);
    }
  }

  document.addEventListener('DOMContentLoaded', initCaseStudiesShowcase);
  document.addEventListener('astro:page-load', initCaseStudiesShowcase);
</script>

<style>
  .case-story-card,
  .case-story-card__body,
  .case-story-card__content-group,
  .case-story-card__title-area,
  .results-panel,
  .results-panel__tiles,
  .results-panel__secondary-grid,
  .results-tile {
    min-width: 0;
    max-width: 100%;
  }

