---
const cvUrl = "/files/Bui_Truong_Thinh_Senior_SEO_Specialist.pdf";
---

<!-- Shared CV Preview Modal -->
<div id="cv-modal" class="cv-modal" role="dialog" aria-modal="true" aria-labelledby="cv-modal-title" hidden>
  <div id="cv-modal-backdrop" class="cv-modal-backdrop"></div>
  <div class="cv-modal-container">
    <div class="cv-modal-header">
      <div class="cv-modal-title-group">
        <h2 id="cv-modal-title" class="cv-modal-title">CV — Bùi Trường Thịnh</h2>
        <span class="cv-modal-subtitle">Senior SEO Specialist & AI Builder</span>
      </div>
      <div class="cv-modal-actions">
        <a
          href={cvUrl}
          download
          class="btn-cv-download"
        >
          Tải CV
        </a>
        <button id="close-cv-modal" type="button" class="cv-modal-close" aria-label="Đóng cửa sổ CV">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    <div class="cv-modal-body">
      <object
        data={cvUrl}
        type="application/pdf"
        class="cv-modal-pdf"
      >
        <iframe
          src={cvUrl}
          title="CV Bùi Trường Thịnh PDF Preview"
          class="cv-modal-pdf"
        >
          <div class="cv-modal-fallback">
            <p>Trình duyệt của bạn không hỗ trợ xem trước PDF trực tiếp.</p>
            <a href={cvUrl} target="_blank" rel="noopener noreferrer" class="btn-cv-download">
              Mở CV trong tab mới →
            </a>
          </div>
        </iframe>
      </object>
    </div>
    <div class="cv-modal-footer-mobile">
      <a href={cvUrl} target="_blank" rel="noopener noreferrer" class="cv-modal-fallback-link">
        Mở CV trong tab mới
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('cv-modal');
    const backdrop = document.getElementById('cv-modal-backdrop');
    const closeBtn = document.getElementById('close-cv-modal');
    let activeTrigger: HTMLElement | null = null;

    if (!modal) return;

    function openModal(triggerEl?: HTMLElement) {
      if (triggerEl) activeTrigger = triggerEl;
      modal.removeAttribute('hidden');
      modal.classList.add('is-open');
      document.body.classList.add('no-scroll');
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('hidden', '');
      document.body.classList.remove('no-scroll');
      if (activeTrigger && typeof activeTrigger.focus === 'function') {
        activeTrigger.focus();
      }
    }

    // Global Click Delegation for any trigger
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const trigger = target.closest('[data-open-cv-modal], #open-cv-modal, #open-cv-modal-footer') as HTMLElement | null;
      if (trigger) {
        e.preventDefault();
        openModal(trigger);
      }
    });

    // Close button click
    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        closeModal();
      });
    }

    // Backdrop click
    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        e.preventDefault();
        closeModal();
      });
    }

    // Escape key press
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        e.preventDefault();
        closeModal();
      }
    });
  });
</script>

<style>
  /* Fixed Hidden Closed State */
  .cv-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
  }

  .cv-modal[hidden] {
    display: none !important;
  }

  .cv-modal.is-open {
    display: flex !important;
  }

  .cv-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(17, 24, 39, 0.75);
    backdrop-filter: blur(4px);
    z-index: 1;
  }

  .cv-modal-container {
    position: relative;
    z-index: 10;
    background: var(--color-bg, #FFF8F0);
    border: 1px solid var(--color-border, #D8CFC4);
    border-radius: var(--radius-lg, 16px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    width: min(960px, 94vw);
    height: min(88vh, 880px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
  }

  .cv-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    background: var(--color-card, #FFFFFF);
    border-bottom: 1px solid var(--color-border, #D8CFC4);
    gap: 16px;
    flex-shrink: 0;
  }

  .cv-modal-title-group {
    display: flex;
    flex-direction: column;
  }

  .cv-modal-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text, #111827);
    margin: 0;
  }

  .cv-modal-subtitle {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent, #C1121F);
  }

  .cv-modal-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-cv-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    font-size: 0.88rem;
    font-weight: 700;
    color: #ffffff;
    background-color: var(--color-accent, #C1121F);
    border: 1px solid var(--color-accent, #C1121F);
    border-radius: var(--radius-sm, 8px);
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-cv-download:hover {
    background-color: var(--color-accent-dark, #991B1B);
  }

  .cv-modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border, #D8CFC4);
    background: transparent;
    color: var(--color-text, #111827);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cv-modal-close:hover,
  .cv-modal-close:focus {
    background: rgba(193, 18, 31, 0.1);
    color: var(--color-accent, #C1121F);
    border-color: rgba(193, 18, 31, 0.2);
    outline: none;
  }

  .cv-modal-body {
    flex: 1;
    width: 100%;
    height: 100%;
    position: relative;
    background: #525659;
    overflow: hidden;
  }

  .cv-modal-pdf {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .cv-modal-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    text-align: center;
    height: 100%;
    color: #ffffff;
    gap: 16px;
  }

  .cv-modal-footer-mobile {
    display: none;
    padding: 12px 20px;
    background: var(--color-card, #FFFFFF);
    border-top: 1px solid var(--color-border, #D8CFC4);
    text-align: center;
    flex-shrink: 0;
  }

  .cv-modal-fallback-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent, #C1121F);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .cv-modal {
      padding: 12px;
    }

    .cv-modal-container {
      width: 100%;
      height: 94vh;
      border-radius: var(--radius-md, 12px);
    }

    .cv-modal-header {
      padding: 12px 16px;
    }

    .cv-modal-footer-mobile {
      display: block;
    }
  }
</style>
