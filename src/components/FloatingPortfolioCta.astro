<aside class="portfolio-cta" data-portfolio-cta hidden aria-label="Khám phá portfolio">
  <div class="portfolio-cta__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 18 9 13l3 3 8-9"/><path d="M16 7h4v4"/></svg>
  </div>
  <div class="portfolio-cta__copy"><p data-portfolio-cta-text></p><a data-portfolio-cta-link><span data-portfolio-cta-label></span><svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></a></div>
  <button class="portfolio-cta__close" type="button" aria-label="Đóng gợi ý portfolio" data-portfolio-cta-close>&times;</button>
</aside>

<style>
  .portfolio-cta { position: fixed; z-index: 90; right: 24px; bottom: 92px; display: grid; grid-template-columns: 24px minmax(0, 1fr) 20px; gap: 8px; align-items: start; width: min(350px, calc(100vw - 48px)); padding: 9px 9px 9px 10px; border: 1px solid rgba(35, 26, 20, .1); border-radius: 10px; background: rgba(255, 255, 255, .89); box-shadow: 0 7px 19px rgba(35, 26, 20, .075); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); opacity: 0; transform: translate3d(0, 10px, 0); transition: opacity .22s ease, transform .22s ease; }
  .portfolio-cta.is-visible { opacity: 1; transform: translate3d(0, 0, 0); }
  .portfolio-cta__icon { display: grid; width: 24px; height: 24px; place-items: center; border-radius: 50%; background: rgba(193,18,31,.08); color: var(--color-accent); }
  .portfolio-cta__icon svg { width: 13px; height: 13px; }
  .portfolio-cta__copy { min-width: 0; padding-top: 1px; }
  .portfolio-cta__copy p { display: -webkit-box; overflow: hidden; margin: 0 0 4px; color: var(--color-text); font-size: .8rem; font-weight: 600; line-height: 1.34; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .portfolio-cta__copy a { display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border: 1px solid rgba(193,18,31,.18); border-radius: 999px; background: rgba(193,18,31,.04); color: var(--color-accent); font-size: .75rem; font-weight: 750; line-height: 1.35; text-decoration: none; }
  .portfolio-cta__copy a svg { width: 12px; height: 12px; flex: none; transition: transform .18s ease; }
  .portfolio-cta__copy a:hover { border-color: rgba(193,18,31,.32); background: rgba(193,18,31,.08); }
  .portfolio-cta__copy a:hover svg { transform: translateX(2px); }
  .portfolio-cta__close { width: 20px; height: 20px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--color-muted-text); cursor: pointer; font-size: 1rem; line-height: 1; }
  .portfolio-cta__close:hover { background: rgba(26,37,48,.06); color: var(--color-text); }
  .portfolio-cta__close:focus-visible, .portfolio-cta__copy a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  @media (max-width: 767px) { .portfolio-cta { right: 16px; bottom: calc(92px + env(safe-area-inset-bottom, 0px)); width: min(350px, calc(100vw - 32px)); } }
  @media (prefers-reduced-motion: reduce) { .portfolio-cta, .portfolio-cta__copy a svg { transition: none; } }
</style>

<script>
  const initPortfolioCta = () => {
    const card = document.querySelector('[data-portfolio-cta]');
    if (!(card instanceof HTMLElement) || card.dataset.initialized === 'true' || sessionStorage.getItem('portfolio-cta-dismissed')) return;
    card.dataset.initialized = 'true';

    const currentPath = location.pathname.replace(/\/+$/, '') || '/';
    const variants = [
      { text: 'Xem cách tôi đưa 70% từ khóa vào Top 3', label: 'Xem case study', href: '/case-studies/hoang-long-computer-seo/' },
      { text: 'Khám phá các dự án SEO nổi bật', label: 'Xem case studies', href: '/case-studies/' },
      { text: 'Tìm hiểu kinh nghiệm và năng lực chuyên môn của tôi', label: 'Xem CV', href: '/files/Bui_Truong_Thinh_Senior_SEO_Specialist.pdf' }
    ].filter((item) => {
      const destinationPath = item.href.replace(/\/+$/, '');

      if (item.href.endsWith('.pdf')) return !currentPath.endsWith('.pdf');
      return currentPath !== destinationPath;
    });

    const text = card.querySelector('[data-portfolio-cta-text]');
    const link = card.querySelector('[data-portfolio-cta-link]');
    const label = card.querySelector('[data-portfolio-cta-label]');
    const close = card.querySelector('[data-portfolio-cta-close]');
    if (!(text instanceof HTMLElement) || !(link instanceof HTMLAnchorElement) || !(label instanceof HTMLElement) || !(close instanceof HTMLButtonElement) || !variants.length) return;

    let index = 0;
    let dismissTimer = 0;
    let rotationTimer = 0;
    let paused = false;

    const show = () => {
      const item = variants[index++ % variants.length];
      text.textContent = item.text;
      label.textContent = item.label;
      link.href = item.href;
      card.hidden = false;
      requestAnimationFrame(() => card.classList.add('is-visible'));
      scheduleHide();
    };

    const hide = (shouldRotate = true) => {
      card.classList.remove('is-visible');
      window.setTimeout(() => { card.hidden = true; }, 230);
      if (shouldRotate) rotationTimer = window.setTimeout(show, 45000);
    };

    const scheduleHide = () => {
      window.clearTimeout(dismissTimer);
      dismissTimer = window.setTimeout(() => {
        if (!paused) hide();
      }, 9000);
    };

    close.addEventListener('click', () => {
      sessionStorage.setItem('portfolio-cta-dismissed', 'true');
      window.clearTimeout(dismissTimer);
      window.clearTimeout(rotationTimer);
      hide(false);
    });

    card.addEventListener('mouseenter', () => { paused = true; window.clearTimeout(dismissTimer); });
    card.addEventListener('mouseleave', () => { paused = false; scheduleHide(); });
    card.addEventListener('focusin', () => { paused = true; window.clearTimeout(dismissTimer); });
    card.addEventListener('focusout', () => { paused = false; scheduleHide(); });

    window.setTimeout(show, 10000);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPortfolioCta, { once: true });
  } else {
    initPortfolioCta();
  }

  document.addEventListener('astro:page-load', initPortfolioCta);
</script>
