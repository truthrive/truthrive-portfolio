---
const currentYear = new Date().getFullYear();
---
<footer class="section-dark" style="padding: 48px 0; border-top: 1px solid rgba(255,255,255,0.1); margin-top: auto;">
  <div class="container footer-container">
    <div class="footer-brand">
      <h2 class="logo">TruThrive</h2>
      <p class="tagline">True SEO. Sustainable Growth.</p>
    </div>
    <div class="footer-bottom">
      <p>&copy; {currentYear} Bùi Trường Thịnh. Đã đăng ký bản quyền.</p>
    </div>
  </div>
</footer>

<style>
  .footer-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.5px;
  }
  .tagline {
    color: rgba(255, 248, 240, 0.7);
  }
  .footer-bottom {
    font-size: 0.875rem;
    color: rgba(255, 248, 240, 0.5);
  }
  
  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }
  }
</style>
