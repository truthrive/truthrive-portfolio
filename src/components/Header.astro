---
const navItems = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Giới thiệu', href: '/about/' },
  { label: 'Case Study', href: '/case-studies/suoi-tien-seo/' },
  { label: 'Liên hệ', href: '/contact/' },
];
---
<header class="header">
  <div class="container header-container">
    <a href="/" class="logo">TruThrive</a>
    
    <!-- Mobile Menu Button -->
    <button id="menu-toggle" class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <nav id="nav-menu" class="header-nav">
      <ul class="nav-list">
        {navItems.map(item => (
          <li><a href={item.href} class="nav-link">{item.label}</a></li>
        ))}
        <li>
          <a href="/request-seo-audit/" class="btn btn-primary cta-btn">Yêu cầu SEO Audit</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 72px;
  }
  .logo {
    font-size: 24px;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.5px;
  }
  
  .header-nav {
    display: flex;
  }
  .nav-list {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
  }
  .nav-link {
    font-weight: 500;
    color: var(--color-text);
    font-size: 16px;
    transition: color 0.2s;
  }
  .nav-link:hover {
    color: var(--color-accent);
  }
  .cta-btn {
    padding: 10px 20px;
    font-size: 15px;
  }
  
  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-card);
    color: var(--color-text);
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: inline-flex;
    }

    .header-nav {
      display: none;
    }

    .header-nav.is-open {
      display: flex;
      position: absolute;
      top: 72px;
      left: 16px;
      right: 16px;
      flex-direction: column;
      gap: 16px;
      padding: 20px;
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      box-shadow: var(--shadow-card);
      z-index: 50;
    }
    
    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }
    
    .cta-btn {
      width: 100%;
      text-align: center;
    }

    .header-container {
      position: relative;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('nav-menu');
    
    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isExpanded));
        menu.classList.toggle('is-open');
      });
    }
  });
</script>
