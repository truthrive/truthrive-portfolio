---
const navItems = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Case Study', href: '/case-studies/' },
  { label: 'Hệ thống SEO', href: '/seo-systems/' },
  { label: 'Liên hệ', href: '/#contact' },
];

const caseStudies = [
  { title: 'Xem tất cả Case Studies', href: '/case-studies/', isHub: true },
  { title: 'Suối Tiên', href: '/case-studies/suoi-tien-seo/', desc: 'Domain Migration · Technical SEO' },
  { title: 'DOL Grammar', href: '/case-studies/dol-grammar-seo/', desc: 'New Website SEO · Authority' },
  { title: 'Hoàng Long Computer', href: '/case-studies/hoang-long-computer-seo/', desc: 'SEO Recovery · E-commerce' },
];
---

<!-- Mobile Menu Sheet & Dimmed Backdrop -->
<div id="mobile-menu-backdrop" class="mobile-menu-backdrop" aria-hidden="true"></div>

<div
  id="mobile-menu-sheet"
  class="mobile-menu-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="Menu điều hướng chính"
  tabindex="-1"
>
  <!-- Drag Handle Indicator -->
  <div class="mobile-sheet-handle-bar" aria-hidden="true">
    <div class="mobile-sheet-handle"></div>
  </div>

  <!-- Sheet Header -->
  <div class="mobile-sheet-header">
    <span class="mobile-sheet-brand">TruThrive Navigation</span>
    <button id="mobile-menu-close" class="mobile-sheet-close" aria-label="Đóng menu điều hướng">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Sheet Content Navigation -->
  <nav class="mobile-sheet-nav" aria-label="Menu di động">
    <ul class="mobile-sheet-list">
      {navItems.map(item => {
        if (item.label === 'Case Study') {
          return (
            <li class="mobile-sheet-item has-sub">
              <div class="mobile-sub-group">
                <a href={item.href} class="mobile-sheet-link">{item.label}</a>
                <button
                  class="mobile-sub-toggle"
                  aria-expanded="false"
                  aria-label="Mở rộng danh sách Case Studies"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
              </div>
              
              <ul class="mobile-sub-list">
                {caseStudies.map(cs => (
                  <li>
                    <a href={cs.href} class={`mobile-sub-link ${cs.isHub ? 'is-hub' : ''}`}>
                      <span class="mobile-sub-title">{cs.title}</span>
                      {cs.desc && <span class="mobile-sub-desc">{cs.desc}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        }
        return (
          <li class="mobile-sheet-item">
            <a href={item.href} class="mobile-sheet-link">{item.label}</a>
          </li>
        );
      })}
    </ul>

    <div class="mobile-sheet-cta">
      <a href="/files/Bui_Truong_Thinh_Senior_SEO_Specialist.pdf" download class="btn btn-primary mobile-cv-btn" aria-label="Tải CV PDF của Bùi Trường Thịnh">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        Tải CV PDF
      </a>
    </div>
  </nav>
</div>

<style>
  /* Only display on mobile (< 769px) */
  @media (min-width: 769px) {
    .mobile-menu-backdrop,
    .mobile-menu-sheet {
      display: none !important;
    }
  }

  @media (max-width: 768px) {
    /* Dimmed Backdrop */
    .mobile-menu-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 95;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .mobile-menu-backdrop.is-open {
      opacity: 1;
      visibility: visible;
    }

    /* Floating Bottom Sheet connected above dock */
    .mobile-menu-sheet {
      position: fixed;
      bottom: calc(72px + env(safe-area-inset-bottom, 0px));
      left: 16px;
      right: 16px;
      margin: 0 auto;
      width: min(calc(100% - 32px), 420px);
      background: var(--color-card, #ffffff);
      border: 1px solid var(--color-border);
      border-radius: 28px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.18), 0 4px 12px rgba(0, 0, 0, 0.08);
      z-index: 96;
      padding: 12px 20px 24px;
      max-height: calc(82vh - 80px);
      max-height: calc(82dvh - 80px);
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      
      opacity: 0;
      visibility: hidden;
      transform: translateY(24px) scale(0.96);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, visibility 0.25s ease;
    }

    .mobile-menu-sheet.is-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }

    /* Handle Bar */
    .mobile-sheet-handle-bar {
      display: flex;
      justify-content: center;
      padding: 4px 0 10px;
    }

    .mobile-sheet-handle {
      width: 36px;
      height: 4px;
      border-radius: 2px;
      background: rgba(26, 37, 48, 0.2);
    }

    /* Sheet Header */
    .mobile-sheet-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--color-border);
    }

    .mobile-sheet-brand {
      font-size: 1rem;
      font-weight: 800;
      color: var(--color-text);
      letter-spacing: -0.02em;
    }

    .mobile-sheet-close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      background: var(--color-bg);
      color: var(--color-text);
      cursor: pointer;
      transition: background-color 0.2s, color 0.2s;
    }

    .mobile-sheet-close:hover,
    .mobile-sheet-close:focus {
      background-color: rgba(193, 18, 31, 0.08);
      color: var(--color-accent);
      outline: none;
    }

    /* Navigation items */
    .mobile-sheet-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .mobile-sheet-link {
      display: block;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--color-text);
      padding: 10px 12px;
      border-radius: 12px;
      text-decoration: none;
      transition: background-color 0.2s, color 0.2s;
    }

    .mobile-sheet-link:hover,
    .mobile-sheet-link:focus {
      background-color: rgba(193, 18, 31, 0.05);
      color: var(--color-accent);
    }

    /* Submenu Accordion for Case Studies */
    .mobile-sub-group {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .mobile-sub-toggle {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      background: transparent;
      color: var(--color-muted-text);
      cursor: pointer;
      border-radius: 8px;
    }

    .mobile-sub-toggle svg {
      transition: transform 0.2s ease;
    }

    .mobile-sheet-item.is-expanded .mobile-sub-toggle svg {
      transform: rotate(180deg);
    }

    .mobile-sub-list {
      list-style: none;
      padding: 4px 0 4px 12px;
      margin: 4px 0 8px 0;
      display: none;
      flex-direction: column;
      gap: 4px;
      border-left: 2px solid rgba(193, 18, 31, 0.15);
    }

    .mobile-sheet-item.is-expanded .mobile-sub-list {
      display: flex;
    }

    .mobile-sub-link {
      display: flex;
      flex-direction: column;
      padding: 8px 12px;
      border-radius: 8px;
      text-decoration: none;
    }

    .mobile-sub-link.is-hub {
      background: rgba(193, 18, 31, 0.04);
      margin-bottom: 4px;
    }

    .mobile-sub-title {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .mobile-sub-desc {
      font-size: 0.78rem;
      color: var(--color-muted-text);
      margin-top: 2px;
    }

    .mobile-sheet-cta {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid var(--color-border);
    }

    .mobile-cv-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px 20px;
      font-size: 0.95rem;
      font-weight: 700;
      border-radius: 14px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const sheet = document.getElementById('mobile-menu-sheet');
    const closeBtn = document.getElementById('mobile-menu-close');
    const dockToggle = document.getElementById('dock-menu-toggle');
    const subItem = document.querySelector('.mobile-sheet-item.has-sub');
    const subToggle = document.querySelector('.mobile-sub-toggle');

    if (!backdrop || !sheet) return;

    const openSheet = () => {
      sheet.classList.add('is-open');
      backdrop.classList.add('is-open');
      document.body.classList.add('no-scroll');
      document.body.style.overflow = 'hidden';

      if (dockToggle) {
        dockToggle.setAttribute('aria-expanded', 'true');
        dockToggle.classList.add('is-active');
      }

      if (closeBtn) {
        closeBtn.focus();
      }
    };

    const closeSheet = () => {
      sheet.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      document.body.classList.remove('no-scroll');
      document.body.style.overflow = '';

      if (dockToggle) {
        dockToggle.setAttribute('aria-expanded', 'false');
        dockToggle.classList.remove('is-active');
        dockToggle.focus();
      }
    };

    const toggleSheet = () => {
      const isOpen = sheet.classList.contains('is-open');
      if (isOpen) {
        closeSheet();
      } else {
        openSheet();
      }
    };

    if (dockToggle) {
      dockToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleSheet();
      });
    }

    backdrop.addEventListener('click', closeSheet);

    if (closeBtn) {
      closeBtn.addEventListener('click', closeSheet);
    }

    const sheetLinks = sheet.querySelectorAll('a');
    sheetLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeSheet();
      });
    });

    if (subToggle && subItem) {
      subToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isExpanded = subItem.classList.contains('is-expanded');
        subItem.classList.toggle('is-expanded', !isExpanded);
        subToggle.setAttribute('aria-expanded', String(!isExpanded));
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheet.classList.contains('is-open')) {
        closeSheet();
      }
    });

    const mql = window.matchMedia('(min-width: 769px)');
    mql.addEventListener('change', (e) => {
      if (e.matches && sheet.classList.contains('is-open')) {
        closeSheet();
      }
    });
  });
</script>
