---
export interface Props {
  name: 'home' | 'briefcase' | 'tools' | 'download';
}

const { name } = Astro.props;
---

<svg
  class="nav-icon"
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'home' && (
    <>
      <path d="m3 10 9-7 9 7"></path>
      <path d="M5 9v11h14V9"></path>
      <path d="M9 20v-6h6v6"></path>
    </>
  )}

  {name === 'briefcase' && (
    <>
      <rect x="3" y="7" width="18" height="13" rx="2"></rect>
      <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
      <path d="M3 12h18"></path>
      <path d="M10 12v2h4v-2"></path>
    </>
  )}

  {name === 'tools' && (
    <>
      <path d="M14.7 6.3a4 4 0 0 0-5-5L12 3.6 9.6 6 7.3 3.7a4 4 0 0 0 5 5l-8.6 8.6a2.1 2.1 0 0 0 3 3l8.6-8.6a4 4 0 0 0 5-5L18 5l-2.4-2.4-2.3 2.3"></path>
    </>
  )}

  {name === 'download' && (
    <>
      <path d="M12 3v12"></path>
      <path d="m7 10 5 5 5-5"></path>
      <path d="M5 21h14"></path>
    </>
  )}
</svg>

<style>
  .nav-icon {
    flex: 0 0 auto;
    opacity: 0.72;
  }
</style>
