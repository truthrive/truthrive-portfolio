---

<section id="explore-highlights" class="highlights-section section-muted" data-explore-highlights>
  <div class="highlights-container">
    <div class="section-heading highlights-header">
      <p class="section-kicker">KHO DỰ ÁN BỔ TRỢ</p>
      <h2 class="section-title">Dự án bổ trợ</h2>
      <p class="section-subtitle">
        Một số dự án bổ trợ thể hiện kinh nghiệm SEO đa lĩnh vực, từ B2B, dịch vụ local, agency website đến Finance/YMYL.
      </p>
    </div>

    <!-- Tab list row -->
    <div class="highlights-tabs__list-wrapper">
      <div class="highlights-tabs__list" role="tablist" aria-label="Danh sách dự án bổ trợ">
        {projects.map((project, idx) => (
          <button 
            role="tab" 
            aria-selected={idx === 0 ? "true" : "false"} 
            aria-controls={`panel-${project.id}`} 
            id={`tab-${project.id}`} 
            tabindex={idx === 0 ? "0" : "-1"}
            class={`highlights-tabs__tab ${idx === 0 ? "is-active" : ""}`}
          >
            <span class="highlights-tabs__tab-monogram">{project.tabMonogram}</span>
            <span class="highlights-tabs__tab-text">{project.tabText}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Content Panel Card -->
    <div class="highlights-tabs__panel-card">
      {projects.map((project, idx) => (
        <div 
          role="tabpanel" 
          id={`panel-${project.id}`} 
          aria-labelledby={`tab-${project.id}`} 
          class={`highlights-tabs__panel ${idx === 0 ? "is-active" : ""}`}
          aria-hidden={idx === 0 ? "false" : "true"}
        >
          <div class="highlights-tabs__panel-content">
            <!-- Top Row Header -->
            <div class="highlights-tabs__panel-header">
              <div>
                <span class="highlights-tabs__panel-category">{project.category}</span>
                <h3 class="highlights-tabs__panel-title">{project.title}</h3>
              </div>
              <div class="highlights-tabs__panel-role">
                <span class="highlights-tabs__panel-role-label">Role:</span>
                <strong class="highlights-tabs__panel-role-val">{project.role}</strong>
              </div>
            </div>

            <!-- Middle Result Section -->
            <div class="highlights-tabs__panel-result">
              <span class="highlights-tabs__panel-section-label">Kết quả nổi bật</span>
              <p class="highlights-tabs__panel-result-text" set:html={project.resultSummary} />
            </div>

            <!-- Keywords Section (Conditional) -->
            {project.keywords && project.keywords.length > 0 && (
              <div class="highlights-tabs__panel-keywords">
                <span class="highlights-tabs__panel-section-label">Từ khóa tiêu biểu</span>
                <p class="highlights-tabs__panel-keywords-text">
                  {project.keywords.map((kw, kwIdx) => (
                    <span>“{kw}”{kwIdx < project.keywords!.length - 1 ? ", " : ""}</span>
                  ))}
                </p>
              </div>
            )}

            <!-- Tags Footer -->
            <div class="highlights-tabs__panel-tags">
              {project.tags.map((tag) => (
                <span class="highlights-tabs__tag">{tag}</span>
              ))}
            </div>

            <!-- New Image Slider Block (Conditional) -->
            {project.images && project.images.length > 0 && (
              <div class="highlights-tabs__slider-block">
                <span class="highlights-tabs__panel-section-label">Minh chứng kết quả</span>
                
                <div class="highlights-tabs__slider" data-slider data-current-slide="0">
                  <!-- Main Image Viewer -->
                  <div class="highlights-tabs__slider-viewer">
                    {project.images.map((img, imgIdx) => (
                      <div 
                        class={`highlights-tabs__slide ${imgIdx === 0 ? "is-active" : ""}`}
                        data-slide-index={imgIdx}
                        aria-hidden={imgIdx === 0 ? "false" : "true"}
                      >
                        <img src={img.src} alt={img.alt} loading="lazy" class="highlights-tabs__slide-img" />
                      </div>
                    ))}
                  </div>

                  <!-- Slider Metadata (Caption & Controls) Row -->
                  {project.images.length > 1 ? (
                    <div class="highlights-tabs__slider-meta-row">
                      <!-- Active Caption Container -->
                      <div class="highlights-tabs__slider-caption-container">
                        {project.images.map((img, imgIdx) => (
                          <p 
                            class={`highlights-tabs__slider-caption-text ${imgIdx === 0 ? "is-active" : ""}`}
                            data-slide-caption-index={imgIdx}
                          >
                            {img.caption}
                          </p>
                        ))}
                      </div>

                      <!-- Control Buttons & Counter Pill -->
                      <div class="highlights-tabs__slider-controls">
                        <button 
                          type="button" 
                          class="highlights-tabs__slider-btn btn-prev" 
                          aria-label="Ảnh trước"
                          data-slider-prev
                        >
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </button>
                        
                        <span class="highlights-tabs__slider-counter" data-slider-counter>
                          1 / {project.images.length}
                        </span>
                        
                        <button 
                          type="button" 
                          class="highlights-tabs__slider-btn btn-next" 
                          aria-label="Ảnh tiếp theo"
                          data-slider-next
                        >
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </button>
                      </div>
                    </div>
                  ) : (
                    // Single Image Caption Row
                    project.images[0] && (
                      <div class="highlights-tabs__slider-meta-row justify-center">
                        <p class="highlights-tabs__slider-caption-text is-active text-center">
                          {project.images[0].caption}
                        </p>
                      </div>
                    )
                  )}

                  <!-- Optional Thumbnail Strip (only for 2+ images) -->
                  {project.images.length > 1 && (
                    <div class="highlights-tabs__slider-thumbnails">
                      {project.images.map((img, imgIdx) => (
                        <button
                          type="button"
                          aria-label={`Xem ảnh ${imgIdx + 1}`}
                          class={`highlights-tabs__thumbnail-btn ${imgIdx === 0 ? "is-active" : ""}`}
                          data-thumbnail-index={imgIdx}
                        >
                          <img src={img.src} alt={`Thumbnail ${imgIdx + 1}`} class="highlights-tabs__thumbnail-img" />
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )}

          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* --- Section Container --- */
  .highlights-section {
    padding: var(--spacing-section-y) 0;
    width: 100%;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

