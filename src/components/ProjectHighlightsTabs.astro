</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.querySelector('[data-explore-highlights]');
    if (!(wrapper instanceof HTMLElement)) return;

    const list = wrapper.querySelector('[role="tablist"]');
    if (!list) return;

    const tabs = Array.from(list.querySelectorAll('[role="tab"]')) as HTMLButtonElement[];
    const panels = Array.from(wrapper.querySelectorAll('[role="tabpanel"]')) as HTMLDivElement[];

    let currentIdx = 0;

    // --- Tab Switch Logic ---
    const selectTab = (idx: number) => {
      tabs.forEach((tab, i) => {
        const isSelected = i === idx;
        tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        tab.setAttribute('tabindex', isSelected ? '0' : '-1');
        if (isSelected) {
          tab.classList.add('is-active');
        } else {
          tab.classList.remove('is-active');
        }
      });

      panels.forEach((panel, i) => {
        const isSelected = i === idx;
        panel.setAttribute('aria-hidden', isSelected ? 'false' : 'true');
        
        if (isSelected) {
          panel.classList.add('is-active');
          // Reset slider inside this panel when switching tabs
          resetSlider(panel);
        } else {
          panel.classList.remove('is-active');
        }
      });

      currentIdx = idx;
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        selectTab(idx);
      });

      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        let nextIdx = currentIdx;
        
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          nextIdx = (currentIdx + 1) % tabs.length;
          tabs[nextIdx].focus();
          selectTab(nextIdx);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          nextIdx = (currentIdx - 1 + tabs.length) % tabs.length;
          tabs[nextIdx].focus();
          selectTab(nextIdx);
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectTab(idx);
        }
      });
    });

    // --- Slider Logic ---
    const getActiveSlideIndex = (slider: HTMLElement): number => {
      return parseInt(slider.getAttribute('data-current-slide') || '0', 10);
    };

    const resetSlider = (panel: HTMLElement) => {
      const slider = panel.querySelector('[data-slider]');
      if (slider instanceof HTMLElement) {
        showSlide(slider, 0);
      }
    };

    const showSlide = (slider: HTMLElement, slideIdx: number) => {
      const slides = Array.from(slider.querySelectorAll('.highlights-tabs__slide')) as HTMLElement[];
      const totalSlides = slides.length;
      if (totalSlides === 0) return;

      // Wrap around bounds
      let targetIdx = slideIdx;
      if (targetIdx < 0) targetIdx = totalSlides - 1;
      if (targetIdx >= totalSlides) targetIdx = 0;

      // Save index state on container
      slider.setAttribute('data-current-slide', targetIdx.toString());

      // Update slide display
      slides.forEach((slide, idx) => {
        const isActive = idx === targetIdx;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      // Update caption display
      const captions = Array.from(slider.querySelectorAll('[data-slide-caption-index]')) as HTMLElement[];
      captions.forEach((caption, idx) => {
        caption.classList.toggle('is-active', idx === targetIdx);
      });

      // Update counter
      const counter = slider.querySelector('[data-slider-counter]');
      if (counter) {
        counter.textContent = `${targetIdx + 1} / ${totalSlides}`;
      }

      // Update thumbnail active states
      const thumbnails = Array.from(slider.querySelectorAll('[data-thumbnail-index]')) as HTMLElement[];
      thumbnails.forEach((thumb, idx) => {
        const isActive = idx === targetIdx;
        thumb.classList.toggle('is-active', isActive);
      });
    };

    // Initialize all sliders inside panels
    panels.forEach((panel) => {
      const slider = panel.querySelector('[data-slider]');
      if (!(slider instanceof HTMLElement)) return;

      const prevBtn = slider.querySelector('[data-slider-prev]');
      const nextBtn = slider.querySelector('[data-slider-next]');
      const thumbnails = Array.from(slider.querySelectorAll('[data-thumbnail-index]')) as HTMLElement[];

      const getSlideCount = () => {
        return slider.querySelectorAll('.highlights-tabs__slide').length;
      };

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const total = getSlideCount();
          const current = getActiveSlideIndex(slider);
          showSlide(slider, (current - 1 + total) % total);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const total = getSlideCount();
          const current = getActiveSlideIndex(slider);
          showSlide(slider, (current + 1) % total);
        });
      }

      thumbnails.forEach((thumb, idx) => {
        thumb.addEventListener('click', (e) => {
          e.preventDefault();
          showSlide(slider, idx);
        });
      });
    });
  });
</script>
