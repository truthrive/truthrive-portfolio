---
import BaseLayout from "./BaseLayout.astro";

interface Section { id: string; label: string; }
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  sections?: Section[];
  updated?: string;
}
const { title, description, eyebrow = "TruThrive / SEO Report", sections = [], updated } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/seo-report/", label: "Giới thiệu", number: "01" },
  { href: "/seo-report/privacy/", label: "Quyền riêng tư", number: "02" },
  { href: "/seo-report/terms/", label: "Điều khoản sử dụng", number: "03" },
];
---
<BaseLayout title={`${title} | TruThrive SEO Report`} description={description}>
  <div class="policy-shell">
    <div class="policy-inner">
      <div class="policy-breadcrumb"><a href="/">TruThrive</a><span aria-hidden="true">/</span><a href="/seo-report/">SEO Report</a><span aria-hidden="true">/</span><span>{title}</span></div>
      <header class="policy-hero">
        <div class="policy-hero-main">
          <p class="policy-eyebrow"><span aria-hidden="true"></span>{eyebrow}</p>
          <h1>{title}</h1>
          <p class="policy-intro">{description}</p>
          {updated && <div class="policy-updated"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7.5 3.5v4m9-4v4M3.5 10h17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Cập nhật: <strong>{updated}</strong></span></div>}
        </div>
        <div class="policy-hero-mark" aria-hidden="true"><span>TT</span><i></i></div>
      </header>
      <nav class="policy-nav" aria-label="Các trang SEO Report">
        {links.map((item) => {
          const active = currentPath === item.href.replace(/\/$/, "");
          return <a href={item.href} aria-current={active ? "page" : undefined}><span class="policy-nav-number">{item.number}</span><span>{item.label}</span><span class="policy-nav-arrow" aria-hidden="true">↗</span></a>;
        })}
      </nav>
      <div class:list={["policy-body", { "policy-body--single": !sections.length }]}>
        {sections.length > 0 && <aside class="policy-aside">
          <details open class="policy-contents">
            <summary><span><small>TRÊN TRANG NÀY</small><strong>Mục lục</strong></span><span class="contents-toggle" aria-hidden="true">−</span></summary>
            <nav aria-label="Mục lục trang"><ol>{sections.map((section, index) => <li><a href={`#${section.id}`}><span>{String(index + 1).padStart(2, "0")}</span>{section.label}</a></li>)}</ol></nav>
          </details>
          <div class="policy-help"><span class="help-icon" aria-hidden="true">↗</span><strong>Bạn cần hỗ trợ?</strong><p>Liên hệ nếu bạn có câu hỏi về SEO Report hoặc dữ liệu của mình.</p><a href="mailto:bt.thinh2010@gmail.com">Gửi email cho TruThrive <span aria-hidden="true">→</span></a></div>
        </aside>}
        <article class="policy-content"><slot /></article>
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .policy-shell{background:#fffaf4;color:#182232}
  .policy-inner{width:min(1120px,calc(100% - 48px));margin:0 auto;padding:32px 0 112px}
  .policy-breadcrumb{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:12px;font-weight:700;color:#75808a}
  .policy-breadcrumb a:hover{color:#ba2630}.policy-breadcrumb span:last-child{color:#45515f}
  .policy-hero{display:flex;justify-content:space-between;gap:40px;align-items:center;padding:64px 0 58px}
  .policy-hero-main{max-width:790px}.policy-eyebrow{display:flex;align-items:center;gap:9px;color:#aa1e28;text-transform:uppercase;letter-spacing:.13em;font-size:11px;font-weight:800;margin-bottom:18px}.policy-eyebrow span{width:23px;height:2px;background:#c1121f}
  .policy-hero h1{font-size:clamp(2.35rem,5.1vw,4.25rem);line-height:1.12;letter-spacing:-.055em;font-weight:800;margin:0 0 18px;max-width:780px}
  .policy-intro{font-size:clamp(1rem,1.4vw,1.13rem);line-height:1.8;color:#5f6873;max-width:670px}
  .policy-updated{display:inline-flex;align-items:center;gap:9px;margin-top:26px;padding:8px 12px;border:1px solid #e8ded4;background:#fff;border-radius:6px;color:#66717b;font-size:12px;font-weight:600}.policy-updated svg{width:16px;height:16px;color:#b61e29}.policy-updated strong{color:#303a46}
  .policy-hero-mark{width:130px;height:130px;flex:none;display:flex;align-items:center;justify-content:center;position:relative;border:1px solid #e8d9d0;border-radius:50%;color:#c1121f;background:#fff4ed;font-size:26px;font-weight:800;letter-spacing:-.09em}.policy-hero-mark:before{content:"";position:absolute;inset:11px;border:1px solid #efded8;border-radius:50%}.policy-hero-mark i{width:9px;height:9px;border-radius:50%;background:#c1121f;position:absolute;right:12px;top:29px}
  .policy-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#fff;border:1px solid #e6ddd5;border-radius:10px;box-shadow:0 8px 28px rgba(39,29,20,.035);overflow:hidden}
  .policy-nav a{min-width:0;min-height:68px;display:flex;align-items:center;gap:12px;padding:16px 20px;border-right:1px solid #eee7e0;color:#4a5561;font-size:13px;font-weight:750}.policy-nav a:last-child{border-right:0}.policy-nav a:hover{background:#fff8f4;color:#a61d27}.policy-nav a[aria-current="page"]{background:#fbf0eb;color:#a81e29;box-shadow:inset 0 -3px #c1121f}.policy-nav-number{font-size:10px;color:#a59e98;letter-spacing:.04em}.policy-nav-arrow{margin-left:auto;font-size:15px;color:#a9a19c}.policy-nav a[aria-current="page"] .policy-nav-number,.policy-nav a[aria-current="page"] .policy-nav-arrow{color:#ba2932}
  .policy-body{display:grid;grid-template-columns:250px minmax(0,1fr);gap:70px;align-items:start;margin-top:62px}.policy-body--single{display:block}.policy-body--single .policy-content{max-width:820px}
  .policy-aside{position:sticky;top:105px}.policy-contents{border-top:2px solid #26303e;padding-top:18px}.policy-contents summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center}.policy-contents summary::-webkit-details-marker{display:none}.policy-contents summary small,.policy-contents summary strong{display:block}.policy-contents summary small{color:#a21b25;font-size:10px;font-weight:800;letter-spacing:.12em;margin-bottom:5px}.policy-contents summary strong{font-size:17px}.contents-toggle{font-size:22px;color:#8d959a}.policy-contents:not([open]) .contents-toggle{transform:rotate(90deg)}
  .policy-contents ol{counter-reset:section;list-style:none;padding:15px 0 0;margin:0}.policy-contents li a{display:flex;gap:12px;padding:8px 0;color:#5e6872;font-size:12.5px;font-weight:650;line-height:1.5}.policy-contents li a:hover{color:#b61e29}.policy-contents li a span{color:#b5a9a0;font-size:10px;font-weight:800;padding-top:2px}.policy-help{margin-top:30px;padding:20px;background:#f3eae1;border-radius:9px}.help-icon{display:grid;place-items:center;width:30px;height:30px;background:#fff;color:#ae222a;border-radius:6px;font-size:16px;margin-bottom:15px}.policy-help strong{display:block;font-size:13px}.policy-help p{color:#647079;font-size:12px;line-height:1.7;margin:7px 0 12px}.policy-help a{font-size:11px;font-weight:800;color:#ae222a}.policy-help a span{padding-left:4px}
  .policy-content{min-width:0;counter-reset:policy-section}.policy-content :global(section){padding:0 0 34px;margin:0 0 34px;border-bottom:1px solid #e7ded6;scroll-margin-top:110px}.policy-content :global(section:last-child){border:0;margin-bottom:0}
  .policy-content :global(section.doc){counter-increment:policy-section}.policy-content :global(section.doc h2){display:flex;gap:14px;align-items:baseline}.policy-content :global(section.doc h2::before){content:counter(policy-section, decimal-leading-zero);font-size:11px;letter-spacing:.04em;color:#bd3038;font-weight:800;flex:none}
  .policy-content :global(h2){font-size:clamp(1.25rem,2vw,1.55rem);line-height:1.35;letter-spacing:-.035em;margin:0 0 15px;font-weight:800;color:#1d2734}.policy-content :global(p),.policy-content :global(li){font-size:15px;line-height:1.85;color:#4d5964}.policy-content :global(p){margin:0 0 15px}.policy-content :global(p:last-child){margin-bottom:0}.policy-content :global(ul){list-style:disc;margin:16px 0 20px;padding-left:22px}.policy-content :global(li){padding-left:3px;margin:10px 0}.policy-content :global(li::marker){color:#c1121f}.policy-content :global(strong){color:#293544}.policy-content :global(a){color:#a91f29;font-weight:700;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}.policy-content :global(code){background:#f1e9e1;color:#92202a;border-radius:4px;padding:2px 5px;font-size:.9em;overflow-wrap:anywhere}
  .policy-content :global(.app-button){display:inline-flex;background:#bb202b;color:#fff;padding:13px 20px;border-radius:7px;font-size:13px;font-weight:800;text-decoration:none;margin-top:8px}.policy-content :global(.app-button:hover){background:#991b1b}.policy-content :global(section.app-note){padding:24px;background:#f4ece4;border:1px solid #e9ddd2;border-radius:9px}
  @media(max-width:800px){.policy-hero{padding:48px 0 42px}.policy-hero-mark{width:100px;height:100px}.policy-body{grid-template-columns:200px minmax(0,1fr);gap:36px}.policy-nav a{padding:15px 13px;font-size:12px}}
  @media(max-width:640px){.policy-inner{width:calc(100% - 32px);padding:24px 0 72px}.policy-breadcrumb{font-size:11px;gap:7px}.policy-hero{padding:42px 0 36px}.policy-hero-mark{display:none}.policy-hero h1{font-size:clamp(2.1rem,10vw,3.15rem)}.policy-nav{grid-template-columns:1fr}.policy-nav a{min-height:52px;border-right:0;border-bottom:1px solid #eee7e0;padding:12px 16px}.policy-nav a:last-child{border-bottom:0}.policy-nav a[aria-current="page"]{box-shadow:inset 3px 0 #c1121f}.policy-body{display:block;margin-top:36px}.policy-aside{position:static;margin-bottom:38px}.policy-contents{padding:15px 16px;border:1px solid #e6ddd5;border-top:2px solid #26303e;border-radius:6px;background:#fff}.policy-contents ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:12px}.policy-contents li a{padding:7px 0;font-size:12px}.policy-help{display:none}.policy-content :global(section){padding-bottom:26px;margin-bottom:26px}.policy-content :global(p),.policy-content :global(li){font-size:14px}}
  @media(max-width:370px){.policy-contents ol{grid-template-columns:1fr}}
</style>
