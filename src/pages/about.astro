---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Giới thiệu | Bùi Trường Thịnh - TruThrive SEO Specialist";
const description = "Tìm hiểu về Bùi Trường Thịnh và hành trình xây dựng giải pháp SEO bền vững dựa trên dữ liệu, kỹ thuật và chiến lược nội dung.";

const linkedinUrl = "https://www.linkedin.com/in/truongthinhseo";
const cvUrl = "/files/Bui_Truong_Thinh_CV_Revised.pdf";

const careerJourney = [
  {
    year: "2021–2022",
    company: "SALA",
    role: "Content SEO Specialist",
    time: "03/2021 – 10/2022",
    description: "Bắt đầu từ keyword research, content planning, review output và quản lý tiến độ nội dung cho nhiều dự án.",
    capability: "Hiểu search intent, content quality và quy trình sản xuất nội dung.",
    logoText: "SALA"
  },
  {
    year: "2023",
    company: "GTV SEO",
    role: "SEO Executive",
    time: "03/2023 – 10/2023",
    description: "Mở rộng sang topical map, content audit, on-page, off-page, entity/brand mention và quản lý outsource.",
    capability: "Xử lý nhiều ngành, nhiều mô hình website và tốc độ triển khai agency.",
    logoText: "GTV"
  },
  {
    year: "2023–2024",
    company: "DOL English",
    role: "Middle SEO / SEO Project Leader",
    time: "10/2023 – 07/2024",
    description: "Lead dự án từ giai đoạn launch, xây topical map, site structure, internal link, schema và quy trình content.",
    capability: "Kết nối strategy, execution, technical requirement và content operation.",
    logoText: "DOL"
  },
  {
    year: "2024–2025",
    company: "Bao Bì Nhựa Việt Hoa",
    role: "SEO Freelancer",
    time: "09/2024 – 01/2025",
    description: "Định hướng migration Custom CMS sang WordPress, xây website structure, on-page, entity/link building và post-launch technical monitoring.",
    capability: "Kết hợp SEO strategy, website migration, UX/UI direction và technical monitoring.",
    logoText: "VH"
  },
  {
    year: "2025–nay",
    company: "GYB Asia",
    role: "Senior SEO Project Leader",
    time: "03/2025 – Present",
    description: "Lead nhiều dự án SEO, xây KPI/roadmap/reporting và phối hợp Content, Dev, Account, Client và Outsource team.",
    capability: "Quản lý nhiều dự án, phối hợp cross-functional và scale SEO bằng process/tooling.",
    logoText: "GYB"
  }
];
---

<BaseLayout title={title} description={description}>
  <!-- About Hero -->
  <section class="section hero-section">
    <div class="container">
      <div class="about-hero-grid">
        <div class="about-hero-left">
          <p class="section-kicker">GIỚI THIỆU</p>
          <h1 class="hero-title">Bùi Trường Thịnh</h1>
          <p class="hero-subheadline">
            SEO Specialist / SEO Project Leader xây nền tảng tăng trưởng từ dữ liệu, nội dung và automation.
          </p>
          <p class="hero-description">
            Tôi xây dựng TruThrive như một portfolio để ghi lại cách tôi tiếp cận SEO: bắt đầu từ dữ liệu, chẩn đoán đúng vấn đề, phát triển nội dung theo search intent và chuẩn hóa quy trình bằng automation.
          </p>
          <div class="btn-group">
            <a href="#about-philosophy" class="btn btn-primary">Xem năng lực SEO</a>
            <a href="/case-studies/suoi-tien-seo/" class="btn btn-secondary">Xem Case Study</a>
          </div>
        </div>

        <div class="about-hero-right">
          <div class="profile-credential-card">
            <div class="profile-avatar-wrapper">BT</div>
            <h2 class="profile-name">Bùi Trường Thịnh</h2>
            <span class="profile-title">Senior SEO Specialist / SEO Project Leader</span>
            <span class="profile-exp">4+ năm kinh nghiệm</span>
            <span class="profile-location">TP. Hồ Chí Minh, Việt Nam</span>
            
            <div class="profile-chips">
              <span class="profile-chip">Technical SEO</span>
              <span class="profile-chip">Content Strategy</span>
              <span class="profile-chip">Automation</span>
            </div>
            
            <div class="profile-action-row">
              <a 
                href={cvUrl} 
                download 
                class="btn btn-primary btn-sm profile-cv-btn"
                aria-label="Tải xuống CV của Bùi Trường Thịnh"
              >
                Tải xuống CV
              </a>
              <a 
                href={linkedinUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="profile-linkedin-link"
              >
                LinkedIn
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vì sao tôi xây dựng TruThrive? -->
  <section id="brand-story" class="section section-muted">
    <div class="container">
      <div class="brand-story-wrapper text-center">
        <div class="brand-meaning-card card">
          <p class="section-kicker">TÔN CHỈ HOẠT ĐỘNG</p>
          <h2 class="section-title">Vì sao tôi xây dựng TruThrive?</h2>
          <div class="brand-meaning-text">
            <p>
              TruThrive là nơi tôi hệ thống hóa cách mình làm SEO: thật với dữ liệu, rõ với vấn đề, thực tế trong triển khai và hướng đến tăng trưởng dài hạn. Với tôi, SEO không chỉ là checklist kỹ thuật hay sản xuất thêm nội dung, mà là quá trình kết nối nền tảng website, search intent, dữ liệu và workflow vận hành.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tư duy làm SEO của tôi -->
  <section id="about-philosophy" class="section">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">TRIẾT LÝ LÀM VIỆC</p>
        <h2 class="section-title">Tư duy làm SEO của tôi</h2>
        <p class="section-subtitle">
          Tôi không tiếp cận SEO theo check-list rời rạc. Tôi xây dựng giải pháp đồng bộ kết nối giữa kỹ thuật, nội dung và tự động hóa.
        </p>
      </div>

      <div class="beliefs-grid">
        <div class="belief-card">
          <div class="belief-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="belief-title">Đúng vấn đề trước khi đúng checklist</h3>
          <p class="belief-desc">
            Tôi không audit để liệt kê lỗi, mà để xác định điểm nghẽn thật sự của tăng trưởng.
          </p>
          <p class="belief-practical">
            <strong>Trong thực tế:</strong> phân tách lỗi technical, content gap, intent mismatch, cannibalization và authority issue trước khi đề xuất roadmap.
          </p>
        </div>
        
        <div class="belief-card">
          <div class="belief-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="belief-title">Nội dung phải có vai trò trong hệ thống</h3>
          <p class="belief-desc">
            Một bài viết không nên tồn tại riêng lẻ, mà cần đóng góp vào topical authority, intent coverage và internal link.
          </p>
          <p class="belief-practical">
            <strong>Trong thực tế:</strong> xây topical map, audit content, xác định bài cần refresh, merge, expand hoặc liên kết lại.
          </p>
        </div>
        
        <div class="belief-card">
          <div class="belief-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="belief-title">Quy trình tốt giúp SEO scale được</h3>
          <p class="belief-desc">
            Automation không thay thế tư duy SEO, nhưng giúp giảm việc lặp lại và tăng chất lượng triển khai.
          </p>
          <p class="belief-practical">
            <strong>Trong thực tế:</strong> chuẩn hóa audit, content review, logfile analysis và textlink filtering bằng workflow/tool phù hợp.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hành trình tạo nên cách tôi làm SEO (Timeline) -->
  <section class="section section-muted career-journey-section" id="career-journey">
    <div class="container">
      <div class="career-journey-container">
        
        <div class="career-sticky-shell">
          <div class="career-sticky-inner">
            
            <!-- Sticky Header inside the shell so it stays visible while scrolling -->
            <div class="career-sticky-header">
              <p class="section-kicker">KINH NGHIỆM TÍCH LŨY</p>
              <h2 class="section-title">Hành trình tạo nên cách tôi làm SEO</h2>
              <p class="section-subtitle">
                Quá trình phát triển tư duy từ thực thi chi tiết đến quản lý hệ thống dự án toàn diện.
              </p>
            </div>

            <!-- Career Interactive Body -->
            <div class="career-sticky-body">
              
              <!-- Left column: year/milestone navigation -->
              <nav class="career-years" aria-label="Mốc thời gian sự nghiệp">
                {careerJourney.map((item, index) => (
                  <button 
                    type="button"
                    class={`career-year-item ${index === 0 ? 'active' : ''}`} 
                    data-index={index}
                    aria-label={`Xem chi tiết kinh nghiệm năm ${item.year} tại ${item.company}`}
                    aria-current={index === 0 ? 'step' : undefined}
                  >
                    <span class="year-text">{item.year}</span>
                    <span class="company-sub">{item.company}</span>
                  </button>
                ))}
              </nav>

              <!-- Right column: company detail panels -->
              <div class="career-detail-panels">
                {careerJourney.map((item, index) => (
                  <div 
                    class={`career-detail-card card ${index === 0 ? 'active' : ''}`} 
                    data-index={index}
                    role="tabpanel"
                    aria-label={`Kinh nghiệm tại ${item.company}`}
                  >
                    <div class="career-card-header">
                      <div class="career-company-meta">
                        <div class="career-logo-placeholder" aria-hidden="true">
                          {item.logoText}
                        </div>
                        <div class="career-title-group">
                          <span class="career-card-mobile-year">{item.year}</span>
                          <h3 class="career-company-name">{item.company}</h3>
                          <span class="career-role">{item.role}</span>
                        </div>
                      </div>
                      <span class="career-time">
                        <svg class="calendar-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                          <line x1="16" y1="2" x2="16" y2="6"></line>
                          <line x1="8" y1="2" x2="8" y2="6"></line>
                          <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        {item.time}
                      </span>
                    </div>
                    
                    <p class="career-desc">“{item.description}”</p>
                    
                    <div class="career-capability-box">
                      <span class="capability-title">Năng lực tích lũy:</span>
                      <p class="capability-desc">“{item.capability}”</p>
                    </div>
                  </div>
                ))}
              </div>
              
            </div>
            
          </div>
        </div>

        <!-- Scroll trigger steps (Desktop only, absolute triggers stacked in parallel) -->
        <div class="career-scroll-steps">
          {careerJourney.map((_, index) => (
            <div class="career-scroll-step" data-index={index}></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Một vài dấu mốc kết quả (Proof Metrics) -->
  <section class="section">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">MINH CHỨNG NĂNG LỰC</p>
        <h2 class="section-title">Một vài dấu mốc kết quả</h2>
        <p class="section-subtitle">
          Những con số thực tế được ghi nhận thông qua phương pháp tối ưu có hệ thống trên nhiều loại hình dự án.
        </p>
      </div>

      <div class="proof-cards-grid">
        <!-- Card A: Suối Tiên -->
        <div class="proof-card">
          <div class="proof-card-header">
            <span class="proof-card-tag">TOURISM SEO GROWTH</span>
            <h3 class="proof-card-title">Suối Tiên</h3>
          </div>
          <div class="proof-card-body">
            <div class="proof-main-metric">
              <span class="proof-metric-value">32.198</span>
              <span class="proof-metric-desc">Organic Sessions (Đạt 100.8% KPI)</span>
            </div>
            <ul class="proof-sub-metrics">
              <li>KPI hoàn thành: <strong>100.8%</strong> (Mục tiêu 31.957)</li>
              <li>Thặng dư: <strong>+241 organic sessions</strong></li>
              <li>Từ khóa thứ hạng: <strong>77 Top 3</strong> · <strong>94 Top 5</strong></li>
              <li>Quy mô chiến dịch: <strong>219 tổng từ khóa</strong></li>
            </ul>
          </div>
        </div>

        <!-- Card B: B2B Packaging -->
        <div class="proof-card">
          <div class="proof-card-header">
            <span class="proof-card-tag">MIGRATION & SEO GROWTH</span>
            <h3 class="proof-card-title">B2B Packaging</h3>
          </div>
          <div class="proof-card-body">
            <div class="proof-main-metric">
              <span class="proof-metric-value">+22%</span>
              <span class="proof-metric-desc">Tăng trưởng Clicks (CTR +52%)</span>
            </div>
            <ul class="proof-sub-metrics">
              <li>Cam kết tăng trưởng: <strong>334 từ khóa</strong></li>
              <li>Tỷ lệ từ khóa Top 1–5: <strong>Đạt 22%</strong></li>
              <li>Tỷ lệ từ khóa Top 5–10: <strong>Đạt 42%</strong></li>
              <li>Hiệu suất chung: <strong>Tăng 22% clicks toàn website</strong></li>
            </ul>
          </div>
        </div>

        <!-- Card C: SEO Automation -->
