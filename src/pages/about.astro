---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Giới thiệu | Bùi Trường Thịnh — Senior SEO Specialist & AI Builder";
const description = "Tìm hiểu về Bùi Trường Thịnh — Senior SEO Specialist & AI Builder với gần 5 năm kinh nghiệm SEO, tập trung vào Technical SEO, Content Strategy, Organic Growth, Project Ownership và xây dựng internal SEO systems bằng AI-assisted development.";

const linkedinUrl = "https://www.linkedin.com/in/truongthinhseo/";

const cvUrl = "/files/Bui_Truong_Thinh_Senior_SEO_Specialist.pdf";

const careerJourney = [
  {
    year: "2021–2022",
    company: "SALA",
    role: "Content SEO Specialist",
    time: "03/2021 – 10/2022",
    description: "Nghiên cứu từ khóa, lập kế hoạch Content SEO và quản lý chất lượng nội dung cho hơn 10 dự án thuộc nhiều lĩnh vực.",
    capability: "Search intent, content planning, content review và quản lý quy trình sản xuất nội dung.",
    logoText: "SALA"
  },
  {
    year: "2023",
    company: "GTV SEO",
    role: "SEO Executive",
    time: "03/2023 – 10/2023",
    description: "Triển khai keyword research, content audit, topical map, on-page, off-page và content planning cho nhiều dự án agency; đồng thời quản lý outsource và training intern.",
    capability: "Kinh nghiệm triển khai đa ngành, vận hành agency, topical authority và phối hợp nguồn lực.",
    logoText: "GTV"
  },
  {
    year: "2023–2024",
    company: "DOL English",
    role: "Middle SEO / SEO Project Leader",
    time: "10/2023 – 07/2024",
    description: "Lead grammar.dolenglish.vn từ giai đoạn website launch, xây SEO strategy, KPI/OKR, topical map, site structure, content standards và internal linking.",
    capability: "Sở hữu dự án website mới từ strategy đến execution; kết quả đạt 66.000 organic traffic và 252 từ khóa ranking.",
    logoText: "DOL"
  },
  {
    year: "2024–2025",
    company: "Bao Bì Nhựa Việt Hoa",
    role: "SEO Freelancer",
    time: "09/2024 – 01/2025",
    description: "Định hướng migration từ Custom CMS sang WordPress, xây website structure và kế hoạch SEO sau khi website ra mắt.",
    capability: "Kinh nghiệm độc lập trong website migration, technical monitoring và phối hợp triển khai website.",
    logoText: "VH",
    isFreelance: true
  },
  {
    year: "2025–nay",
    company: "GYB Asia",
    role: "Senior SEO Project Leader",
    time: "03/2025 – Hiện tại",
    description: "Sở hữu chiến lược và trực tiếp triển khai hơn 8 dự án SEO tại agency, đồng thời phụ trách tối đa 5 dự án; trực tiếp xây KPI, roadmap, trình bày với client và điều phối các bên liên quan.",
    capability: "SEO Project Ownership, hands-on execution, KPI accountability, client communication, cross-functional delivery và functional leadership.",
    leadershipNote: "Đồng thời quản lý chuyên môn cho 01 SEO Executive phụ trách danh mục dự án riêng, bao gồm định hướng chiến lược, thiết lập và theo dõi KPI, review kế hoạch cùng kết quả triển khai; phối hợp với 01 Content Project Leader để kiểm soát kế hoạch và chất lượng nội dung.",
    logoText: "GYB"
  }
];
---

<BaseLayout title={title} description={description}>
  <!-- About Hero -->
  <section class="section hero-section">
    <div class="container">
      <div class="about-hero-grid">
        <div class="about-hero-left">
          <p class="section-kicker">GIỚI THIỆU</p>
          <h1 class="hero-title">Bùi Trường Thịnh</h1>
          <p class="hero-subheadline">
            Senior SEO Specialist & AI Builder
          </p>
          <p class="hero-description">
            Tôi sở hữu chiến lược, KPI và execution cho các dự án SEO, đồng thời xây dựng internal SEO systems bằng dữ liệu, automation và AI-assisted development.
          </p>
          <div class="btn-group">
            <a href="#career-journey" class="btn btn-primary">Xem kinh nghiệm & năng lực</a>
            <a href="/case-studies/" class="btn btn-secondary">Xem Case Studies</a>
          </div>
        </div>

        <div class="about-hero-right">
          <div class="profile-credential-card">
            <img 
              src="/images/profile/bui-truong-thinh-portrait-update.jpeg" 
              alt="Chân dung Bùi Trường Thịnh" 
              class="profile-avatar-img"
              width="240"
              height="240"
            />
            <h2 class="profile-name">Bùi Trường Thịnh</h2>
            <span class="profile-title">Senior SEO Specialist & AI Builder</span>
            <span class="profile-exp">Gần 5 năm kinh nghiệm SEO</span>
            <span class="profile-location">TP. Hồ Chí Minh, Việt Nam</span>
            
            <div class="profile-chips">
              <span class="profile-chip">Project Ownership</span>
              <span class="profile-chip">Technical SEO</span>
              <span class="profile-chip">AI Builder</span>
            </div>

            <div class="profile-evidence-row">
              <span class="evidence-pill"><strong>8+</strong> dự án SEO</span>
              <span class="evidence-pill"><strong>Tối đa 5</strong> dự án đồng thời</span>
              <span class="evidence-pill"><strong>2</strong> internal MVPs</span>
            </div>
            
            <div class="profile-action-row">
              <a 
                href={cvUrl} 
                download 
                class="btn btn-primary btn-sm profile-cv-btn"
                aria-label="Tải xuống CV của Bùi Trường Thịnh"
              >
                Tải xuống CV
              </a>
              <a 
                href={linkedinUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="profile-linkedin-link"
              >
                LinkedIn
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vì sao tôi xây dựng TruThrive? -->
  <section id="brand-story" class="section section-muted">
    <div class="container">
      <div class="brand-story-wrapper">
        <div class="brand-meaning-card card">
          <div class="brand-meaning-content">
            <p class="section-kicker">TÔN CHỈ HOẠT ĐỘNG</p>
            <h2 class="section-title">Vì sao tôi xây dựng TruThrive?</h2>
            <div class="brand-meaning-text">
              <p>
                TruThrive là nơi tôi hệ thống hóa cách mình làm SEO: thật với dữ liệu, rõ với vấn đề, thực tế trong triển khai và hướng đến tăng trưởng dài hạn. SEO không chỉ là checklist kỹ thuật hay sản xuất thêm nội dung, mà là quá trình kết nối nền tảng website, search intent, dữ liệu, con người và workflow vận hành.
              </p>
            </div>
          </div>
          <div class="brand-meaning-image-wrapper">
            <img 
              src="/images/profile/bui-truong-thinh-working.webp" 
              alt="Bùi Trường Thịnh đang làm việc thực tế với dữ liệu và hệ thống SEO" 
              class="brand-meaning-img"
              loading="lazy"
              width="480"
              height="360"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tư duy làm SEO của tôi -->
  <section id="about-philosophy" class="section">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">TRIẾT LÝ LÀM VIỆC</p>
        <h2 class="section-title">Tư duy làm SEO của tôi</h2>
        <p class="section-subtitle">
          Tôi không tiếp cận SEO theo check-list rời rạc. Tôi xây dựng giải pháp đồng bộ kết nối giữa kỹ thuật, nội dung và tự động hóa.
        </p>
      </div>

      <div class="beliefs-grid">
        <div class="belief-card">
          <div class="belief-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="belief-title">Đúng vấn đề trước khi đúng checklist</h3>
          <p class="belief-desc">
            Tôi không audit để tạo một danh sách lỗi dài, mà để xác định điểm nghẽn có tác động thực sự đến tăng trưởng.
          </p>
          <p class="belief-practical">
            <strong>Trong thực tế:</strong> phân tách technical issue, content gap, intent mismatch, cannibalization, entity và authority issue trước khi xây roadmap.
          </p>
        </div>
        
        <div class="belief-card">
          <div class="belief-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="belief-title">Nội dung phải có vai trò trong hệ thống</h3>
          <p class="belief-desc">
            Một nội dung không nên tồn tại riêng lẻ, mà cần đóng góp vào topical authority, intent coverage, internal linking và hành trình người dùng.
          </p>
          <p class="belief-practical">
            <strong>Trong thực tế:</strong> xây topical map, audit content và xác định nội dung cần refresh, merge, expand, loại bỏ hoặc liên kết lại.
          </p>
        </div>
        
        <div class="belief-card">
          <div class="belief-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="belief-title">Quy trình tốt giúp SEO scale được</h3>
          <p class="belief-desc">
            Automation không thay thế tư duy SEO, nhưng giúp giảm thao tác lặp lại, chuẩn hóa đầu ra và tăng tính nhất quán khi triển khai nhiều dự án.
          </p>
          <p class="belief-practical">
            <strong>Trong thực tế:</strong> xây Content Audit Workflow, Logfile Audit Web App và các workflow hỗ trợ xử lý dữ liệu bằng Google Sheets, Apps Script và AI-assisted development.
          </p>
        </div>
      </div>

      <div class="text-center" style="margin-top: 36px;">
        <a href="/seo-systems/" style="color: var(--color-accent); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; font-size: 0.98rem;">Xem các SEO Systems tôi đã xây →</a>
      </div>
    </div>
  </section>

  <!-- Hành trình tạo nên cách tôi làm SEO (Timeline) -->
  <section class="section section-muted career-journey-section" id="career-journey">
    <div class="container">
      <div class="career-journey-container">
        
        <div class="career-sticky-shell">
          <div class="career-sticky-inner">
            
            <!-- Sticky Header inside the shell so it stays visible while scrolling -->
            <div class="career-sticky-header">
              <p class="section-kicker">KINH NGHIỆM TÍCH LŨY</p>
              <h2 class="section-title">Hành trình tạo nên cách tôi làm SEO</h2>
              <p class="section-subtitle">
                Quá trình phát triển tư duy từ thực thi chi tiết đến quản lý hệ thống dự án toàn diện.
              </p>
            </div>

            <!-- Career Interactive Body -->
            <div class="career-sticky-body">
              
              <!-- Left column: year/milestone navigation -->
              <nav class="career-years" aria-label="Mốc thời gian sự nghiệp">
                {careerJourney.map((item, index) => (
                  <button 
                    type="button"
                    class={`career-year-item ${index === 0 ? 'active' : ''} ${item.isFreelance ? 'is-freelance-year' : ''}`} 
                    data-index={index}
                    aria-label={`Xem chi tiết kinh nghiệm năm ${item.year} tại ${item.company}`}
                    aria-current={index === 0 ? 'step' : undefined}
                  >
                    <span class="year-text">{item.year}</span>
                    <span class="company-sub">
                      {item.company}
                      {item.isFreelance && <span class="freelance-indicator">(Freelance)</span>}
                    </span>
                  </button>
                ))}
              </nav>

              <!-- Right column: company detail panels -->
              <div class="career-detail-panels">
                {careerJourney.map((item, index) => (
                  <div 
                    class={`career-detail-card card ${index === 0 ? 'active' : ''} ${item.isFreelance ? 'is-freelance-card' : ''}`} 
                    data-index={index}
                    role="tabpanel"
                    aria-label={`Kinh nghiệm tại ${item.company}`}
                  >
                    <div class="career-card-header">
                      <div class="career-company-meta">
                        <div class="career-logo-placeholder" aria-hidden="true">
                          {item.logoText}
                        </div>
                        <div class="career-title-group">
                          <span class="career-card-mobile-year">{item.year}</span>
                          <h3 class="career-company-name">
                            {item.company}
                            {item.isFreelance && <span class="freelance-badge">Freelance Role</span>}
                          </h3>
                          <span class="career-role">{item.role}</span>
                        </div>
                      </div>
                      <span class="career-time">
                        <svg class="calendar-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                          <line x1="16" y1="2" x2="16" y2="6"></line>
                          <line x1="8" y1="2" x2="8" y2="6"></line>
                          <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        {item.time}
                      </span>
                    </div>
                    
                    <p class="career-desc">“{item.description}”</p>
                    
                    <div class="career-capability-box">
                      <span class="capability-title">Năng lực tích lũy:</span>
                      <p class="capability-desc">“{item.capability}”</p>
                    </div>

                    {item.leadershipNote && (
                      <div class="career-leadership-box">
                        <span class="leadership-title">Phạm vi điều phối chuyên môn:</span>
                        <p class="leadership-desc">{item.leadershipNote}</p>
                      </div>
                    )}
                  </div>
                ))}
              </div>
              
            </div>
            
          </div>
        </div>

        <!-- Scroll trigger steps (Desktop only, absolute triggers stacked in parallel) -->
        <div class="career-scroll-steps">
          {careerJourney.map((_, index) => (
            <div class="career-scroll-step" data-index={index}></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- My SEO Operating System -->
  <section class="section" id="seo-operating-system" style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding-bottom: 88px; background-color: var(--color-card);">
    <div class="container">
      <div class="section-heading text-center" style="max-width: 800px; margin-bottom: 56px;">
        <p class="section-kicker">MÔ HÌNH VẬN HÀNH</p>
        <h2 class="section-title">My SEO Operating System</h2>
        <p class="section-subtitle">
          Quy trình vận hành có tính lặp lại cao và có cấu trúc rõ ràng nhằm đưa ra quyết định hành động chính xác nhất cho từng dự án.
        </p>
      </div>

      <div class="card-grid" style="grid-template-columns: repeat(2, 1fr); gap: 24px; margin-bottom: 40px;">
        <!-- Strategy Card -->
        <article class="card" style="padding: 24px; display: flex; flex-direction: column; gap: 12px; height: 100%; border: 1px solid var(--color-border); background-color: var(--color-bg);">
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--color-accent);">A. Strategy</div>
          <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--color-text); margin: 0;">Định hình chiến lược</h3>
          <p style="color: var(--color-muted-text); font-size: 0.92rem; line-height: 1.6; margin: 0;">
            Xác định bài toán kinh doanh và search problem, thiết lập KPI, xây SEO roadmap, thống nhất ưu tiên với stakeholder và phân bổ nguồn lực theo Impact vs. Effort.
          </p>
        </article>

        <!-- Execution Card -->
        <article class="card" style="padding: 24px; display: flex; flex-direction: column; gap: 12px; height: 100%; border: 1px solid var(--color-border); background-color: var(--color-bg);">
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--color-accent);">B. Execution</div>
          <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--color-text); margin: 0;">Trực tiếp triển khai</h3>
          <p style="color: var(--color-muted-text); font-size: 0.92rem; line-height: 1.6; margin: 0;">
            Hands-on triển khai Technical SEO, Content Strategy, on-page, internal linking, Schema, Entity SEO, tracking và các hạng mục tối ưu theo roadmap.
          </p>
        </article>

        <!-- Systems Card -->
        <article class="card" style="padding: 24px; display: flex; flex-direction: column; gap: 12px; height: 100%; border: 1px solid var(--color-border); background-color: var(--color-bg);">
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--color-accent);">C. Systems</div>
          <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--color-text); margin: 0;">Chuẩn hóa hệ thống</h3>
          <p style="color: var(--color-muted-text); font-size: 0.92rem; line-height: 1.6; margin: 0;">
            Xây audit framework, checklist, workflow và internal tools nhằm giảm thao tác thủ công, chuẩn hóa đầu vào–đầu ra và tăng tính nhất quán giữa các dự án.
          </p>
        </article>

        <!-- Review & Scale Card -->
        <article class="card" style="padding: 24px; display: flex; flex-direction: column; gap: 12px; height: 100%; border: 1px solid var(--color-border); background-color: var(--color-bg);">
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--color-accent);">D. Review & Scale</div>
          <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--color-text); margin: 0;">Đo lường & Nhân rộng</h3>
          <p style="color: var(--color-muted-text); font-size: 0.92rem; line-height: 1.6; margin: 0;">
            Theo dõi GSC, GA4, ranking và commercial-intent actions; đối chiếu KPI, điều chỉnh roadmap và nhân rộng các phương pháp đã chứng minh hiệu quả.
          </p>
        </article>
      </div>

      <div style="text-align: center; margin-top: 32px;">
        <a href="/seo-systems/" class="btn btn-primary" style="padding: 12px 28px; font-size: 0.95rem;">Khám phá các SEO Systems</a>
      </div>
    </div>
  </section>

  <!-- Dedicated AI Builder Section -->
  <section id="ai-builder-systems" class="section section-muted" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-heading text-center" style="max-width: 840px;">
        <p class="section-kicker">AI-ASSISTED BUILDING</p>
        <h2 class="section-title">AI Builder & Internal SEO Systems</h2>
        <p class="section-subtitle">
          Tôi xác định bài toán nghiệp vụ SEO, thiết kế workflow, chuẩn hóa dữ liệu và sử dụng AI-assisted development để xây các internal MVP phục vụ công việc thực tế.
        </p>
      </div>

      <div class="ai-builder-grid">
        <!-- Project 1: Content Audit Workflow -->
        <article class="card ai-builder-card">
          <div class="ai-builder-card-top">
            <div class="ai-builder-badge-row">
              <span class="ai-builder-tag is-primary">Working MVP · Internal Use</span>
              <span class="ai-builder-type">Internal System</span>
            </div>
            <h3 class="ai-builder-title">Content Audit Workflow</h3>
            <p class="ai-builder-desc">
              Workflow dùng nội bộ nhằm rút ngắn quá trình audit content, chuẩn hóa tiêu chí đánh giá và tạo recommendation nhất quán để team review và triển khai.
            </p>
          </div>
          <div class="ai-builder-meta">
            <strong>Tech Stack:</strong> Google Apps Script · Google Sheets · AI-assisted development
          </div>
        </article>

        <!-- Project 2: SEO Log Audit Web App -->
        <article class="card ai-builder-card">
          <div class="ai-builder-card-top">
            <div class="ai-builder-badge-row">
              <span class="ai-builder-tag is-secondary">Internal MVP · Bluestone</span>
              <span class="ai-builder-metric">61.990 server requests</span>
            </div>
            <h3 class="ai-builder-title">SEO Log Audit Web App</h3>
            <p class="ai-builder-desc">
              Công cụ dùng nội bộ để phân tích logfile, phát hiện crawl và bot behavior, chuyển dữ liệu thô thành audit findings và action plan có thể triển khai.
            </p>
          </div>
          <div class="ai-builder-meta">
            <strong>Data Scope:</strong> Parse logfile thực tế · Audit Findings & Action Plan
          </div>
        </article>
      </div>

      <div class="text-center" style="margin-top: 32px;">
        <a href="/seo-systems/" class="btn btn-primary" style="padding: 12px 28px; font-size: 0.95rem;">Khám phá các SEO Systems</a>
      </div>
    </div>
  </section>

  <!-- Một vài dấu mốc kết quả (Proof Metrics) -->
  <section class="section" id="proof-metrics">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">MINH CHỨNG NĂNG LỰC</p>
        <h2 class="section-title">Một vài dấu mốc kết quả</h2>
        <p class="section-subtitle">
