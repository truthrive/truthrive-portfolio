  /* Progressive Enhancement for Desktop sticky/interactive experience (min-width: 1024px) */
  @media (min-width: 1024px) {
    /* Only apply when JS adds the class and we have a wide screen */
    .career-journey-section.js-enabled .career-journey-container {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      position: relative;
    }
    
    .career-journey-section.js-enabled .career-sticky-shell {
      grid-area: 1 / 1 / 2 / 2;
      position: sticky;
      top: calc(var(--header-height, 80px) + 24px);
      height: calc(100vh - var(--header-height, 80px) - 48px);
      min-height: 600px;
      display: flex;
      align-items: center;
      align-self: start;
      z-index: 2;
      pointer-events: none;
    }
    
    .career-journey-section.js-enabled .career-sticky-inner {
      display: flex;
      flex-direction: column;
      gap: 36px;
      width: 100%;
      pointer-events: auto;
    }

    .career-journey-section.js-enabled .career-sticky-header {
      text-align: left;
    }

    .career-journey-section.js-enabled .career-sticky-header .section-subtitle {
      max-width: 860px;
    }

    .career-journey-section.js-enabled .career-sticky-body {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 64px;
      width: 100%;
      align-items: start;
    }
    
    .career-journey-section.js-enabled .career-years {
      display: flex;
      flex-direction: column;
      gap: 20px;
      position: relative;
      padding-left: 24px;
    }
    
    .career-journey-section.js-enabled .career-years::before {
      content: "";
      position: absolute;
      left: 0;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background-color: var(--color-border);
      opacity: 0.5;
    }
    
    .career-journey-section.js-enabled .career-year-item {
      background: none;
      border: none;
      padding: 8px 0 8px 24px;
      text-align: left;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      transition: opacity 0.3s ease;
      position: relative;
      opacity: 0.5;
      width: 100%;
    }
    
    .career-journey-section.js-enabled .career-year-item:hover {
      opacity: 0.85;
    }
    
    .career-journey-section.js-enabled .career-year-item.active {
      opacity: 1;
    }
    
    .career-journey-section.js-enabled .career-year-item .year-text {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--color-text);
      transition: color 0.25s ease;
      line-height: 1.2;
    }
    
    .career-journey-section.js-enabled .career-year-item.active .year-text {
      color: var(--color-accent);
      font-weight: 700;
    }
    
    .career-journey-section.js-enabled .career-year-item .company-sub {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--color-muted-text);
      margin-top: 4px;
      transition: color 0.25s ease;
    }
    
    .career-journey-section.js-enabled .career-year-item.active .company-sub {
      color: var(--color-text);
      font-weight: 700;
    }
    
    /* Mathematical bullet alignment on the vertical line */
    .career-journey-section.js-enabled .career-year-item::before {
      content: "";
      position: absolute;
      left: -4px; /* centers perfectly on a 2px vertical line at parent's padding start */
      top: 15px; /* aligns vertically with the first line of text */
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: var(--color-border);
      opacity: 0.8;
      transform: scale(0.6);
      transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
      z-index: 2;
    }
    
    .career-journey-section.js-enabled .career-year-item:hover::before {
      background-color: var(--color-accent);
      opacity: 1;
      transform: scale(0.8);
    }
    
    .career-journey-section.js-enabled .career-year-item.active::before {
      background-color: var(--color-accent);
      opacity: 1;
      transform: scale(1.3);
      box-shadow: 0 0 0 5px rgba(193, 18, 31, 0.18);
    }
    
    .career-journey-section.js-enabled .career-detail-panels {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      position: relative;
      width: 100%;
    }
    
    .career-journey-section.js-enabled .career-detail-card {
      grid-area: 1 / 1 / 2 / 2;
      opacity: 0;
      transform: translateY(16px);
      pointer-events: none;
      transition: opacity 0.35s cubic-bezier(0.25, 1, 0.5, 1), transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    }
    
    .career-journey-section.js-enabled .career-detail-card.active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    
    /* Hide the self-contained year badge on desktop because left navigation displays it prominently */
    .career-journey-section.js-enabled .career-card-mobile-year {
      display: none;
    }
    
    .career-journey-section.js-enabled .career-scroll-steps {
      grid-area: 1 / 1 / 2 / 2;
      display: flex;
      flex-direction: column;
      pointer-events: none;
      z-index: 1;
    }
    
    .career-journey-section.js-enabled .career-scroll-step {
      display: block;
      min-height: clamp(360px, 48vh, 560px); /* Tighter, more responsive scroll height */
    }
    
    .career-journey-section.js-enabled .career-scroll-step:last-child {
      min-height: 60vh;
    }
  }

  /* Full Mobile View Reset */
  @media (max-width: 1023.98px) {
    .career-journey-section.js-enabled .career-journey-container {
      display: block;
    }
    
    .career-journey-section.js-enabled .career-sticky-shell {
      position: static;
      height: auto;
      min-height: initial;
      pointer-events: auto;
    }
    
    .career-journey-section.js-enabled .career-sticky-inner {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .career-journey-section.js-enabled .career-sticky-header {
