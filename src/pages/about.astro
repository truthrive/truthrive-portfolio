</BaseLayout>

<script>
  function initCareerJourney() {
    const section = document.querySelector('.career-journey-section');
    const container = document.querySelector('.career-journey-container');
    const steps = document.querySelectorAll('.career-scroll-step');
    const years = document.querySelectorAll('.career-year-item');
    const cards = document.querySelectorAll('.career-detail-card');

    if (!section || !container || steps.length === 0) return;

    // Enable JS-driven interactive behavior
    section.classList.add('js-enabled');

    let observer;

    function setupObserver() {
      if (observer) {
        observer.disconnect();
      }

      if (window.innerWidth >= 1024) {
        const observerOptions = {
          root: null,
          rootMargin: '-35% 0px -45% 0px',
          threshold: 0
        };

        observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const index = parseInt(entry.target.getAttribute('data-index') || '0', 10);
              activateStep(index);
            }
          });
        }, observerOptions);

        steps.forEach(step => observer.observe(step));
      } else {
        // Reset dynamic classes on mobile to prevent any stray states
        years.forEach(year => {
          year.classList.remove('active');
          year.removeAttribute('aria-current');
        });
        cards.forEach(card => card.classList.remove('active'));
      }
    }

    function activateStep(index) {
      years.forEach((year, i) => {
        if (i === index) {
          year.classList.add('active');
          year.setAttribute('aria-current', 'step');
        } else {
          year.classList.remove('active');
          year.removeAttribute('aria-current');
        }
      });

      cards.forEach((card, i) => {
        if (i === index) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }

    // Set up scroll click navigation for years
    years.forEach((year) => {
      year.addEventListener('click', () => {
        const index = parseInt(year.getAttribute('data-index') || '0', 10);
        const targetStep = steps[index];
        if (targetStep) {
          targetStep.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
          });
        }
      });
    });

    setupObserver();

    // Re-initialize or adjust observer on window resize
    window.addEventListener('resize', setupObserver);
  }

  // Run on page load
  window.addEventListener('DOMContentLoaded', initCareerJourney);
  
  // Astro page transition support
  document.addEventListener('astro:page-load', initCareerJourney);
</script>


<style>
  /* Hero section and Grid */
  .about-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: center;
  }
  
  .about-hero-left {
    display: flex;
    flex-direction: column;
  }
  
  .about-hero-left .hero-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.15;
    margin: 12px 0 16px 0;
    letter-spacing: -1px;
  }

  .hero-subheadline {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 600;
    color: var(--color-accent);
    line-height: 1.4;
    margin-bottom: 20px;
  }
  
  .about-hero-left .hero-description {
    font-size: 1.05rem;
    line-height: 1.7;
