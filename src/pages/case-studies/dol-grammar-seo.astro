---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MetricCard from "../../components/ui/MetricCard.astro";
import DonutChart from "../../components/ui/DonutChart.astro";
import EvidenceCard from "../../components/ui/EvidenceCard.astro";

const keyMetrics = [
  {
    value: 66800,
    label: "Estimated Traffic (Semrush)",
    format: "thousand-dot",
    animated: true
  },
  {
    value: 252,
    label: "Từ khóa xếp hạng",
    format: "integer",
    animated: true
  },
  {
    value: 16,
    suffix: "%",
    label: "Top 1–3",
    format: "integer",
    animated: true
  },
  {
    value: 21,
    suffix: "%",
    label: "Top 6–10",
    format: "integer",
    animated: true
  }
] as const;

const resultsEvidence = [
  {
    title: "Phân bổ xếp hạng & chuyển dịch từ khóa",
    sourceLabel: "SpySerp / Rank Tracker",
    imageSrc: "#",
    placeholder: "Thêm ảnh chụp bảng phân bổ xếp hạng từ SpySerp",
    alt: "Bảng phân bổ xếp hạng và chuyển dịch từ khóa của dự án DOL Grammar trong Phase 1",
    caption: "Minh chứng phân bổ xếp hạng: 16% Top 1–3, 8% Top 4–5, 21% Top 6–10 trên tổng số 252 từ khóa xếp hạng.",
    insights: [
      "Theo dõi sát sao chuyển dịch vị trí của 252 từ khóa mục tiêu.",
      "Ghi nhận đà bứt phá vị trí ở cả 3 nhóm Top 1–3, Top 4–5 và Top 6–10.",
      "Làm cơ sở đánh giá mức độ bao phủ và tính hiệu quả của Topical Map."
    ]
  },
  {
    title: "Xu hướng visibility & sự hiện diện tự nhiên",
    sourceLabel: "Semrush Organic Research",
    imageSrc: "#",
    placeholder: "Thêm ảnh chụp xu hướng tăng trưởng Organic Visibility từ Semrush",
    alt: "Biểu đồ xu hướng tăng trưởng visibility và hiện diện tự nhiên từ Semrush Organic Research",
    caption: "Semrush Organic Research đóng vai trò là bằng chứng hỗ trợ cho sự hiện diện tự nhiên và đà tăng trưởng visibility.",
    insights: [
      "Đánh giá xu hướng tăng trưởng visibility tự nhiên từ góc nhìn độc lập của bên thứ ba.",
      "Theo dõi số lượng từ khóa và độ phủ tổng thể trên công cụ tìm kiếm.",
      "Lưu ý: Số liệu Semrush đóng vai trò là estimated traffic và visibility để đánh giá hiệu suất tăng trưởng của dự án."
    ]
  }
];

const seoProblems = [
  {
    num: '01',
    title: 'Rủi ro Sandbox của sub-domain mới',
    shortLabel: 'Sandbox & Indexing Risk',
    severity: 'Critical',
    shortDesc: 'Một sub-domain mới có thể bị index và ranking chậm trong giai đoạn đầu, đặc biệt khi mục tiêu organic growth trong 12 tháng tương đối cao.',
    impact: 'Làm chậm tốc độ đạt ranking, kéo dài thời gian chứng minh tín hiệu trust và ảnh hưởng tiến độ KPI.',
    response: 'Chuẩn bị pre-launch SEO, PR/entity, author/schema, kế hoạch đăng tải và monitoring sau live-site.'
  },
  {
    num: '02',
    title: 'Chất lượng nội dung học thuật',
    shortLabel: 'Academic Content Quality',
    severity: 'High priority',
    shortDesc: 'Nội dung ngữ pháp tiếng Anh yêu cầu độ chính xác cao, không thể chỉ tối ưu theo keyword mà bỏ qua tính đúng đắn về học thuật.',
    impact: 'Content sai hoặc thiếu chuẩn có thể làm giảm trust, ảnh hưởng trải nghiệm học tập và chất lượng topical authority.',
    response: 'Xây dựng content standards và phối hợp với Academy team để kiểm soát độ chính xác ngữ pháp.'
  },
  {
    num: '03',
    title: 'Cannibalization giữa lý thuyết và bài tập',
    shortLabel: 'Search Intent Overlap',
    severity: 'Growth blocker',
    shortDesc: 'Các keyword bài tập có nguy cơ trùng intent hoặc cạnh tranh với bài lý thuyết nếu cấu trúc URL, heading và internal link không rõ.',
    impact: 'Google khó xác định URL phù hợp nhất cho từng intent, dẫn tới phân tán ranking signal.',
    response: 'Phân tách intent lý thuyết, bài tập và ứng dụng; tối ưu cấu trúc nội dung và internal linking theo từng nhóm truy vấn.'
  },
  {
    num: '04',
    title: 'Topical Map ngữ pháp phức tạp',
    shortLabel: 'Complex Structure Map',
    severity: 'High priority',
    shortDesc: 'Ngữ pháp tiếng Anh có nhiều nhóm chủ đề liên kết chặt chẽ như thì, mệnh đề, từ loại, cấu trúc câu, bài tập và cách dùng.',
    impact: 'Nếu topical map yếu, website khó xây dựng authority theo cụm chủ đề và dễ bị rời rạc giữa các bài viết.',
    response: 'Thiết kế cấu trúc website theo nhóm intent, category ngữ pháp và mối liên kết giữa lý thuyết – bài tập – ứng dụng.'
  },
  {
    num: '05',
    title: 'Hạn chế SEO từ Custom CMS',
    shortLabel: 'CMS Technical Limits',
    severity: 'Technical constraint',
    shortDesc: 'Website sử dụng Custom CMS với khả năng hỗ trợ SEO hạn chế, gây khó khăn cho on-page, schema, internal link và technical QA.',
    impact: 'Làm tăng chi phí kiểm tra kỹ thuật, giảm tốc độ triển khai và tạo rủi ro khi cần scale nội dung lớn.',
    response: 'Thiết lập checklist technical/on-page, phối hợp dev để xử lý issue ưu tiên và kiểm soát QA sau live-site.'
  },
  {
    num: '06',
    title: 'Đối thủ mạnh ở nhóm big keywords',
    shortLabel: 'Competitive Pressure',
    severity: 'Competitive pressure',
    shortDesc: 'Nhiều big keywords trong lĩnh vực ngữ pháp đã có đối thủ mạnh chiếm vị trí tốt trước khi DOL Grammar live-site.',
    impact: 'Khó tăng trưởng nhanh nếu chỉ triển khai content đơn lẻ mà không có topical authority, entity và internal link system.',
    response: 'Ưu tiên big keywords theo cụm, xây content architecture, entity signals và internal linking để tăng sức mạnh chủ đề.'
  }
] as const;
---

<BaseLayout 
  title="Case Study SEO DOL Grammar | TruThrive" 
  description="Case study SEO DOL Grammar: xây dựng Topical Authority vượt trội cho sub-domain mới từ launch, đạt mốc 66.000 traffic chỉ sau 4 tháng vận hành."
>
  <!-- 1. Hero Section -->
  <section class="section hero-section">
    <div class="container">
      <div class="section-heading text-center" style="max-width: 800px; margin-left: auto; margin-right: auto; margin-bottom: 32px;">
      <span class="pill" style="margin-bottom: 16px;">SEO Case Studies</span>
        <h1 class="hero-title" style="margin-bottom: 24px;">Case Study SEO DOL Grammar</h1>
        <p class="hero-description" style="margin-left: auto; margin-right: auto; max-width: 700px; margin-bottom: 20px;">
          Xây dựng nền tảng SEO cho một sub-domain ngữ pháp tiếng Anh mới, tập trung vào Topical Authority, giảm rủi ro Sandbox và kiểm soát chất lượng nội dung học thuật.
        </p>
        <div class="chip-group" style="justify-content: center; margin-bottom: 24px; margin-top: 16px;">
          <span class="chip">New Site SEO</span>
          <span class="chip">Topical Authority</span>
          <span class="chip">Content Strategy</span>
          <span class="chip">Custom CMS SEO</span>
          <span class="chip">Education SEO</span>
        </div>
        
        <!-- Premium inline result hook pill -->
        <div class="hero-result-hook" style="display: flex; justify-content: center; margin-top: 16px;">
          <span class="hook-pill">0 → 66.800 Estimated Traffic (Semrush) · 252 ranking keywords · 16% Top 1–3 · 8% Top 4–5 · 21% Top 6–10</span>
        </div>
      </div>

      <!-- Project Snapshot Card -->
      <div class="case-snapshot">
        <!-- Top Info Grid -->
        <div class="case-snapshot-top">
          <!-- Column 1: Client -->
          <div class="snapshot-col col-client">
            <span class="snapshot-label">Client</span>
            <div class="client-info">
              <div class="client-logo-frame">
                <img 
                  src="/images/logos/dol-grammar-logo-logo.png" 
                  alt="DOL English Logo" 
                  class="client-logo" 
                />
              </div>
              <span class="snapshot-value">grammar.dolenglish.vn</span>
            </div>
          </div>
          
          <!-- Column 2: Timeline -->
          <div class="snapshot-col col-timeline">
            <span class="snapshot-label">Timeline</span>
            <div class="snapshot-value-group">
              <span class="snapshot-value">10 tháng</span>
              <span class="snapshot-subvalue">10/2023 – 07/2024</span>
            </div>
          </div>
          
          <!-- Column 3: Ngành -->
          <div class="snapshot-col col-industry">
            <span class="snapshot-label">Ngành</span>
            <div class="snapshot-value-group">
              <span class="snapshot-value">EdTech / E-Learning</span>
              <span class="snapshot-subvalue">Ngữ pháp tiếng Anh</span>
            </div>
          </div>
          
          <!-- Column 4: Vai trò -->
          <div class="snapshot-col col-role">
            <span class="snapshot-label">Vai trò</span>
            <div class="snapshot-value-group">
              <span class="snapshot-value">SEO Project Leader</span>
              <span class="snapshot-subvalue">Strategy · Content System · Technical Coordination</span>
            </div>
          </div>
        </div>

        <!-- Scope Row -->
        <div class="case-snapshot-bottom">
          <span class="snapshot-label">Phạm vi triển khai</span>
          <div class="snapshot-chips">
            <span class="snapshot-chip">Topical Authority</span>
            <span class="snapshot-chip">New Website SEO</span>
            <span class="snapshot-chip">Content Strategy</span>
            <span class="snapshot-chip">Internal Linking</span>
            <span class="snapshot-chip">Entity / Schema</span>
            <span class="snapshot-chip">Custom CMS SEO</span>
          </div>
        </div>
      </div>

      <div class="btn-group center" style="margin-top: 40px;">
        <a href="#results" class="btn btn-primary">Xem kết quả</a>
        <a href="#insights" class="btn btn-secondary">Bài học rút ra</a>
      </div>
    </div>
  </section>

  <!-- 2. Project Context — 3 Insight Cards -->
  <section class="section">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">BỐI CẢNH DỰ ÁN</p>
        <h2 class="section-title">3 yếu tố định hình chiến lược SEO</h2>
        <p class="section-subtitle">Hiểu đúng bối cảnh giúp định hướng chiến lược triển khai phù hợp.</p>
      </div>
      <div class="cs-context-grid">
        <article class="card cs-context-card">
          <div class="cs-context-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
          </div>
          <h3 class="cs-context-title">Sub-domain hoàn toàn mới</h3>
          <p class="cs-context-desc">
            grammar.dolenglish.vn bắt đầu từ con số 0, đòi hỏi lộ trình tăng trưởng khẩn trương để đạt được cam kết traffic lớn trong năm đầu.
          </p>
        </article>
        <article class="card cs-context-card">
          <div class="cs-context-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path></svg>
          </div>
          <h3 class="cs-context-title">Độ chính xác học thuật cao</h3>
          <p class="cs-context-desc">
            Nội dung ngữ pháp bắt buộc chuẩn xác tuyệt đối 100%, đòi hỏi quy trình phối hợp kiểm duyệt (QA) chặt chẽ với ban học thuật Academy.
          </p>
        </article>
        <article class="card cs-context-card">
          <div class="cs-context-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          </div>
          <h3 class="cs-context-title">Hệ thống Custom CMS sơ khai</h3>
          <p class="cs-context-desc">
            Hệ thống CMS tự phát triển còn thiếu nhiều tính năng SEO kỹ thuật và phát sinh các rào cản về crawl, indexation hàng loạt.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. My Role -->
  <section class="section section-muted">
    <div class="container">
      <div class="cs-role-card card" style="max-width: 900px; margin: 0 auto;">
        <div class="cs-role-header">
          <p class="section-kicker">VAI TRÒ CỦA TÔI</p>
          <h2 class="section-title" style="font-size: 1.8rem;">SEO Project Leader</h2>
          <p class="cs-role-subtitle" style="font-weight: 700; color: var(--color-accent); margin-top: -8px; margin-bottom: 16px; font-size: 1.05rem;">Chịu trách nhiệm thiết lập chiến lược SEO & trực tiếp quản lý triển khai</p>
        </div>
        <p class="cs-role-desc">
          Tôi đảm nhiệm vai trò lập chiến lược SEO tổng thể, lên kế hoạch OKR/KPI theo quý, quy hoạch Topical Map & cấu trúc website, xây dựng tiêu chuẩn nội dung và phối hợp cùng Academy team để kiểm duyệt chất lượng. Đồng thời, tôi trực tiếp điều phối các hoạt động technical on-page, internal link, schema thực thể/tác giả, lập kế hoạch PR/entity và làm việc sát sao với đội Dev để tối ưu Custom CMS.
        </p>
        <div class="cs-role-tags">
          <span class="cs-role-tag">SEO Strategy</span>
          <span class="cs-role-tag">Topical Mapping</span>
          <span class="cs-role-tag">Content Standards</span>
          <span class="cs-role-tag">Technical & Schema</span>
          <span class="cs-role-tag">PR/Entity Planning</span>
          <span class="cs-role-tag">Cross-Team Coordination</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SEO Problems / Challenges Section -->
  <section id="problems-section" class="section section-muted">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">VẤN ĐỀ CẦN GIẢI QUYẾT</p>
        <h2 class="section-title">Các vấn đề SEO cốt lõi cần xử lý</h2>
        <p class="section-subtitle" style="max-width: 800px; margin-left: auto; margin-right: auto;">
          Dự án không chỉ cần sản xuất nội dung ngữ pháp, mà còn phải xử lý rủi ro index/ranking của website mới, chất lượng học thuật, cannibalization và hạn chế kỹ thuật từ Custom CMS.
        </p>
      </div>

      <div class="problems-layout">
        <!-- Left Column: Interactive Modules (Clickable buttons) -->
        <div class="problems-modules">
          {seoProblems.map((prob, index) => {
            const isActive = index === 0;
            return (
              <div class="problems-accordion-item">
                <button 
                  id={`problem-btn-${prob.num}`}
                  class={`problems-module ${isActive ? 'is-active' : ''}`}
                  aria-expanded={isActive ? "true" : "false"}
                  aria-controls={`problems-mobile-panel-${prob.num}`}
                  data-problem-id={prob.num}
                >
                  <div class="problems-module__header">
                    <span class="problems-num">{prob.num}</span>
                    <h4 class="problems-module__title">{prob.title}</h4>
                  </div>
                  <p class="problems-module__outcome">{prob.shortDesc}</p>
                  <span class="problems-module__label">{prob.shortLabel}</span>
                </button>
                
                <!-- Mobile accordion inline detail panel -->
                <div 
                  id={`problems-mobile-panel-${prob.num}`}
                  class={`problems-mobile-panel ${isActive ? 'is-active' : ''}`}
                  aria-hidden={isActive ? "false" : "true"}
                  role="region"
                  aria-labelledby={`problem-btn-${prob.num}`}
                >
                  <div class="problems-mobile-panel-header">
                    <span class="severity-badge">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="warning-icon"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                      {prob.severity}
                    </span>
                  </div>

                  <div class="problems-detail-section">
                    <h4 class="problems-section-title">Mô tả vấn đề:</h4>
                    <p class="problems-panel-desc">{prob.shortDesc}</p>
                  </div>

                  <div class="problem-outcome-stack">
                    <div class="problem-impact">
                      <h4>Hậu quả & Tác động (Impact)</h4>
                      <p>{prob.impact}</p>
                    </div>

                    <div class="problem-response">
                      <h4>Giải pháp xử lý (Response)</h4>
                      <p>{prob.response}</p>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Right Column: Desktop active detail panel -->
        <div class="card problems-detail-panel desktop-panel-only">
          <span class="problems-detail-eyebrow">Thông tin chi tiết</span>
          
          <div class="problems-panels-stack">
            {seoProblems.map((prob, index) => {
              const isActive = index === 0;
              return (
                <div 
                  id={`problem-panel-${prob.num}`}
                  class={`problems-panel-content ${isActive ? 'is-active' : ''}`}
                  role="region"
                  aria-labelledby={`problem-btn-${prob.num}`}
                  aria-hidden={isActive ? "false" : "true"}
                >
                  <div class="problems-panel-header">
                    <div class="problems-panel-title-group">
                      <span class="problems-panel-num">{prob.num}</span>
                      <h3 class="problems-panel-title">{prob.title}</h3>
                    </div>
                    <span class="severity-badge">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="warning-icon"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                      {prob.severity}
                    </span>
                  </div>

                  <div class="problems-detail-section">
                    <h4 class="problems-section-title">Mô tả vấn đề:</h4>
                    <p class="problems-panel-desc">{prob.shortDesc}</p>
                  </div>

                  <div class="problem-outcome-stack">
                    <div class="problem-impact">
                      <h4>Hậu quả & Tác động (Impact)</h4>
                      <p>{prob.impact}</p>
                    </div>

                    <div class="problem-response">
                      <h4>Giải pháp xử lý (Response)</h4>
                      <p>{prob.response}</p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Search Demand Map -->
  <section class="section">
    <div class="container" style="max-width: 1120px;">
      <div class="section-heading text-center">
        <p class="section-kicker">USER INTENT & TOPICS</p>
        <h2 class="section-title">Search Demand Map</h2>
        <p class="section-subtitle">Phân tách nhu cầu tìm kiếm theo intent để quy hoạch các cụm nội dung và cấu trúc URL tương ứng.</p>
      </div>

      <div class="cs-demand-map-grid">
        <!-- Card A: Theory / Knowledge Intent -->
        <article class="card cs-demand-card">
          <div class="demand-header">
            <span class="demand-intent-badge">Theory / Knowledge Intent</span>
            <h3>Lý thuyết ngữ pháp</h3>
          </div>
          <p class="demand-desc">Người dùng tìm kiếm định nghĩa, công thức, cách dùng và ví dụ thực tế cho các cấu trúc ngữ pháp từ cơ bản đến nâng cao.</p>
          <div class="demand-topics">
            <span class="demand-topic-title">Cụm chủ đề ưu tiên</span>
            <div class="demand-topic-chips">
              <span class="chip chip-outline">Các thì tiếng Anh</span>
              <span class="chip chip-outline">Từ loại (Danh, Động, Tính, Trạng)</span>
              <span class="chip chip-outline">Cấu trúc câu nâng cao</span>
            </div>
          </div>
        </article>

        <!-- Card B: Practice / Exercise Intent -->
        <article class="card cs-demand-card">
          <div class="demand-header">
            <span class="demand-intent-badge">Practice / Exercise Intent</span>
