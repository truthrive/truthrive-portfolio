<script>
  import "../../scripts/interactions.js";

  // Interactive Wins Board Panel logic
  document.addEventListener('DOMContentLoaded', () => {
    const keywordItems = document.querySelectorAll('.ranking-keyword-item');
    const activeKwName = document.getElementById('active-kw-name');
    const activeKwBadge = document.getElementById('active-kw-badge');
    const serpImage = document.getElementById('serp-proof-image');
    const serpPlaceholder = document.getElementById('serp-proof-placeholder');
    const serpCaption = document.getElementById('serp-proof-caption');

    if (!keywordItems.length || !serpImage || !serpPlaceholder) return;

    // Handle image loading error to show custom placeholder
    serpImage.addEventListener('error', () => {
      serpImage.style.display = 'none';
      serpPlaceholder.style.display = 'flex';
    });

    // Handle successful load
    serpImage.addEventListener('load', () => {
      // If src is "#" or empty, force placeholder instead of showing broken icon
      if (serpImage.getAttribute('src') === '#' || !serpImage.getAttribute('src')) {
        serpImage.style.display = 'none';
        serpPlaceholder.style.display = 'flex';
      } else {
        serpImage.style.display = 'block';
        serpPlaceholder.style.display = 'none';
      }
    });

    // Trigger error check initially
    if (serpImage.complete) {
      if (serpImage.naturalWidth === 0 || serpImage.getAttribute('src') === '#') {
        serpImage.style.display = 'none';
        serpPlaceholder.style.display = 'flex';
      }
    }

    keywordItems.forEach(item => {
      item.addEventListener('click', () => {
        // Remove active class from all items
        keywordItems.forEach(i => i.classList.remove('is-active'));
        
        // Add active class to clicked item
        item.classList.add('is-active');

        // Retrieve data attributes
        const name = item.getAttribute('data-keyword') || '';
        const rank = item.getAttribute('data-rank') || '';
        const imgUrl = item.getAttribute('data-image') || '#';
        const caption = item.getAttribute('data-caption') || '';

        // Reset visibility to show image while loading, error event will toggle placeholder if needed
        serpImage.style.display = 'block';
        serpPlaceholder.style.display = 'none';

        // Update preview panel with smooth transition
        serpImage.style.opacity = '0';
        
        setTimeout(() => {
          if (activeKwName) activeKwName.textContent = name;
          if (activeKwBadge) {
            activeKwBadge.textContent = rank;
            
            // Update rank badge colors
            activeKwBadge.className = 'keyword-rank-badge';
            if (rank === 'Phase 1 Win') {
              activeKwBadge.classList.add('rank-win');
            } else if (rank === 'Tracked Keyword') {
              activeKwBadge.classList.add('rank-tracked');
            } else {
              activeKwBadge.classList.add('rank-signal');
            }
          }

          serpImage.setAttribute('src', imgUrl);
          serpImage.setAttribute('alt', `SERP Proof: ${name}`);
          if (serpCaption) serpCaption.textContent = caption;
          
          serpImage.style.opacity = '1';
        }, 150); // Fast, micro-animation fade transition
      });
    });

    // Interactive SEO Problems Section logic
    const problemsSection = document.querySelector('#problems-section');
    if (problemsSection) {
      const tabButtons = problemsSection.querySelectorAll('.problems-module');
      const tabPanels = problemsSection.querySelectorAll('.problems-panel-content');
      const mobilePanels = problemsSection.querySelectorAll('.problems-mobile-panel');

      const isMobileQuery = window.matchMedia('(max-width: 1023.98px)');
      const isMobile = () => isMobileQuery.matches;

      let currentActiveId = 'problem-panel-01'; // Default active panel ID on desktop

      const updateActiveState = (activePanelId) => {
        const activeNum = activePanelId ? activePanelId.replace('problems-mobile-panel-', '').replace('problem-panel-', '') : null;

        tabButtons.forEach(btn => {
          const num = btn.getAttribute('data-problem-id');
          const isActive = activeNum === num;

          btn.setAttribute('aria-expanded', isActive ? 'true' : 'false');
          if (isActive) {
            btn.classList.add('is-active');
          } else {
            btn.classList.remove('is-active');
          }
        });

        tabPanels.forEach(panel => {
          const num = panel.id.replace('problem-panel-', '');
          const isActive = activeNum === num;
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          if (isActive) {
            panel.classList.add('is-active');
          } else {
            panel.classList.remove('is-active');
          }
        });

        mobilePanels.forEach(panel => {
          const num = panel.id.replace('problems-mobile-panel-', '');
          const isActive = activeNum === num;
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          if (isActive) {
            panel.classList.add('is-active');
          } else {
            panel.classList.remove('is-active');
          }
        });
      };

      // Set initial active state
      updateActiveState(currentActiveId);

      // Listen for window resize/media changes
      isMobileQuery.addEventListener('change', () => {
        if (!isMobile() && !currentActiveId) {
          currentActiveId = 'problem-panel-01';
        }
        updateActiveState(currentActiveId);
      });

      tabButtons.forEach(btn => {
        const num = btn.getAttribute('data-problem-id');

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const isMobileView = isMobile();
          const isActive = btn.classList.contains('is-active');

          if (isMobileView) {
            if (isActive) {
              // Collapse it
              currentActiveId = null;
              updateActiveState(null);
            } else {
              // Expand it
              currentActiveId = `problems-mobile-panel-${num}`;
              updateActiveState(currentActiveId);
            }
          } else {
            // Desktop: click activates
            currentActiveId = `problem-panel-${num}`;
            updateActiveState(currentActiveId);
          }
        });
      });
    }
  });
</script>
