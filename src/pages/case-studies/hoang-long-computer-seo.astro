  .cs-role-pillars {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }

  .cs-role-pillar {
    min-width: 0;
    padding-inline: 22px;
  }

  .cs-role-pillar + .cs-role-pillar {
    border-left: 1px solid rgba(216, 207, 196, 0.55);
  }

  .cs-role-pillar:first-child {
    padding-left: 0;
  }

  .cs-role-pillar:last-child {
    padding-right: 0;
  }

  .cs-role-pillar-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .cs-role-pillar-icon {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    color: var(--color-accent);
  }

  .cs-role-pillar h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0.01em;
  }

  .cs-role-pillar ul {
    display: grid;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .cs-role-pillar li {
    position: relative;
    padding-left: 14px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.45;
  }

  .cs-role-pillar li::before {
    content: "";
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 4px;
    height: 4px;
    background: var(--color-accent);
    border-radius: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 1023px) {
    .cs-role-pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }

    .cs-role-pillar,
    .cs-role-pillar:first-child,
    .cs-role-pillar:last-child {
      padding-inline: 20px;
      border-left: none;
    }

    .cs-role-pillar:nth-child(odd) {
      padding-left: 0;
    }

    .cs-role-pillar:nth-child(even) {
      padding-right: 0;
      border-left: 1px solid rgba(216, 207, 196, 0.55);
    }
  }

  @media (max-width: 640px) {
    .cs-role-card {
      padding: 24px;
    }

    .cs-role-pillars {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .cs-role-pillar,
    .cs-role-pillar:first-child,
    .cs-role-pillar:last-child,
    .cs-role-pillar:nth-child(even),
    .cs-role-pillar:nth-child(odd) {
      padding: 0;
      border-left: none;
    }
  }

  /* === Results Evidence Scrollytelling === */
  .results-story-container {
    max-width: 1200px;
  }

  .results-story-heading {
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: clamp(48px, 7vw, 80px);
  }

  .results-story {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.8fr);
    gap: clamp(36px, 5vw, 64px);
    align-items: stretch;
  }

  .results-insight-column {
    position: relative;
    min-width: 0;
    align-self: stretch;
  }

  .results-insight-panel {
    position: sticky;
    top: clamp(88px, 12vh, 136px);
    max-height: calc(100vh - clamp(112px, 16vh, 168px));
    padding: 28px 24px 24px;
    background: linear-gradient(145deg, rgba(193, 18, 31, 0.035), rgba(255, 255, 255, 0.78));
    border-top: 2px solid var(--color-accent);
    border-bottom: 1px solid var(--color-border);
  }

  .results-insight-current {
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .results-insight-current.is-updating {
    opacity: 0.35;
    transform: translateY(3px);
  }

  .results-current-index {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin-bottom: 24px;
    color: var(--color-muted-text);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .results-current-index [data-results-current-index] {
    color: var(--color-accent);
    font-size: 2.15rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .results-current-category,
  .result-evidence-kicker,
  .result-evidence-footer > span {
    display: block;
    color: var(--color-accent);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .results-insight-copy h3 {
    margin: 7px 0 0;
    color: var(--color-text);
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .results-progress {
    display: grid;
    gap: 0;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
  }

  .results-progress li {
    position: relative;
  }

  .results-progress li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 24px;
    left: 7px;
    width: 1px;
    height: calc(100% - 8px);
    background: var(--color-border);
  }

  .results-progress li.is-complete:not(:last-child)::after {
    background: rgba(193, 18, 31, 0.42);
  }

  .results-progress-button {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: var(--color-muted-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .results-progress-button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .results-progress-node {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
    border: 2px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .results-progress li.is-active .results-progress-node {
    border-color: var(--color-accent);
    background: var(--color-accent);
    box-shadow: 0 0 0 4px rgba(193, 18, 31, 0.1);
  }

  .results-progress li.is-complete .results-progress-node {
    border-color: rgba(193, 18, 31, 0.58);
    background: rgba(193, 18, 31, 0.18);
  }

  .results-progress-label {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 8px;
  }

  .results-progress-label small {
    color: inherit;
    font-size: 0.66rem;
    font-weight: 700;
  }

  .results-progress-label > span {
    font-size: 0.82rem;
    font-weight: 550;
    line-height: 1.3;
  }

  .results-progress li.is-active .results-progress-button {
    color: var(--color-text);
  }

  .results-progress li.is-active .results-progress-label > span {
    font-weight: 700;
  }

  .results-evidence-flow {
    min-width: 0;
    align-self: start;
  }

  .result-story-step {
    display: flex;
    min-height: clamp(480px, 68vh, 680px);
    align-items: center;
    scroll-margin-top: 112px;
    opacity: 1;
    transform: none;
    transition: opacity 280ms ease, transform 280ms ease;
  }

  .results-story.is-enhanced .result-story-step {
    opacity: 0.48;
    transform: translateY(12px);
  }

  .results-story.is-enhanced .result-story-step.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .result-evidence-surface {
    width: 100%;
    padding: clamp(28px, 4vw, 44px);
    overflow: hidden;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: clamp(18px, 2vw, 26px);
    box-shadow: 0 12px 36px rgba(42, 31, 27, 0.06);
    transition: border-color 280ms ease, box-shadow 280ms ease;
  }

  .results-story.is-enhanced .result-story-step.is-active .result-evidence-surface {
    border-color: rgba(193, 18, 31, 0.34);
    box-shadow: 0 18px 48px rgba(42, 31, 27, 0.1);
  }

  .result-evidence-header {
    max-width: 68ch;
  }

  .result-evidence-header h3 {
    margin: 10px 0 0;
    color: var(--color-text);
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  /* Ranking Performance evidence */
  .ranking-evidence-header p {
    max-width: 62ch;
    margin: 12px 0 0;
    color: var(--color-muted-text);
    font-size: 0.94rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .ranking-executive-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 46px);
    align-items: start;
    margin-top: 30px;
    padding: 22px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .ranking-headline-metric {
    min-width: 0;
    padding: 0;
  }

  .ranking-headline-metric strong {
    display: block;
    color: var(--color-text);
    font-size: clamp(2rem, 3.8vw, 2.95rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .ranking-headline-metric:nth-child(2) strong,
  .ranking-headline-metric:nth-child(3) strong {
    color: var(--color-accent);
  }

  .ranking-headline-metric span {
    display: block;
    margin-top: 8px;
    color: var(--color-muted-text);
    font-size: 0.68rem;
    font-weight: 550;
    line-height: 1.35;
  }

  .ranking-comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 40px);
    margin-top: 32px;
  }

  .ranking-set {
    min-width: 0;
  }

  .ranking-set + .ranking-set {
    padding-left: clamp(24px, 4vw, 40px);
    border-left: 1px solid var(--color-border);
  }

  .ranking-set-header > span {
    display: block;
    color: var(--color-accent);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .ranking-set-header h4 {
    margin: 6px 0 0;
    color: var(--color-text);
    font-size: 0.98rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  .ranking-bars {
    display: grid;
    gap: 16px;
    margin-top: 20px;
  }

  .ranking-bar-row {
    min-width: 0;
  }

  .ranking-bar-meta {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 7px;
    color: var(--color-text);
    font-size: 0.76rem;
    font-weight: 650;
  }

  .ranking-bar-meta strong {
    white-space: nowrap;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
  }

  .ranking-bar-track {
    height: 8px;
    overflow: hidden;
    background: rgba(216, 207, 196, 0.52);
    border-radius: var(--radius-pill);
  }

  .ranking-bar-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
  }

  .ranking-bar-fill.is-top-3 {
    background: var(--color-accent);
  }

  .ranking-bar-fill.is-top-5 {
    background: #263241;
  }

  .ranking-bar-fill.is-top-10 {
    background: #8A7E72;
  }

  .ranking-featured-keywords {
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid var(--color-border);
  }

  .ranking-featured-keywords h4 {
    margin: 0;
    color: var(--color-text);
    font-size: 0.88rem;
    font-weight: 750;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .ranking-featured-keywords ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 4vw, 40px);
    row-gap: 0;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .ranking-featured-keywords li {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(216, 207, 196, 0.65);
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 550;
    line-height: 1.35;
  }

  .ranking-featured-keywords li > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ranking-featured-keywords li > strong {
    flex: 0 0 auto;
    padding: 4px 8px;
    color: var(--color-accent);
    background: rgba(193, 18, 31, 0.055);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 750;
    line-height: 1;
    white-space: nowrap;
  }

  /* Search Visibility evidence */
  .visibility-evidence-header p {
    max-width: 68ch;
    margin: 12px 0 0;
    color: var(--color-muted-text);
    font-size: 0.94rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .visibility-executive-metrics {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(16px, 3vw, 34px);
    align-items: stretch;
    margin-top: 24px;
    padding: 18px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .visibility-headline-metric {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 10px clamp(10px, 2vw, 18px);
    border-radius: 10px;
  }

  .visibility-headline-metric strong {
    display: block;
    color: var(--color-accent);
    font-size: clamp(1.9rem, 3.5vw, 2.8rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .ranking-wins-trigger {
    display: inline-flex;
    width: fit-content;
    min-height: 38px;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    padding: 8px 11px;
    color: var(--color-text);
    background: rgba(247, 244, 240, 0.72);
    border: 1px solid rgba(216, 207, 196, 0.9);
    border-radius: 7px;
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .ranking-wins-trigger svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    color: var(--color-accent);
  }

  .ranking-wins-trigger small {
    padding-left: 8px;
    border-left: 1px solid var(--color-border);
    color: var(--color-muted-text);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .ranking-wins-trigger:hover {
    border-color: rgba(193, 18, 31, 0.32);
    background: rgba(193, 18, 31, 0.04);
  }

  .ranking-wins-trigger:focus-visible,
  .ranking-wins-close:focus-visible,
  .ranking-wins-topic:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .ranking-wins-modal {
    position: fixed;
    z-index: 1200;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(14px, 3vw, 34px);
  }

  .ranking-wins-modal[hidden] {
    display: none;
  }

  .ranking-wins-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(25, 20, 18, 0.84);
  }

  .ranking-wins-dialog {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(92vw, 1320px);
    max-height: 90vh;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid rgba(216, 207, 196, 0.95);
    border-radius: 16px;
    box-shadow: 0 24px 70px rgba(25, 20, 18, 0.24);
