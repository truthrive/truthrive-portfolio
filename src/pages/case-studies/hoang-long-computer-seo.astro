---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MetricCard from "../../components/ui/MetricCard.astro";

const seoProblems = [
  {
    num: '01',
    title: 'Information Architecture & Technical Scalability',
    shortLabel: 'Technical & Architecture',
    severity: 'Foundation',
    shortDesc: 'Hệ thống e-commerce có nhiều Category, Product, Blog, landing page và công cụ Build PC với phạm vi search intent gần nhau, làm tăng nguy cơ phân tán authority và Google lựa chọn sai URL.',
    moduleDesc: 'Kiểm soát kiến trúc URL, indexation và landing page cho hệ thống e-commerce nhiều tầng.',
    impact: 'Nếu Information Architecture, canonical, indexation và query–landing page alignment không được kiểm soát, ranking có thể phân tán giữa nhiều URL và các commercial landing page khó tích lũy đủ authority.',
    response: 'Audit crawl/index, rà soát canonical và URL structure, xác định landing page chính theo search intent, đồng thời xây internal linking theo mô hình hub–cluster.',
    tags: ['Information Architecture', 'Crawl / Index', 'Query–Landing Page', 'Internal Linking']
  },
  {
    num: '02',
    title: 'Commercial Search Expansion',
    shortLabel: 'Commercial Growth',
    severity: 'Growth Priority',
    shortDesc: 'Website cần mở rộng độ phủ ở các nhóm truy vấn mua PC, Build PC, linh kiện và thiết bị công nghệ mà vẫn duy trì hiệu suất của những nhóm từ khóa đang có vị trí.',
    moduleDesc: 'Mở rộng độ phủ commercial search mà vẫn duy trì hiệu suất của nhóm từ khóa hiện có.',
    impact: 'Nếu chỉ tối ưu từng keyword riêng lẻ, website khó mở rộng độ phủ theo cụm nhu cầu, dễ phân tán nguồn lực và không tạo được hệ thống commercial landing page có khả năng scale.',
    response: 'Phân nhóm keyword theo sản phẩm, danh mục, nhu cầu sử dụng và mức ngân sách; xác định landing page phù hợp, xây commercial content cluster và ưu tiên theo business relevance.',
    tags: ['Commercial Search', 'Keyword Clustering', 'Category SEO', 'Build PC']
  },
  {
    num: '03',
    title: 'Product Lifecycle & Business Relevance',
    shortLabel: 'Business Relevance',
    severity: 'Business Constraint',
    shortDesc: 'Ngành PC và linh kiện thay đổi nhanh theo thế hệ CPU/GPU, tồn kho và định hướng kinh doanh; một số sản phẩm hoặc URL trong bộ từ khóa ban đầu không còn được duy trì.',
    moduleDesc: 'Thích ứng với vòng đời sản phẩm, tồn kho và các URL không còn business relevance.',
    impact: 'Ranking của các truy vấn liên quan có thể giảm khi landing page không còn sản phẩm phù hợp hoặc không còn nằm trong phạm vi kinh doanh, dù hiệu suất tổng thể của bộ từ khóa vẫn đạt KPI.',
    response: 'Theo dõi song song ranking và trạng thái business relevance, ưu tiên nhóm sản phẩm còn kinh doanh, điều chỉnh landing page và minh bạch các từ khóa không còn phù hợp với danh mục hiện tại.',
    tags: ['Product Lifecycle', 'Inventory', 'Business Relevance', 'URL Status']
  },
  {
    num: '04',
    title: 'Search Visibility & GEO Measurement',
    shortLabel: 'Measurement System',
    severity: 'Measurement Gap',
    shortDesc: 'Ranking và impressions tăng nhanh hơn clicks và sessions, trong khi hiệu quả dự án còn cần được đánh giá qua chất lượng Organic Search, hành vi thương mại và traffic từ AI assistants.',
    moduleDesc: 'Đo lường đồng thời Search Visibility, Organic Quality, Commercial Actions và AI Traffic.',
    impact: 'Nếu chỉ theo dõi ranking hoặc traffic tổng, báo cáo sẽ không phản ánh đầy đủ khả năng SEO đưa người dùng tới commercial landing page, tạo hành vi mua hàng hoặc mở rộng Search Visibility sang AI Search.',
    response: 'Kết hợp SERProbot, Google Search Console, GA4 và Looker Studio để theo dõi ranking, impressions, CTR, engagement, commercial actions và AI Assistant Traffic.',
    tags: ['Search Visibility', 'Organic Quality', 'Commercial Actions', 'AI Assistant Traffic']
  }
] as const;

const rankingWinsGroups = [
  {
    label: 'PC & BUILD PC',
    topics: [
      { title: 'Build PC', src: '/images/case-studies/hoang-long/Screenshot-build-pc.jpg' },
      { title: 'PC Gaming', src: '/images/case-studies/hoang-long/Screenshot-pc-gaming.jpg' },
      { title: 'Bộ PC Gaming', src: '/images/case-studies/hoang-long/Screenshot-bo-pc-gaming.jpg' },
      { title: 'PC Văn phòng', src: '/images/case-studies/hoang-long/Screenshot-pc-van-phong.jpg' },
      { title: 'PC Đồ họa', src: '/images/case-studies/hoang-long/Screenshot_pc-do-hoa.jpg' },
      { title: 'PC Giả lập', src: '/images/case-studies/hoang-long/Screenshot_pc-gia-lap.jpg' },
    ],
  },
  {
    label: 'GPU',
    topics: [
      { title: 'RTX 3060', src: '/images/case-studies/hoang-long/Screenshot-rtx-3060.jpg' },
      { title: 'RTX 2060 Super', src: '/images/case-studies/hoang-long/Screenshot-rtx-2060-super.jpg' },
    ],
  },
  {
    label: 'MONITOR',
    topics: [
      { title: 'Màn hình máy tính 27 inch', src: '/images/case-studies/hoang-long/Screenshot_man-hinh-may-tinh-27-inch.jpg' },
    ],
  },
] as const;

const resultGroups = [
  {
    id: "result-ranking",
    index: "01",
    title: "Ranking Performance",
    category: "SEO PERFORMANCE",
    insight: "Ranking là lớp nền của Search Performance, cần được đọc cùng Organic Visibility, clicks và mức độ mở rộng truy vấn.",
    source: "Theo dõi từ khóa nội bộ / SERProbot",
    insights: [
      { label: "Nền tảng hiệu suất", html: "Phân bố ranking cho thấy website duy trì hiện diện trên các truy vấn chiến lược, tạo nền tảng để mở rộng Organic Visibility." },
      { label: "Độ phủ tìm kiếm", html: "Ranking cần được đánh giá cùng impressions, clicks và query footprint, thay vì xem Top 3 hoặc Top 10 như kết quả độc lập." },
      { label: "Ưu tiên tiếp theo", html: "Tách bộ từ khóa duy trì và thúc đẩy giúp phân bổ nguồn lực theo độ trưởng thành và theo dõi cơ hội tăng trưởng rõ hơn." },
    ],
  },
  {
    id: "result-visibility",
    index: "02",
    title: "Search Visibility",
    category: "SEARCH VISIBILITY",
    insight: "Organic Visibility mở rộng đáng kể, vị trí trung bình cải thiện và click duy trì tương đối ổn định khi website xuất hiện trên nhiều truy vấn hơn.",
    source: "Google Search Console",
    insights: [
      { label: "Insight", html: "Organic Visibility mở rộng nhanh hơn click growth." },
      { label: "Landing page đại diện", html: "<code>/buildpc</code> cho thấy commercial landing page có thể mở rộng query coverage và chuyển thêm visibility thành organic visits trong cùng giai đoạn tối ưu hệ thống." },
      { label: "Cơ hội tiếp theo", html: "Ưu tiên query có impressions cao nhưng CTR thấp, đồng thời cải thiện title, description và vị trí của các truy vấn mới xuất hiện." },
    ],
  },
  {
    id: "result-organic",
    index: "03",
    title: "Organic Quality",
    category: "ORGANIC QUALITY",
    insight: "Organic Traffic duy trì chất lượng tương tác cao ở quy mô lớn.",
    source: "Google Analytics 4",
    insights: [
      { label: "Traffic Quality", html: "Organic Traffic duy trì chất lượng tương tác cao ở quy mô lớn, cho thấy người dùng tiếp tục khám phá sau khi truy cập." },
      { label: "User Engagement", html: "Hành vi trên phiên phản ánh mức độ quan tâm thực chất, thay vì truy cập ngắn và rời đi ngay." },
      { label: "Content Relevance", html: "Tín hiệu tương tác củng cố mức độ phù hợp giữa nội dung website và nhu cầu tìm kiếm của người dùng." },
    ],
  },
  {
    id: "result-commercial",
    index: "04",
    title: "Commercial Signals",
    category: "COMMERCIAL SIGNALS",
    insight: "Organic Search ghi nhận các hành động thể hiện ý định thương mại, cho thấy người dùng tiếp tục đi sâu hơn sau khi truy cập.",
    source: "Google Analytics 4",
    insights: [
      { label: "Commercial Intent", html: "Organic Search ghi nhận các hành động thể hiện ý định thương mại, cho thấy người dùng tiếp tục đi sâu hơn sau khi truy cập." },
      { label: "Purchase Journey", html: "Người dùng organic tiếp tục tiến sâu hơn trong hành trình mua hàng sau giai đoạn khám phá." },
      { label: "Business Impact", html: "Các commercial signals cho thấy người dùng Organic Search tiếp tục tiến sâu hơn trong hành trình thương mại." },
    ],
  },
  {
    id: "result-ai",
    index: "05",
    title: "AI Referral Growth",
    category: "AI REFERRAL GROWTH",
    insight: "Sau khi GEO Operating System V2 được triển khai, AI referral traffic thiết lập baseline theo tuần cao hơn.",
    source: "AI Referral: GA4 + Looker Studio · Weekly baseline: AI referral pivot dataset",
    insights: [
      { label: "Insight", html: "AI Referral thiết lập mặt bằng traffic theo tuần cao hơn sau khi hệ thống được rollout." },
      { label: "Cách đọc dữ liệu", html: "Đây là weekly average và so sánh quan sát trước–sau, không phải kiểm định quan hệ nhân quả." },
      { label: "Giới hạn attribution", html: "Ranking, content growth, brand demand và mức độ phổ biến của AI assistants cũng có thể ảnh hưởng kết quả." },
    ],
  },
  {
    id: "result-aio",
    index: "06",
    title: "AI Overview Visibility",
    category: "AI OVERVIEW VISIBILITY",
    insight: "Việc triển khai checklist, semantic framework, retrieval structure, technical readiness và QA phục vụ đồng thời GEO và AIO. Dữ liệu Semrush cho thấy độ phủ trên tập truy vấn AI Overview mở rộng trong cùng giai đoạn triển khai, nhưng được trình bày như một xu hướng quan sát thay vì bằng chứng nhân quả tuyệt đối.",
    source: "Semrush · Organic Rankings · Bộ lọc AIO · 30/07/2026",
  },
] as const;

const totalResultGroups = String(resultGroups.length).padStart(2, '0');

---
<BaseLayout 
  title="Hoàng Long Computer SEO & GEO Case Study | TruThrive"
  description="Case study SEO/GEO Hoàng Long Computer: quản trị KPI ranking, mở rộng Search Visibility, tăng trưởng Build PC và Product Search, cải thiện chất lượng Organic Search và đo lường traffic từ AI assistants."
>
  <!-- 1. Hero / Case Intro -->
  <section class="section hero-section">
    <div class="container">
      <div class="section-heading text-center" style="max-width: 840px; margin-left: auto; margin-right: auto; margin-bottom: 20px;">
      <span class="pill" style="margin-bottom: 16px;">SEO Case Studies</span>
        <h1 class="hero-title" style="margin-bottom: 8px;">Hoàng Long Computer</h1>
        <p class="hero-subtitle" style="font-size: 1.2rem; font-weight: 500; color: var(--text-primary); margin-bottom: 20px; opacity: 0.78;">E-commerce SEO, Commercial Search & GEO Growth</p>
        <p class="hero-description" style="margin-left: auto; margin-right: auto; max-width: 610px; margin-bottom: 12px;">
          Quản trị chiến lược SEO/GEO cho website thương mại điện tử ngành PC và linh kiện, tập trung vào KPI ranking, Search Visibility, commercial landing pages và traffic từ AI assistants.
        </p>

        <!-- Hero result hook -->
        <div class="hero-result-hook" style="display: flex; justify-content: center; margin-top: 8px;">
          <span class="hook-pill">
            <svg class="hook-pill-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path d="M3 14.5 7.25 10l3 2.75L17 5.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M12.75 5.5H17v4.25" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            Ranking → Commercial Search → GEO
          </span>
        </div>
      </div>

      <!-- 2. Snapshot / Project Brief -->
      <div class="case-snapshot">
        <img
          src="/images/logos/hoang-long-logo.png"
          alt=""
          class="case-snapshot-watermark"
          aria-hidden="true"
          draggable="false"
        />
        <span class="snapshot-section-label">TỔNG QUAN DỰ ÁN</span>
        <div class="case-snapshot-top">
          <!-- Column 1: Client -->
          <div class="snapshot-col col-client">
            <div class="snapshot-heading">
              <svg class="snapshot-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <rect x="3" y="4" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5"></rect>
                <path d="M7 8h6M7 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
              <span class="snapshot-label">Client</span>
            </div>
            <div class="client-info">
              <div class="client-logo-frame">
                <img 
                  src="/images/logos/hoang-long-logo.png" 
                  alt="Hoàng Long Computer Logo" 
                  class="client-logo" 
                />
              </div>
              <span class="snapshot-value">hoanglongcomputer.vn</span>
            </div>
          </div>
          
          <!-- Column 2: Timeline -->
          <div class="snapshot-col col-timeline">
            <div class="snapshot-heading">
              <svg class="snapshot-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"></circle>
                <path d="M10 6v4l2.75 1.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span class="snapshot-label">Timeline</span>
            </div>
            <div class="snapshot-value-group">
              <span class="snapshot-value">2025–2026 · Ongoing</span>
              <span class="snapshot-subvalue snapshot-subvalue-lines">
                <span>GEO MVP V1: 01/05/2025</span>
                <span>GEO Operating System V2: 01/03/2026</span>
              </span>
            </div>
          </div>
          
          <!-- Column 3: Industry -->
          <div class="snapshot-col col-industry">
            <div class="snapshot-heading">
              <svg class="snapshot-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M3.5 16.5h13M5 16.5V7.25l5-3.75 5 3.75v9.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M8 16.5v-4h4v4M8 8.5h.01M12 8.5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
              <span class="snapshot-label">Ngành</span>
            </div>
            <div class="snapshot-value-group">
              <span class="snapshot-value">E-commerce ngành máy tính</span>
              <span class="snapshot-subvalue snapshot-subvalue-lines">
                <span>PC / Gaming PC</span>
                <span>Computer Hardware</span>
              </span>
            </div>
          </div>
          
          <!-- Column 4: Role -->
          <div class="snapshot-col col-role">
            <div class="snapshot-heading">
              <svg class="snapshot-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <circle cx="10" cy="6.25" r="2.75" stroke="currentColor" stroke-width="1.5"></circle>
                <path d="M4.5 16c.5-3 2.45-4.5 5.5-4.5s5 1.5 5.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
              <span class="snapshot-label">Vai trò</span>
            </div>
            <div class="snapshot-value-group">
              <span class="snapshot-value">SEO Project Owner · Senior SEO Specialist</span>
              <span class="snapshot-subvalue snapshot-subvalue-lines">
                <span>Strategy · KPI Ownership · Roadmap · Execution Coordination</span>
                <span>Technical SEO · Content &amp; AI System Builder · AI Search Readiness</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Key Results Row -->
        <div class="case-snapshot-results">
          <span class="snapshot-label">KẾT QUẢ CHÍNH</span>
          <div class="case-snapshot-results-grid">
            <div class="case-snapshot-result-item">
              <svg class="snapshot-result-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <circle cx="12" cy="8" r="4.5" stroke="currentColor" stroke-width="1.7"></circle>
                <path d="m8.7 11.2-1 9 4.3-2.5 4.3 2.5-1-9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="m10.2 8 1.2 1.2L14 6.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <strong class="snapshot-result-metric" data-snapshot-counter data-target="70" data-decimals="0" data-suffix="%" data-decimal-separator="," aria-label="70%">70%</strong>
              <span class="snapshot-result-label">Top 3 Ranking</span>
              <span class="snapshot-result-caption">Bộ từ khóa duy trì</span>
            </div>
            <div class="case-snapshot-result-item">
              <svg class="snapshot-result-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 17 9 12l3.5 3.5L20 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M15 8h5v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <strong class="snapshot-result-metric" data-snapshot-counter data-target="8.84" data-decimals="2" data-suffix="M" data-decimal-separator="." aria-label="8.84M">8.84M</strong>
              <span class="snapshot-result-label">Organic Impressions</span>
              <span class="snapshot-result-caption">27/01/2026–26/07/2026</span>
            </div>
            <div class="case-snapshot-result-item">
              <svg class="snapshot-result-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.7"></rect>
                <path d="M8 21h8M12 17v4M7 8h5M7 11h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
              </svg>
              <strong class="snapshot-result-metric" data-snapshot-counter data-target="15.881" data-decimals="3" data-decimal-separator="." aria-label="15.881">15.881</strong>
              <span class="snapshot-result-label">/buildpc Clicks</span>
              <span class="snapshot-result-caption">27/01/2026–26/07/2026</span>
            </div>
            <div class="case-snapshot-result-item">
              <svg class="snapshot-result-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M12 3.5 13.4 8l4.6 1.4-4.6 1.4L12 15.5l-1.4-4.7L6 9.4 10.6 8 12 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
                <path d="m18.5 15 .7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7.7-2.3ZM5 14l.6 1.8 1.9.6-1.9.6-.6 1.9-.6-1.9-1.9-.6 1.9-.6L5 14Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
              </svg>
              <strong class="snapshot-result-metric" data-snapshot-counter data-target="307" data-decimals="0" data-prefix="≈" aria-label="Khoảng 307">≈307</strong>
              <span class="snapshot-result-label">AI Referral Sessions / tuần</span>
              <span class="snapshot-result-caption">Sau GEO Operating System V2</span>
            </div>
          </div>
        </div>

        <!-- Scope Row -->
        <div class="case-snapshot-bottom">
          <span class="snapshot-label">PHẠM VI DỰ ÁN</span>
          <div class="snapshot-chips">
            <span class="snapshot-chip">E-commerce SEO</span>
            <span class="snapshot-chip">Technical SEO</span>
            <span class="snapshot-chip">Content Strategy</span>
            <span class="snapshot-chip">Commercial SEO</span>
            <span class="snapshot-chip">GEO / AI Search</span>
            <span class="snapshot-chip">Analytics & Event Tracking</span>
          </div>
        </div>
      </div>

      <div class="btn-group center" style="margin-top: 40px;">
        <a href="#results" class="btn btn-primary">Xem kết quả</a>
        <a href="#insights" class="btn btn-secondary">Bài học rút ra</a>
      </div>
    </div>
  </section>

  <!-- 3. Project Context -->
  <section class="section">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">BỐI CẢNH DỰ ÁN</p>
        <h2 class="section-title">Bối cảnh và hướng tiếp cận</h2>
      </div>
      <div class="hl-context-block card" style="max-width: 900px; margin: 40px auto 0;">
