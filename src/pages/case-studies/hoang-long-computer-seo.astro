  .cs-strategy-thesis-card { max-width: none; margin: 18px 0 0; padding: 18px 22px; border: 1px solid rgba(193, 18, 31, .12); border-top: 2px solid rgba(193, 18, 31, .48); border-radius: 10px; background: rgba(193, 18, 31, .03); }
