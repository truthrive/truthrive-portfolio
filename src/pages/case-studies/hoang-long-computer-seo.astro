  }

  .visibility-headline-metric.is-direction span {
    max-width: 12ch;
  }

  .visibility-headline-metric span {
    display: block;
    margin-top: 8px;
    color: var(--color-muted-text);
    font-size: 0.68rem;
    font-weight: 550;
    line-height: 1.35;
  }

  .visibility-media-caption {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 22px;
    color: var(--color-muted-text);
