  .problems-panels-stack {
    display: grid;
    grid-template-areas: "stack";
    width: 100%;
    height: 100%;
  }

  .problems-panel-content {
    grid-area: stack;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
    transform: translateY(8px);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .problems-panel-content.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    z-index: 2;
  }

  .problems-modules {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .problems-accordion-item {
    display: flex;
    flex-direction: column;
  }

  .problems-module {
    display: block;
    width: 100%;
    text-align: left;
    background: #ffffff;
    border: 1px solid rgba(193, 18, 31, 0.08);
    border-radius: var(--radius-md);
    padding: 14px 20px;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
    transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    box-shadow: none;
    outline: none;
    position: relative;
    padding-right: 40px;
    overflow: hidden;
  }

  .problems-module::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background-color: var(--color-accent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .problems-module:hover {
    background: #FAF9F6;
    border-color: rgba(193, 18, 31, 0.2);
    box-shadow: 0 4px 12px rgba(193, 18, 31, 0.04);
    transform: translateY(-2px);
  }

  .problems-module.is-active {
    background: rgba(193, 18, 31, 0.02);
    border-color: rgba(193, 18, 31, 0.18);
    box-shadow: 0 4px 16px rgba(193, 18, 31, 0.04);
    transform: translateY(-1px);
  }

  .problems-module.is-active::before {
    opacity: 1;
  }

  .problems-module::after {
    content: "→";
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%) translateX(-4px);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-muted-text);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease, color 0.25s ease;
  }

  .problems-module:hover::after,
  .problems-module:focus-visible::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
    color: var(--color-accent);
  }

  .problems-module.is-active::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
    color: var(--color-accent);
  }

  .problems-module__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }

  .problems-num {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--color-accent);
    background: rgba(193, 18, 31, 0.05);
    padding: 2px 8px;
    border-radius: 99px;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 20px;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .problems-module.is-active .problems-num {
    background: var(--color-accent);
    color: #ffffff;
  }

  .problems-module__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    line-height: 1.25;
  }

  .problems-module__outcome {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-muted-text);
    margin: 0 0 6px 0;
  }

  .problems-module__label {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    color: rgba(193, 18, 31, 0.85);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4px;
  }

  .problems-module:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 1023.98px) {
    .desktop-panel-only {
      display: none !important;
    }

    .problems-module.is-active::after {
      content: "↓";
    }

    .problems-module.is-active {
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }

    .problems-mobile-panel {
      display: none;
      padding: 16px 20px 20px;
      background: var(--color-card);
      border: 1px solid rgba(193, 18, 31, 0.15);
      border-top: none;
      border-left: 4px solid var(--color-accent);
      border-radius: 0 0 var(--radius-md) var(--radius-md);
      margin-top: -1px;
      z-index: 1;
      box-shadow: 0 8px 24px rgba(193, 18, 31, 0.02);
    }

    .problems-mobile-panel.is-active {
      display: block;
      animation: hlAccordionSlideDown 0.2s ease-out forwards;
    }
