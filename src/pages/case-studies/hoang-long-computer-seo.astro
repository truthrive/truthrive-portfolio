<script>
  import "../../scripts/interactions.js";

  document.addEventListener('DOMContentLoaded', () => {
    const snapshotCounters = document.querySelectorAll<HTMLElement>('[data-snapshot-counter]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const geoLightbox = document.querySelector<HTMLElement>('[data-geo-lightbox]');
    const geoLightboxImage = geoLightbox?.querySelector<HTMLImageElement>('[data-geo-lightbox-image]');
    const geoLightboxClose = geoLightbox?.querySelector<HTMLButtonElement>('.geo-os-lightbox-close');
    const geoLightboxTitle = geoLightbox?.querySelector<HTMLElement>('[data-geo-lightbox-title]');
    const geoLightboxCaption = geoLightbox?.querySelector<HTMLElement>('[data-geo-lightbox-caption]');
    const geoEvidenceTriggers = document.querySelectorAll<HTMLButtonElement>('[data-geo-evidence-zoom]');
    let geoLightboxTrigger: HTMLButtonElement | null = null;

    const closeGeoLightbox = () => {
      if (!geoLightbox || geoLightbox.hidden) return;
      geoLightbox.hidden = true;
      document.body.classList.remove('geo-os-lightbox-open');
      geoLightboxTrigger?.focus();
      geoLightboxTrigger = null;
    };

    if (geoLightbox && geoLightboxImage && geoLightboxClose) {
      geoEvidenceTriggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const sourceImage = trigger.querySelector<HTMLImageElement>('img');
          if (!sourceImage?.currentSrc) return;

          geoLightboxTrigger = trigger;
          geoLightboxImage.src = sourceImage.currentSrc;
          geoLightboxImage.alt = sourceImage.alt;
          if (geoLightboxTitle) geoLightboxTitle.textContent = trigger.dataset.geoLightboxTitle || 'Bản phóng to của biểu đồ bằng chứng';
          if (geoLightboxCaption) geoLightboxCaption.textContent = trigger.dataset.geoLightboxCaption || trigger.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || '';
          geoLightbox.hidden = false;
          document.body.classList.add('geo-os-lightbox-open');
          geoLightboxClose.focus();
        });
      });

      geoLightbox.querySelectorAll<HTMLElement>('[data-geo-lightbox-close]').forEach((control) => {
        control.addEventListener('click', closeGeoLightbox);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !geoLightbox.hidden) closeGeoLightbox();
      });
    }

    const rankingWinsModal = document.querySelector<HTMLElement>('[data-ranking-wins-modal]');
    const rankingWinsOpen = document.querySelector<HTMLButtonElement>('[data-ranking-wins-open]');
    const rankingWinsClose = rankingWinsModal?.querySelector<HTMLButtonElement>('.ranking-wins-close');
    const rankingWinsTopics = Array.from(rankingWinsModal?.querySelectorAll<HTMLButtonElement>('[data-ranking-wins-topic]') || []);
    const rankingWinsTitle = rankingWinsModal?.querySelector<HTMLElement>('[data-ranking-wins-title]');
    const rankingWinsImage = rankingWinsModal?.querySelector<HTMLImageElement>('[data-ranking-wins-image]');
    const rankingWinsCounter = rankingWinsModal?.querySelector<HTMLElement>('[data-ranking-wins-counter]');
    let rankingWinsTrigger: HTMLButtonElement | null = null;
    let rankingWinsFadeTimer: number | undefined;

    const closeRankingWinsModal = () => {
      if (!rankingWinsModal || rankingWinsModal.hidden) return;
      rankingWinsModal.hidden = true;
      document.body.classList.remove('ranking-wins-modal-open');
      rankingWinsTrigger?.focus();
      rankingWinsTrigger = null;
    };

    const setRankingWinsTopic = (topic: HTMLButtonElement) => {
      if (!rankingWinsTitle || !rankingWinsImage) return;
      const title = topic.dataset.rankingTitle;
      const source = topic.dataset.rankingSrc;
      if (!title || !source) return;

      rankingWinsTopics.forEach((item) => {
        const isActive = item === topic;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });
      rankingWinsTitle.textContent = title;
      const currentPosition = rankingWinsTopics.indexOf(topic) + 1;
      if (rankingWinsCounter) {
        rankingWinsCounter.textContent = `${currentPosition} / ${rankingWinsTopics.length}`;
        rankingWinsCounter.setAttribute('aria-label', `Ảnh bằng chứng ${currentPosition} trên ${rankingWinsTopics.length}`);
      }

      window.clearTimeout(rankingWinsFadeTimer);
      const updateImage = () => {
        rankingWinsImage.src = source;
        rankingWinsImage.alt = `Screenshot Google Search cho topic ${title} trong dự án Hoàng Long Computer`;
        rankingWinsImage.classList.remove('is-switching');
      };

      if (rankingWinsModal && !rankingWinsModal.hidden && !prefersReducedMotion) {
        rankingWinsImage.classList.add('is-switching');
        rankingWinsFadeTimer = window.setTimeout(updateImage, 140);
      } else {
        updateImage();
      }
    };

    if (rankingWinsModal && rankingWinsOpen && rankingWinsClose && rankingWinsTitle && rankingWinsImage) {
      rankingWinsOpen.addEventListener('click', () => {
        rankingWinsTrigger = rankingWinsOpen;
        const defaultTopic = rankingWinsTopics[0];
        if (defaultTopic) setRankingWinsTopic(defaultTopic);
        rankingWinsModal.hidden = false;
        document.body.classList.add('ranking-wins-modal-open');
        rankingWinsClose.focus();
      });

      rankingWinsTopics.forEach((topic) => {
        topic.addEventListener('click', () => setRankingWinsTopic(topic));
      });

      rankingWinsModal.querySelectorAll<HTMLElement>('[data-ranking-wins-close]').forEach((control) => {
        control.addEventListener('click', closeRankingWinsModal);
      });

      document.addEventListener('keydown', (event) => {
        if (rankingWinsModal.hidden) return;
        if (event.key === 'Escape') {
          closeRankingWinsModal();
          return;
        }
        if (event.key !== 'Tab') return;

        const focusable = Array.from(rankingWinsModal.querySelectorAll<HTMLElement>('button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])'));
        const firstFocusable = focusable[0];
        const lastFocusable = focusable[focusable.length - 1];
        if (!firstFocusable || !lastFocusable) return;

        if (event.shiftKey && document.activeElement === firstFocusable) {
          event.preventDefault();
          lastFocusable.focus();
        } else if (!event.shiftKey && document.activeElement === lastFocusable) {
          event.preventDefault();
          firstFocusable.focus();
        }
      });
    }

    const formatSnapshotMetric = (element: HTMLElement, value: number) => {
      const decimals = Number(element.dataset.decimals || '0');
      const prefix = element.dataset.prefix || '';
      const suffix = element.dataset.suffix || '';
      const decimalSeparator = element.dataset.decimalSeparator || '.';
      const formattedValue = value.toFixed(decimals).replace('.', decimalSeparator);
      return `${prefix}${formattedValue}${suffix}`;
    };

    if (snapshotCounters.length && !prefersReducedMotion && 'IntersectionObserver' in window) {
      snapshotCounters.forEach((metric) => {
        metric.textContent = formatSnapshotMetric(metric, 0);
      });

      const counterObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const metric = entry.target as HTMLElement;
          const target = Number(metric.dataset.target || '0');
          const duration = 1250;
          const startTime = performance.now();

          const updateCounter = (currentTime: number) => {
            const progress = Math.min((currentTime - startTime) / duration, 1);
            const easedProgress = 1 - Math.pow(1 - progress, 3);
            metric.textContent = formatSnapshotMetric(metric, target * easedProgress);

            if (progress < 1) {
              window.requestAnimationFrame(updateCounter);
            } else {
              metric.textContent = formatSnapshotMetric(metric, target);
            }
          };

          window.requestAnimationFrame(updateCounter);
          observer.unobserve(metric);
        });
      }, { threshold: 0.35 });

      snapshotCounters.forEach((metric) => counterObserver.observe(metric));
    }

    const resultsStory = document.querySelector<HTMLElement>('[data-results-story]');
    if (resultsStory) {
      const resultSteps = Array.from(resultsStory.querySelectorAll<HTMLElement>('[data-result-step]'));
      const progressButtons = Array.from(resultsStory.querySelectorAll<HTMLButtonElement>('[data-result-target]'));
      const currentIndex = resultsStory.querySelector<HTMLElement>('[data-results-current-index]');
      const currentCategory = resultsStory.querySelector<HTMLElement>('[data-results-current-category]');
      const currentTitle = resultsStory.querySelector<HTMLElement>('[data-results-current-title]');
      const insightCurrent = resultsStory.querySelector<HTMLElement>('.results-insight-current');
      let activeResultId = '';
      let insightTransitionTimer: number | undefined;

      const updateInsightContent = (activeStep: HTMLElement) => {
        if (currentIndex) currentIndex.textContent = activeStep.dataset.resultIndex || '';
        if (currentCategory) currentCategory.textContent = activeStep.dataset.resultCategory || '';
        if (currentTitle) currentTitle.textContent = activeStep.dataset.resultTitle || '';
      };

      const updateActiveResult = (activeStep: HTMLElement) => {
        const activeIndex = resultSteps.indexOf(activeStep);

        resultSteps.forEach((step) => {
          step.classList.toggle('is-active', step === activeStep);
        });

        progressButtons.forEach((button, index) => {
          const item = button.closest('li');
          const isActive = button.dataset.resultTarget === activeStep.id;
          item?.classList.toggle('is-active', isActive);
          item?.classList.toggle('is-complete', index < activeIndex);

          if (isActive) {
            button.setAttribute('aria-current', 'step');
          } else {
            button.removeAttribute('aria-current');
          }
        });

        const shouldTransition = activeResultId !== '' && activeResultId !== activeStep.id && !prefersReducedMotion;
        activeResultId = activeStep.id;
        window.clearTimeout(insightTransitionTimer);

        if (shouldTransition && insightCurrent) {
          insightCurrent.classList.add('is-updating');
          insightTransitionTimer = window.setTimeout(() => {
            updateInsightContent(activeStep);
            insightCurrent.classList.remove('is-updating');
          }, 60);
        } else {
          updateInsightContent(activeStep);
          insightCurrent?.classList.remove('is-updating');
        }
      };

      progressButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.dataset.resultTarget;
          const targetStep = targetId ? document.getElementById(targetId) : null;
          if (!targetStep) return;

          updateActiveResult(targetStep);
          targetStep.scrollIntoView({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            block: 'center',
          });
        });
      });

      if (resultSteps.length && 'IntersectionObserver' in window) {
        resultsStory.classList.add('is-enhanced');

        const resultObserver = new IntersectionObserver((entries) => {
          const visibleEntry = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (visibleEntry) updateActiveResult(visibleEntry.target as HTMLElement);
        }, {
          rootMargin: '-18% 0px -42% 0px',
          threshold: [0.15, 0.35, 0.55],
        });

        resultSteps.forEach((step) => resultObserver.observe(step));
      }

      if (resultSteps[0]) updateActiveResult(resultSteps[0]);
    }

    const hlProblemsSection = document.querySelector('#hl-problems-section');
    if (hlProblemsSection) {
      const tabButtons = hlProblemsSection.querySelectorAll('.problems-module');
      const tabPanels = hlProblemsSection.querySelectorAll('.problems-panel-content');
      const mobilePanels = hlProblemsSection.querySelectorAll('.problems-mobile-panel');

      const isMobileQuery = window.matchMedia('(max-width: 1023.98px)');
      const isMobile = () => isMobileQuery.matches;

      let currentActiveId: string | null = 'hl-problem-panel-01';

      const updateActiveState = (activePanelId: string | null) => {
        const activeNum = activePanelId ? activePanelId.replace('hl-problems-mobile-panel-', '').replace('hl-problem-panel-', '') : null;

        tabButtons.forEach(btn => {
          const num = btn.getAttribute('data-problem-id');
          const isActive = activeNum === num;

          btn.setAttribute('aria-expanded', isActive ? 'true' : 'false');
          if (isActive) {
            btn.classList.add('is-active');
          } else {
            btn.classList.remove('is-active');
          }
        });

        tabPanels.forEach(panel => {
          const num = panel.id.replace('hl-problem-panel-', '');
          const isActive = activeNum === num;
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          if (isActive) {
            panel.classList.add('is-active');
          } else {
            panel.classList.remove('is-active');
          }
        });

        mobilePanels.forEach(panel => {
          const num = panel.id.replace('hl-problems-mobile-panel-', '');
          const isActive = activeNum === num;
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          if (isActive) {
            panel.classList.add('is-active');
          } else {
            panel.classList.remove('is-active');
          }
        });
      };

      updateActiveState(currentActiveId);

      isMobileQuery.addEventListener('change', () => {
        if (!isMobile() && !currentActiveId) {
          currentActiveId = 'hl-problem-panel-01';
        }
        updateActiveState(currentActiveId);
      });

      tabButtons.forEach(btn => {
        const num = btn.getAttribute('data-problem-id');

        btn.addEventListener('pointerenter', () => {
          if (isMobile()) return;

          currentActiveId = `hl-problem-panel-${num}`;
          updateActiveState(currentActiveId);
        });

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const isMobileView = isMobile();
          const isActive = btn.classList.contains('is-active');

          if (isMobileView) {
            if (isActive) {
              currentActiveId = null;
              updateActiveState(null);
            } else {
              currentActiveId = `hl-problems-mobile-panel-${num}`;
              updateActiveState(currentActiveId);
            }
          } else {
            currentActiveId = `hl-problem-panel-${num}`;
            updateActiveState(currentActiveId);
          }
        });
      });
    }
  });
</script>
</BaseLayout>

