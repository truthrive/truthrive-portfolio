            <div class="geo-os-outcome-metrics" aria-label="So sánh Organic Search trong Phase 1">
              <div><svg class="geo-os-outcome-metric-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19V10m5 9V5m5 14v-7m5 7V8M3 19h18"></path></svg><span>Organic Sessions</span><strong>56,208 → 61,137</strong><em>+8.77%</em></div>
