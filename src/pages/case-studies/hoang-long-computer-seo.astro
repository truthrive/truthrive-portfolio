  :global(body.ranking-wins-modal-open) {
    overflow: hidden;
  }

  .visibility-headline-metric:nth-child(2) strong {
    color: var(--color-text);
    font-size: clamp(1.35rem, 2.5vw, 2.05rem);
  }

  .visibility-headline-metric.is-previous {
    background: rgba(247, 244, 240, 0.46);
  }

  .visibility-headline-metric.is-previous strong {
    color: var(--color-muted-text);
    font-weight: 700;
  }

  .visibility-headline-metric.is-current {
    border-left: 2px solid var(--color-accent);
