    min-width: 0;
    flex-direction: column;
    overflow: auto;
    padding: 20px clamp(20px, 2.4vw, 26px);
  }

  .ranking-wins-evidence-heading h3 {
    margin: 8px 0 0;
    color: var(--color-text);
    font-size: clamp(1.05rem, 2vw, 1.32rem);
    line-height: 1.3;
  }

  .ranking-wins-evidence-heading {
    position: relative;
    padding-right: 50px;
  }

  .ranking-wins-evidence-heading small {
    position: absolute;
    top: 0;
    right: 0;
    color: var(--color-muted-text);
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .ranking-wins-image-canvas {
