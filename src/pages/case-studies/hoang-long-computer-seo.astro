  .ranking-wins-modal-header {
    display: flex;
    flex: 0 0 auto;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 24px clamp(28px, 3vw, 32px) 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .ranking-wins-modal-header p,
  .ranking-wins-modal-header h2,
  .ranking-wins-modal-header span {
    display: block;
    margin: 0;
  }

  .ranking-wins-modal-header p,
  .ranking-wins-evidence-heading > span,
  .ranking-wins-group h3 {
    color: var(--color-accent);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ranking-wins-modal-header h2 {
    margin-top: 4px;
    color: var(--color-text);
    font-size: clamp(1.25rem, 2.6vw, 1.72rem);
    line-height: 1.2;
  }

  .ranking-wins-modal-header span {
    margin-top: 5px;
    color: var(--color-muted-text);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .ranking-wins-close {
    display: grid;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    place-items: center;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    cursor: pointer;
  }

  .ranking-wins-close svg {
    width: 18px;
    height: 18px;
  }

  .ranking-wins-close:hover {
    border-color: rgba(193, 18, 31, 0.32);
    background: rgba(193, 18, 31, 0.045);
    color: var(--color-accent);
  }

  .ranking-wins-modal-body {
    display: grid;
    min-height: 0;
    grid-template-columns: minmax(220px, 0.4fr) minmax(0, 1fr);
  }

  .ranking-wins-nav {
    min-width: 0;
    overflow: auto;
    padding: 20px;
    border-right: 1px solid var(--color-border);
    background: rgba(247, 244, 240, 0.48);
  }

  .ranking-wins-group + .ranking-wins-group {
    margin-top: 22px;
  }

  .ranking-wins-group h3 {
    margin: 0 0 8px;
  }

  .ranking-wins-group > div {
    display: grid;
    gap: 7px;
  }

  .ranking-wins-topic {
    width: 100%;
    min-width: 0;
    position: relative;
    min-height: 44px;
    padding: 8px 10px 8px 13px;
    color: var(--color-text);
    background: #fff;
    border: 1px solid rgba(216, 207, 196, 0.78);
    border-radius: 8px;
    cursor: pointer;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 650;
    line-height: 1.35;
    text-align: left;
  }

  .ranking-wins-topic:hover {
    border-color: rgba(193, 18, 31, 0.3);
    background: rgba(193, 18, 31, 0.045);
  }

  .ranking-wins-topic.is-active {
    border-color: rgba(216, 207, 196, 0.9);
    color: var(--color-accent);
    background: rgba(193, 18, 31, 0.055);
