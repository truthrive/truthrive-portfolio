<script>
  import "../../scripts/interactions.js";

  // Hoàng Long Computer — Interactive SERP/Wins Board Panel logic
  document.addEventListener('DOMContentLoaded', () => {
    const keywordItems = document.querySelectorAll('.ranking-keyword-item');
    const activeKwName = document.getElementById('hl-active-kw-name');
    const activeKwBadge = document.getElementById('hl-active-kw-badge');
    const serpImage = document.getElementById('hl-serp-proof-image') as HTMLImageElement;
    const serpPlaceholder = document.getElementById('hl-serp-proof-placeholder');
    const serpCaption = document.getElementById('hl-serp-proof-caption');

    if (!keywordItems.length || !serpImage || !serpPlaceholder) return;

    // Handle image loading error to show custom placeholder
    serpImage.addEventListener('error', () => {
      serpImage.style.display = 'none';
      serpPlaceholder.style.display = 'flex';
    });

    serpImage.addEventListener('load', () => {
      if (serpImage.getAttribute('src') === '#' || !serpImage.getAttribute('src')) {
        serpImage.style.display = 'none';
        serpPlaceholder.style.display = 'flex';
      } else {
        serpImage.style.display = 'block';
        serpPlaceholder.style.display = 'none';
      }
    });

    // Initial check
    if (serpImage.complete) {
      if (serpImage.naturalWidth === 0 || serpImage.getAttribute('src') === '#') {
        serpImage.style.display = 'none';
        serpPlaceholder.style.display = 'flex';
      }
    }

    keywordItems.forEach(item => {
      item.addEventListener('click', () => {
        keywordItems.forEach(i => i.classList.remove('is-active'));
        item.classList.add('is-active');

        const name = item.getAttribute('data-keyword') || '';
        const rank = item.getAttribute('data-rank') || '';
        const imgUrl = item.getAttribute('data-image') || '#';
        const caption = item.getAttribute('data-caption') || '';

        serpImage.style.display = 'block';
        serpPlaceholder.style.display = 'none';
        serpImage.style.opacity = '0';
        
        setTimeout(() => {
          if (activeKwName) activeKwName.textContent = name;
          if (activeKwBadge) {
            activeKwBadge.textContent = rank;
            activeKwBadge.className = 'keyword-rank-badge';
            if (rank === 'Commercial Intent') {
              activeKwBadge.classList.add('rank-commercial');
            } else if (rank === 'Product Keyword') {
              activeKwBadge.classList.add('rank-product');
            } else if (rank === 'Phase 2 Keyword') {
              activeKwBadge.classList.add('rank-phase2');
            } else {
              activeKwBadge.classList.add('rank-tracked');
            }
          }

          serpImage.setAttribute('src', imgUrl);
          serpImage.setAttribute('alt', `Keyword tracking: ${name}`);
          if (serpCaption) serpCaption.textContent = caption;
          
          serpImage.style.opacity = '1';
        }, 150);
      });
    });

    // Hoàng Long — Line Chart Tab Toggle Logic
    const chartTabs = document.querySelectorAll('.hl-chart-tab');
    chartTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        chartTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const tabType = tab.getAttribute('data-tab');

        // Toggle lines
        document.querySelectorAll('.hl-chart-line-group').forEach(group => {
          if (group.classList.contains(`hl-lines-${tabType}`)) {
            group.classList.add('active');
          } else {
            group.classList.remove('active');
          }
        });
      });
    });

    // Hoàng Long — Line Chart Premium Tooltip Logic
    const tooltip = document.getElementById('hl-chart-tooltip');
    const chartPoints = document.querySelectorAll('.chart-points circle');
    
    if (chartPoints.length && tooltip) {
      chartPoints.forEach(point => {
        point.addEventListener('mouseenter', () => {
          const month = point.getAttribute('data-month');
          const series = point.getAttribute('data-series');
          const val = point.getAttribute('data-value');
          
          if (month && series && val) {
            tooltip.innerHTML = `<strong>${month}</strong>${series}: ${val}`;
            tooltip.style.display = 'block';
          }
        });
        
        point.addEventListener('mousemove', (e) => {
          const container = document.querySelector('.svg-chart-container');
          if (container) {
            const rect = container.getBoundingClientRect();
            const x = e.clientX - rect.left + 12;
            const y = e.clientY - rect.top - 36;
            
            tooltip.style.left = `${x}px`;
            tooltip.style.top = `${y}px`;
          }
        });
        
        point.addEventListener('mouseleave', () => {
          tooltip.style.display = 'none';
        });
      });
    }

    // Hoàng Long — Donut Chart Tab Toggle Logic
    const donutTabs = document.querySelectorAll('.hl-donut-tab');
    const donutChart = document.getElementById('hl-donut-chart');
    const donutCenterVal = document.getElementById('hl-donut-center-val');
    const donutLegendVal1 = document.getElementById('hl-donut-legend-val-1');
    const donutLegendVal2 = document.getElementById('hl-donut-legend-val-2');
    const donutLegendVal3 = document.getElementById('hl-donut-legend-val-3');
    const donutLegendVal4 = document.getElementById('hl-donut-legend-val-4');

    if (donutTabs.length && donutChart && donutCenterVal && donutLegendVal1) {
      donutTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          donutTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');

          const donutType = tab.getAttribute('data-donut-tab');
          if (donutType === 'maintenance') {
            donutChart.style.background = 'conic-gradient(var(--color-accent) 0% 67%, var(--color-text) 67% 73%, var(--color-muted-text) 73% 77%, var(--color-border) 77% 100%)';
            donutCenterVal.textContent = '77%';
            donutLegendVal1.textContent = '67%';
            donutLegendVal2.textContent = '6%';
            donutLegendVal3.textContent = '4%';
            donutLegendVal4.textContent = '23%';
          } else {
            donutChart.style.background = 'conic-gradient(var(--color-accent) 0% 32%, var(--color-text) 32% 38%, var(--color-muted-text) 38% 55%, var(--color-border) 55% 100%)';
            donutCenterVal.textContent = '55%';
            donutLegendVal1.textContent = '32%';
            donutLegendVal2.textContent = '6%';
            donutLegendVal3.textContent = '17%';
            donutLegendVal4.textContent = '45%';
          }
        });
      });
    }

    // Hoàng Long — Interactive SEO Problems Section logic (scoped)
    const hlProblemsSection = document.querySelector('#hl-problems-section');
    if (hlProblemsSection) {
      const tabButtons = hlProblemsSection.querySelectorAll('.problems-module');
      const tabPanels = hlProblemsSection.querySelectorAll('.problems-panel-content');
      const mobilePanels = hlProblemsSection.querySelectorAll('.problems-mobile-panel');

      const isMobileQuery = window.matchMedia('(max-width: 1023.98px)');
      const isMobile = () => isMobileQuery.matches;

      let currentActiveId: string | null = 'hl-problem-panel-01';

      const updateActiveState = (activePanelId: string | null) => {
        const activeNum = activePanelId ? activePanelId.replace('hl-problems-mobile-panel-', '').replace('hl-problem-panel-', '') : null;

        tabButtons.forEach(btn => {
          const num = btn.getAttribute('data-problem-id');
          const isActive = activeNum === num;

          btn.setAttribute('aria-expanded', isActive ? 'true' : 'false');
          if (isActive) {
            btn.classList.add('is-active');
          } else {
            btn.classList.remove('is-active');
          }
        });

        tabPanels.forEach(panel => {
          const num = panel.id.replace('hl-problem-panel-', '');
          const isActive = activeNum === num;
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          if (isActive) {
            panel.classList.add('is-active');
          } else {
            panel.classList.remove('is-active');
          }
        });

        mobilePanels.forEach(panel => {
          const num = panel.id.replace('hl-problems-mobile-panel-', '');
          const isActive = activeNum === num;
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          if (isActive) {
            panel.classList.add('is-active');
          } else {
            panel.classList.remove('is-active');
          }
        });
      };

      updateActiveState(currentActiveId);

      isMobileQuery.addEventListener('change', () => {
        if (!isMobile() && !currentActiveId) {
          currentActiveId = 'hl-problem-panel-01';
        }
        updateActiveState(currentActiveId);
      });

      tabButtons.forEach(btn => {
        const num = btn.getAttribute('data-problem-id');

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const isMobileView = isMobile();
          const isActive = btn.classList.contains('is-active');

          if (isMobileView) {
            if (isActive) {
              currentActiveId = null;
              updateActiveState(null);
            } else {
              currentActiveId = `hl-problems-mobile-panel-${num}`;
              updateActiveState(currentActiveId);
            }
          } else {
            currentActiveId = `hl-problem-panel-${num}`;
            updateActiveState(currentActiveId);
          }
        });
      });
    }
  });
</script>
</BaseLayout>

