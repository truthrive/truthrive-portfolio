---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidenceCard from "../../components/ui/EvidenceCard.astro";
import MetricCard from "../../components/ui/MetricCard.astro";

const seoProblems = [
  {
    num: '01',
    title: 'Technical foundation & CMS limitation',
    shortLabel: 'Technical Recovery',
    severity: 'Critical',
    shortDesc: 'Website sử dụng CMS code tay và gặp nhiều lỗi technical quan trọng, khiến việc xử lý crawl, index, canonical, schema và các hạng mục hỗ trợ SEO gặp giới hạn.',
    impact: 'Technical issues làm chậm tốc độ phục hồi ranking, ảnh hưởng crawl/index và khiến Google cần thêm thời gian để đánh giá lại các tín hiệu tích cực.',
    response: 'Audit technical foundation, ưu tiên xử lý canonical/indexing, kiểm soát URL và phối hợp kỹ thuật để cải thiện nền tảng SEO có khả năng scale.',
    tags: ['Crawl/index', 'Canonical', 'CMS limitation']
  },
  {
    num: '02',
    title: 'Thin content / Panda risk',
    shortLabel: 'Content Quality',
    severity: 'High priority',
    shortDesc: 'Website có nhiều nội dung mỏng, chất lượng thấp hoặc chưa đáp ứng đủ intent người dùng, tạo rủi ro bị đánh giá thấp về chất lượng nội dung.',
    impact: 'Content quality yếu có thể kéo giảm hiệu suất toàn site, làm traffic thiếu ổn định và hạn chế khả năng cạnh tranh ở nhóm keyword thương mại.',
    response: 'Audit content, xác định nhóm cần giữ / tối ưu / loại bỏ / làm mới, đồng thời xây content strategy theo nhóm sản phẩm và search intent.',
    tags: ['Thin content', 'Panda risk', 'Content audit']
  },
  {
    num: '03',
    title: 'Backlink spam & authority risk',
    shortLabel: 'Backlink Risk',
    severity: 'High priority',
    shortDesc: 'Website ghi nhận lượng backlink spam/kém chất lượng, có thể làm giảm độ tin cậy và ảnh hưởng đến khả năng phục hồi SEO.',
    impact: 'Backlink không tự nhiên khiến authority signal bị nhiễu, làm quá trình phục hồi ranking cần nhiều thời gian hơn.',
    response: 'Audit backlink profile, xác định nhóm link rủi ro, triển khai hướng xử lý/disavow phù hợp và theo dõi tác động sau khi Google đánh giá lại.',
    tags: ['Backlink spam', 'Authority', 'Disavow']
  },
  {
    num: '04',
    title: 'Commercial keyword scalability',
    shortLabel: 'Growth Scaling',
    severity: 'Growth blocker',
    shortDesc: 'Các nhóm keyword thương mại như PC gaming, bộ PC, PC văn phòng, VGA/RTX/GTX, màn hình và PC đồ họa cần được gom cụm, ưu tiên và tối ưu theo intent chuyển đổi.',
    impact: 'Nếu chỉ tối ưu từng keyword riêng lẻ, website khó mở rộng độ phủ ranking và khó chuyển traffic thành hành vi mua hàng.',
    response: 'Chia nhóm keyword theo sản phẩm/danh mục, xây roadmap SEO theo cụm commercial intent, tối ưu product/category SEO và internal linking để tăng khả năng scale.',
    tags: ['Commercial intent', 'Keyword clustering', 'Product SEO']
  }
] as const;

const evidenceCards = [
  {
    title: "Phase 1 Ranking KPI Snapshot",
    sourceLabel: "Rank Tracker",
    imageSrc: "#",
    placeholder: "Thêm ảnh chụp KPI ranking Phase 1",
    alt: "Bảng KPI ranking Phase 1 của dự án Hoàng Long Computer",
    caption: "Phase 1 ranking KPI: Top 3 đạt 232%, Top 5 đạt 151% so với KPI cam kết.",
    insights: [
      "Top 3 và Top 5 vượt KPI mạnh, cho thấy chiến lược tập trung nhóm keyword chuyển đổi hiệu quả.",
      "Top 10 đạt 89% — cần thêm thời gian để nhóm keyword rộng hơn cải thiện vị trí.",
    ]
  },
  {
    title: "Phase 2 Month 6 KPI Snapshot",
    sourceLabel: "Rank Tracker",
    imageSrc: "#",
    placeholder: "Thêm ảnh chụp KPI ranking Phase 2 — Month 6",
    alt: "Bảng KPI ranking Phase 2 Month 6 của dự án Hoàng Long Computer",
    caption: "Bộ từ khóa duy trì: 67% Top 3 (vượt KPI 45%). Bộ từ khóa thúc đẩy: 32% Top 3 (vượt KPI 15%).",
    insights: [
      "Track duy trì đã vượt KPI cuối ở cả Top 3 và Top 5 tại Month 6.",
      "Track thúc đẩy đang tích lũy — Top 10 cần thêm nửa sau dự án để scale.",
    ]
  },
  {
    title: "Organic Search Cumulative Snapshot",
    sourceLabel: "GA4",
    imageSrc: "#",
    placeholder: "Thêm ảnh chụp Organic Search sessions tích lũy",
    alt: "Biểu đồ Organic Search sessions tích lũy của dự án Hoàng Long Computer",
    caption: "Tính từ thời điểm tiếp nhận dự án đến hiện tại, Organic Search ghi nhận 980.965 sessions tích lũy.",
    insights: [
      "Organic Search sessions phản ánh lưu lượng truy cập tìm kiếm tự nhiên tích lũy tính từ thời điểm tiếp nhận dự án đến hiện tại.",
      "Số liệu được đo lường nhất quán theo báo cáo GA4 / Looker Studio chính thức.",
    ]
  },
  {
    title: "AI Chats Traffic Snapshot",
    sourceLabel: "GA4",
    imageSrc: "#",
    placeholder: "Thêm ảnh chụp AI Chats sessions",
    alt: "Biểu đồ AI Chats sessions của dự án Hoàng Long Computer",
    caption: "AI Chats ghi nhận thêm 15.302 sessions trong cùng giai đoạn đo lường.",
    insights: [
      "AI Chats sessions phản ánh khả năng mở rộng Search Visibility sang các nền tảng AI Search.",
      "Được theo dõi độc lập với kênh Organic Search truyền thống.",
    ]
  },
  {
    title: "Commercial Intent Tracking Snapshot",
    sourceLabel: "GA4",
    imageSrc: "#",
    placeholder: "Thêm ảnh chụp commercial intent tracking",
    alt: "Bảng commercial intent tracking của dự án Hoàng Long Computer",
    caption: "15,3K hành động thể hiện ý định thương mại bao gồm add_to_cart, begin_checkout, click_phone, form_submit.",
    insights: [
      "Đánh giá chất lượng người dùng và ý định mua hàng thực tế thay vì chỉ đo lường lượt xem trang thô.",
      "Cấu hình đo lường các hành vi thương mại cốt lõi trên website e-commerce.",
    ]
  },
  {
    title: "PC Gaming / PC Văn phòng Ranking Snapshot",
    sourceLabel: "Rank Tracker",
    imageSrc: "#",
    placeholder: "Thêm ảnh chụp ranking nhóm PC gaming / PC văn phòng",
    alt: "Bảng ranking nhóm keyword PC gaming và PC văn phòng của Hoàng Long Computer",
    caption: "Nhóm keyword thương mại trọng tâm: PC gaming, bộ PC, PC văn phòng, PC đồ họa.",
    insights: [
      "Các nhóm keyword commercial intent được ưu tiên tối ưu product/category SEO.",
      "Ranking được tracking riêng để đánh giá khả năng chuyển đổi từ search traffic.",
    ]
  }
];
---
<BaseLayout 
  title="Case Study SEO Hoàng Long Computer | TruThrive" 
  description="Case study SEO Hoàng Long Computer: phục hồi nền SEO cho website e-commerce công nghệ và mở rộng sang hợp đồng 12 tháng với KPI ranking, traffic tích lũy, AI/GEO traffic và conversion tracking."
>
  <!-- 1. Hero / Case Intro -->
  <section class="section hero-section">
    <div class="container">
      <div class="section-heading text-center" style="max-width: 840px; margin-left: auto; margin-right: auto; margin-bottom: 32px;">
      <span class="pill" style="margin-bottom: 16px;">SEO Case Studies</span>
        <h1 class="hero-title" style="margin-bottom: 8px;">Hoàng Long Computer</h1>
        <p class="hero-subtitle" style="font-size: 1.25rem; font-weight: 500; color: var(--text-primary); margin-bottom: 24px; opacity: 0.9;">E-commerce SEO Recovery & Scaling Partnership</p>
        <p class="hero-description" style="margin-left: auto; margin-right: auto; max-width: 640px; margin-bottom: 20px;">
          Phục hồi nền tảng SEO e-commerce và mở rộng hợp đồng đối tác chiến lược 12 tháng với bộ KPI toàn diện.
        </p>
        <div class="chip-group" style="justify-content: center; margin-bottom: 24px; margin-top: 16px;">
          <span class="chip">E-commerce SEO</span>
          <span class="chip">Technical Recovery</span>
          <span class="chip">KPI Planning</span>
          <span class="chip">GEO / AI Tracking</span>
        </div>
        
        <!-- Hero result hook -->
        <div class="hero-result-hook" style="display: flex; justify-content: center; margin-top: 16px;">
          <span class="hook-pill">Recovery → Renewal → Scaling</span>
        </div>

        <!-- Result pills -->
        <div class="hl-result-pills">
          <span class="hl-result-pill">Renewed 12-month partnership</span>
          <span class="hl-result-pill">67% Top 3 maintenance keywords</span>
          <span class="hl-result-pill">980.965 Organic Search sessions tích lũy</span>
        </div>
      </div>

      <!-- 2. Snapshot / Project Brief -->
      <div class="case-snapshot">
        <div class="case-snapshot-top">
          <!-- Column 1: Client -->
          <div class="snapshot-col col-client">
            <span class="snapshot-label">Client</span>
            <div class="client-info">
              <div class="client-logo-frame">
                <img 
                  src="/images/logos/hoang-long-logo.png" 
                  alt="Hoàng Long Computer Logo" 
                  class="client-logo" 
                />
              </div>
              <span class="snapshot-value">hoanglongcomputer.vn</span>
            </div>
          </div>
          
          <!-- Column 2: Timeline -->
          <div class="snapshot-col col-timeline">
            <span class="snapshot-label">Timeline</span>
            <div class="snapshot-value-group">
              <span class="snapshot-value">Phase 1: 02/2025 – 09/2025</span>
              <span class="snapshot-subvalue">Phase 2: 12/11/2025 – ongoing</span>
            </div>
          </div>
          
          <!-- Column 3: Industry -->
          <div class="snapshot-col col-industry">
            <span class="snapshot-label">Ngành</span>
            <div class="snapshot-value-group">
              <span class="snapshot-value">E-commerce Technology</span>
              <span class="snapshot-subvalue">PC / Gaming PC / Computer Hardware</span>
            </div>
          </div>
          
          <!-- Column 4: Role -->
          <div class="snapshot-col col-role">
            <span class="snapshot-label">Vai trò</span>
            <div class="snapshot-value-group">
              <span class="snapshot-value">SEO Project Leader</span>
              <span class="snapshot-subvalue">KPI Planning · Technical Audit · Content Strategy · SEO Roadmap</span>
            </div>
          </div>
        </div>

        <!-- Scope Row -->
        <div class="case-snapshot-bottom">
          <span class="snapshot-label">Phạm vi triển khai</span>
          <div class="snapshot-chips">
            <span class="snapshot-chip">E-commerce SEO</span>
            <span class="snapshot-chip">Technical Recovery</span>
            <span class="snapshot-chip">KPI Planning</span>
            <span class="snapshot-chip">Content Strategy</span>
            <span class="snapshot-chip">Product / Category SEO</span>
            <span class="snapshot-chip">Internal Linking</span>
            <span class="snapshot-chip">GEO / AI Tracking</span>
            <span class="snapshot-chip">Conversion Tracking</span>
          </div>
        </div>
      </div>

      <div class="btn-group center" style="margin-top: 40px;">
        <a href="#results" class="btn btn-primary">Xem kết quả</a>
        <a href="#insights" class="btn btn-secondary">Bài học rút ra</a>
      </div>
    </div>
  </section>

  <!-- 3. Project Context -->
  <section class="section">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">BỐI CẢNH DỰ ÁN</p>
        <h2 class="section-title">Bối cảnh và hướng tiếp cận</h2>
      </div>
      <div class="hl-context-block card" style="max-width: 900px; margin: 40px auto 0;">
        <p class="hl-context-text">
          Hoàng Long Computer không chỉ cần tăng traffic, mà cần phục hồi nền SEO cho một website e-commerce công nghệ có nhiều biến động: technical issues, thin content risk, backlink spam, CMS limitation và tác động từ Google updates. Sau giai đoạn nghiệm thu ban đầu, dự án tiếp tục được mở rộng thành hợp đồng SEO 12 tháng với KPI ranking, traffic tích lũy, AI/GEO traffic và conversion tracking.
        </p>
        <div class="hl-context-highlights">
          <div class="hl-context-highlight-item">
            <span class="hl-highlight-label">Phase 1</span>
            <span class="hl-highlight-value">Recovery & KPI Validation — phục hồi ranking, validate hướng SEO, cải thiện chất lượng traffic và conversion signals.</span>
          </div>
          <div class="hl-context-highlight-item">
            <span class="hl-highlight-label">Phase 2</span>
            <span class="hl-highlight-value">Scaling Partnership — hợp đồng 12 tháng mới từ 12/11/2025, mở rộng phạm vi SEO sang two-track ranking KPI, traffic tích lũy, AI/GEO traffic và conversion event tracking.</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- 7. My Role -->
  <section class="section section-muted">
    <div class="container">
      <div class="cs-role-card card" style="max-width: 900px; margin: 0 auto;">
        <div class="cs-role-header">
          <p class="section-kicker">VAI TRÒ CỦA TÔI</p>
          <h2 class="section-title" style="font-size: 1.8rem;">SEO Project Leader</h2>
          <p class="cs-role-subtitle" style="font-weight: 700; color: var(--color-accent); margin-top: -8px; margin-bottom: 16px; font-size: 1.05rem;">KPI Planning · Technical Audit · Content Strategy · SEO Roadmap</p>
        </div>
        <p class="cs-role-desc">
          Trong dự án này, tôi đảm nhiệm vai trò SEO Project Leader, phụ trách định hướng SEO tổng thể: hoạch định KPI, xây chiến lược SEO, audit technical, content strategy, keyword/product/category SEO direction và theo dõi hiệu suất triển khai. Tôi phối hợp với các bộ phận content, technical và account/reporting để đảm bảo output bám sát roadmap và KPI đã hoạch định.
        </p>
        <div class="cs-role-tags">
          <span class="cs-role-tag">KPI Planning</span>
          <span class="cs-role-tag">SEO Strategy</span>
          <span class="cs-role-tag">Technical Audit</span>
          <span class="cs-role-tag">Content Strategy</span>
          <span class="cs-role-tag">Product / Category SEO</span>
          <span class="cs-role-tag">Internal Linking</span>
          <span class="cs-role-tag">Performance Monitoring</span>
          <span class="cs-role-tag">Strategic Adjustment</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Core SEO Problems -->
  <section id="hl-problems-section" class="section section-muted">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">VẤN ĐỀ CẦN GIẢI QUYẾT</p>
        <h2 class="section-title">4 vấn đề SEO cốt lõi</h2>
        <p class="section-subtitle">Những rủi ro cần xử lý đúng ưu tiên để phục hồi và mở rộng hiệu suất SEO.</p>
      </div>

      <div class="problems-layout">
        <!-- Left Column: Interactive Modules -->
        <div class="problems-modules">
          {seoProblems.map((prob, index) => {
            const isActive = index === 0;
            return (
              <div class="problems-accordion-item">
                <button 
                  id={`hl-problem-btn-${prob.num}`}
                  class={`problems-module ${isActive ? 'is-active' : ''}`}
                  aria-expanded={isActive ? "true" : "false"}
                  aria-controls={`hl-problems-mobile-panel-${prob.num}`}
                  data-problem-id={prob.num}
                >
                  <div class="problems-module__header">
                    <span class="problems-num">{prob.num}</span>
                    <h4 class="problems-module__title">{prob.title}</h4>
                  </div>
                  <p class="problems-module__outcome">{prob.shortDesc}</p>
                  <span class="problems-module__label">{prob.shortLabel}</span>
                </button>
                
                <!-- Mobile accordion inline detail panel -->
                <div 
                  id={`hl-problems-mobile-panel-${prob.num}`}
                  class={`problems-mobile-panel ${isActive ? 'is-active' : ''}`}
                  aria-hidden={isActive ? "false" : "true"}
                  role="region"
                  aria-labelledby={`hl-problem-btn-${prob.num}`}
                >
                  <div class="problems-mobile-panel-header">
                    <span class="severity-badge">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="warning-icon"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                      {prob.severity}
                    </span>
                  </div>

                  <div class="problems-detail-section">
                    <h4 class="problems-section-title">Mô tả vấn đề:</h4>
                    <p class="problems-panel-desc">{prob.shortDesc}</p>
                  </div>

                  <div class="problem-outcome-stack">
                    <div class="problem-impact">
                      <h4>Hậu quả & Tác động (Impact)</h4>
                      <p>{prob.impact}</p>
                    </div>

                    <div class="problem-response">
                      <h4>Giải pháp xử lý (Response)</h4>
                      <p>{prob.response}</p>
                    </div>
                  </div>

                  {prob.tags && prob.tags.length > 0 && (
                    <div class="case-problem-card__tags" style="margin-top: 16px;">
                      {prob.tags.map(tag => (
                        <span class="case-problem-card__tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Right Column: Desktop active detail panel -->
        <div class="card problems-detail-panel desktop-panel-only">
          <span class="problems-detail-eyebrow">Thông tin chi tiết</span>
          
          <div class="problems-panels-stack">
            {seoProblems.map((prob, index) => {
              const isActive = index === 0;
              return (
                <div 
                  id={`hl-problem-panel-${prob.num}`}
                  class={`problems-panel-content ${isActive ? 'is-active' : ''}`}
                  role="region"
                  aria-labelledby={`hl-problem-btn-${prob.num}`}
                  aria-hidden={isActive ? "false" : "true"}
                >
                  <div class="problems-panel-header">
                    <div class="problems-panel-title-group">
                      <span class="problems-panel-num">{prob.num}</span>
                      <h3 class="problems-panel-title">{prob.title}</h3>
                    </div>
                    <span class="severity-badge">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="warning-icon"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                      {prob.severity}
                    </span>
                  </div>

                  <div class="problems-detail-section">
                    <h4 class="problems-section-title">Mô tả vấn đề:</h4>
                    <p class="problems-panel-desc">{prob.shortDesc}</p>
                  </div>

                  <div class="problem-outcome-stack">
                    <div class="problem-impact">
                      <h4>Hậu quả & Tác động (Impact)</h4>
                      <p>{prob.impact}</p>
                    </div>

                    <div class="problem-response">
                      <h4>Giải pháp xử lý (Response)</h4>
                      <p>{prob.response}</p>
                    </div>
                  </div>

                  {prob.tags && prob.tags.length > 0 && (
                    <div class="case-problem-card__tags" style="margin-top: 20px;">
                      {prob.tags.map(tag => (
                        <span class="case-problem-card__tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Search Demand Map -->
  <section class="section">
    <div class="container" style="max-width: 1120px;">
      <div class="section-heading text-center">
        <p class="section-kicker">SEARCH DEMAND MAP</p>
        <h2 class="section-title">Bản đồ nhu cầu tìm kiếm thương mại</h2>
        <p class="section-subtitle">Dự án được chia theo các nhóm demand có khả năng tạo traffic và chuyển đổi khác nhau, từ nhóm build PC tổng quan đến nhóm sản phẩm VGA/GPU và màn hình.</p>
      </div>

      <div class="cs-demand-map-grid">
        <!-- Card 1 -->
        <article class="card cs-demand-card">
          <div class="demand-header">
            <span class="demand-intent-badge">Commercial / Category Intent</span>
            <h3>PC / Build PC Demand</h3>
          </div>
          <p class="demand-desc">Nhóm truy vấn thể hiện nhu cầu tìm cấu hình, build máy và lựa chọn bộ PC theo mục đích sử dụng.</p>
          <div class="demand-topics">
            <span class="demand-topic-title">Cụm chủ đề ưu tiên</span>
            <div class="demand-topic-chips">
              <span class="chip chip-outline">PC gaming</span>
              <span class="chip chip-outline">bộ PC</span>
              <span class="chip chip-outline">PC văn phòng</span>
              <span class="chip chip-outline">PC đồ họa</span>
            </div>
          </div>
        </article>

        <!-- Card 2 -->
        <article class="card cs-demand-card">
          <div class="demand-header">
            <span class="demand-intent-badge">Product / Transactional Intent</span>
            <h3>GPU / VGA Commercial Demand</h3>
          </div>
