  .problems-mobile-panel .problem-impact p,
  .problems-mobile-panel .problem-response p {
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .problems-panels-stack {
    display: grid;
    grid-template-areas: "stack";
    width: 100%;
    height: 100%;
  }

  .problems-panel-content {
    grid-area: stack;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
    transform: translateY(8px);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .problems-panel-content.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    z-index: 2;
  }

  /* Left Column Modules (Selector Cards) */
  .problems-modules {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .problems-accordion-item {
    display: flex;
    flex-direction: column;
  }

  .problems-module {
    display: block;
    width: 100%;
    text-align: left;
    background: #ffffff;
    border: 1px solid rgba(193, 18, 31, 0.08);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
    transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    box-shadow: none;
    outline: none;
    position: relative;
    padding-right: 40px;
    overflow: hidden; /* Ensure pseudo-element stays within rounded borders */
  }

  .problems-module::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background-color: var(--color-accent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .problems-module:hover {
    background: #FAF9F6;
    border-color: rgba(193, 18, 31, 0.2);
    box-shadow: 0 4px 12px rgba(193, 18, 31, 0.04);
    transform: translateY(-2px);
  }

  /* Active state with red left border rail and soft red/ivory background tint */
  .problems-module.is-active {
    background: rgba(193, 18, 31, 0.02);
    border-color: rgba(193, 18, 31, 0.18);
    box-shadow: 0 4px 16px rgba(193, 18, 31, 0.04);
    transform: translateY(-1px);
  }

  .problems-module.is-active::before {
    opacity: 1;
  }

  /* Arrow indicator (points right on desktop, down on mobile when active) */
  .problems-module::after {
    content: "→";
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%) translateX(-4px);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-muted-text);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease, color 0.25s ease;
  }

  .problems-module:hover::after,
  .problems-module:focus-visible::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
    color: var(--color-accent);
  }

  .problems-module.is-active::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
    color: var(--color-accent);
  }

  .problems-module__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .problems-num {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--color-accent);
    background: rgba(193, 18, 31, 0.05);
    padding: 2px 8px;
    border-radius: 99px;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 20px;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .problems-module.is-active .problems-num {
    background: var(--color-accent);
    color: #ffffff;
  }

  .problems-module__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    line-height: 1.25;
  }

