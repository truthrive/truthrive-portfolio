    <div class="case-image-lightbox__shell">
      <div class="case-image-lightbox__header">
        <h2 id="case-image-lightbox-title" class="case-image-lightbox__title">Xem ảnh bằng chứng</h2>
        <button type="button" class="case-image-lightbox__close" aria-label="Đóng ảnh phóng to">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <figure class="case-image-lightbox__figure">
        <div class="case-image-lightbox__stage">
          <img class="case-image-lightbox__image" alt="" />
        </div>
        <figcaption class="case-image-lightbox__caption"></figcaption>
      </figure>
    </div>
  </dialog>

<script>
  import "../../scripts/interactions.js";

  // Suối Tiên case-study interactions
  document.addEventListener('DOMContentLoaded', () => {
    const snapshotCounters = document.querySelectorAll<HTMLElement>('[data-snapshot-counter]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const imageLightbox = document.getElementById('case-image-lightbox') as HTMLDialogElement | null;
    const imageLightboxImage = imageLightbox?.querySelector<HTMLImageElement>('.case-image-lightbox__image');
    const imageLightboxTitle = imageLightbox?.querySelector<HTMLElement>('.case-image-lightbox__title');
    const imageLightboxCaption = imageLightbox?.querySelector<HTMLElement>('.case-image-lightbox__caption');
    const imageLightboxClose = imageLightbox?.querySelector<HTMLButtonElement>('.case-image-lightbox__close');
    let activeImageTrigger: HTMLElement | null = null;

    const getImageContext = (trigger: HTMLElement, image: HTMLImageElement) => {
      const contentCard = trigger.closest('.evidence-card, .ai-signals-evidence-card, .serp-proof-card');
      const title = trigger.dataset.lightboxTitle || contentCard?.querySelector<HTMLElement>('.evidence-title, .serp-proof-title')?.textContent?.trim() || image.alt || 'Xem ảnh bằng chứng';
      const caption = trigger.dataset.lightboxCaption || contentCard?.querySelector<HTMLElement>('.evidence-caption, .serp-proof-caption')?.textContent?.trim() || '';
      return { title, caption };
    };

    const openImageLightbox = (trigger: HTMLElement, image: HTMLImageElement) => {
      if (!imageLightbox || !imageLightboxImage || typeof imageLightbox.showModal !== 'function') return false;

      const { title, caption } = getImageContext(trigger, image);
      activeImageTrigger = trigger;
      const linkedSource = trigger instanceof HTMLAnchorElement ? trigger.href : '';
      imageLightboxImage.src = linkedSource || image.currentSrc || image.src;
      imageLightboxImage.alt = image.alt;
      if (imageLightboxTitle) imageLightboxTitle.textContent = title;
      if (imageLightboxCaption) imageLightboxCaption.textContent = caption;
      imageLightbox.showModal();
      document.body.classList.add('case-image-lightbox-open');
      imageLightboxClose?.focus();
      return true;
    };

    if (imageLightbox && imageLightboxImage && imageLightboxClose) {
      const imageLinks = Array.from(document.querySelectorAll<HTMLElement>('.image-wrapper'))
        .map((trigger) => ({ trigger, image: trigger.querySelector<HTMLImageElement>('img') }))
        .filter((item): item is { trigger: HTMLElement; image: HTMLImageElement } => item.image instanceof HTMLImageElement);

      imageLinks.forEach(({ trigger, image }) => {
        trigger.classList.add('case-image-lightbox-trigger');
        trigger.setAttribute('aria-haspopup', 'dialog');
        trigger.setAttribute('aria-controls', 'case-image-lightbox');
        trigger.addEventListener('click', (event) => {
          if (openImageLightbox(trigger, image)) event.preventDefault();
        });
        trigger.addEventListener('keydown', (event) => {
          if (event.key !== ' ') return;
          event.preventDefault();
          openImageLightbox(trigger, image);
        });
      });

      imageLightboxClose.addEventListener('click', () => imageLightbox.close());
      imageLightbox.addEventListener('click', (event) => {
        if (event.target === imageLightbox) imageLightbox.close();
      });
      imageLightbox.addEventListener('close', () => {
        document.body.classList.remove('case-image-lightbox-open');
        imageLightboxImage.removeAttribute('src');
        activeImageTrigger?.focus();
        activeImageTrigger = null;
      });
    }

    const rankingKeywordItems = Array.from(document.querySelectorAll<HTMLElement>('.ranking-proof-layout .ranking-keyword-item'));
    const activeKwName = document.getElementById('active-kw-name');
    const activeKwBadge = document.getElementById('active-kw-badge');
    const serpProofImage = document.getElementById('serp-proof-image');
    const serpProofTrigger = document.getElementById('serp-proof-trigger');
    const serpProofCaption = document.getElementById('serp-proof-caption');
    let rankingPreviewTimer = 0;

    const updateRankingPreview = (item: HTMLElement) => {
      if (!(serpProofImage instanceof HTMLImageElement) || !(serpProofTrigger instanceof HTMLAnchorElement)) return;

      const keyword = item.dataset.keyword || '';
      const rank = item.dataset.rank || '';
      const badgeClass = item.dataset.badgeClass || 'rank-signal';
      const imageSrc = item.dataset.image || '';
      const imageAlt = item.dataset.alt || `Bằng chứng SERP cho từ khóa ${keyword} của dự án Suối Tiên`;
      const caption = item.dataset.caption || '';
      const width = item.dataset.width || '';
      const height = item.dataset.height || '';

      rankingKeywordItems.forEach((keywordItem) => {
        const isActive = keywordItem === item;
        keywordItem.classList.toggle('is-active', isActive);
        keywordItem.setAttribute('aria-pressed', String(isActive));
      });

      window.clearTimeout(rankingPreviewTimer);
      serpProofImage.style.opacity = '0';
      rankingPreviewTimer = window.setTimeout(() => {
        if (activeKwName) activeKwName.textContent = keyword;
        if (activeKwBadge) {
          activeKwBadge.textContent = rank;
          activeKwBadge.className = `keyword-rank-badge ${badgeClass}`;
        }

        serpProofTrigger.href = imageSrc;
        serpProofTrigger.dataset.lightboxTitle = keyword;
        serpProofTrigger.dataset.lightboxCaption = caption;
        serpProofImage.src = imageSrc;
        serpProofImage.alt = imageAlt;
        if (width) serpProofImage.width = Number(width);
        if (height) serpProofImage.height = Number(height);
        if (serpProofCaption) serpProofCaption.textContent = caption;
        serpProofImage.style.opacity = '1';
      }, prefersReducedMotion ? 0 : 150);
    };

    rankingKeywordItems.forEach((item) => {
      item.addEventListener('click', () => updateRankingPreview(item));
      item.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        updateRankingPreview(item);
      });
    });

    const resultsStickyColumn = document.querySelector<HTMLElement>('#results .results-sticky-column');
    if (resultsStickyColumn) {
      const desktopResultsQuery = window.matchMedia('(min-width: 1024px)');
      const stickyViewportAllowance = 128;
      let stickySafetyFrame = 0;

      const updateStickySafety = () => {
        stickySafetyFrame = 0;
        const usableViewportHeight = window.innerHeight - stickyViewportAllowance;
        const canStick = desktopResultsQuery.matches && resultsStickyColumn.scrollHeight <= usableViewportHeight;
        resultsStickyColumn.classList.toggle('can-stick', canStick);
      };

      const requestStickySafetyUpdate = () => {
        if (!stickySafetyFrame) stickySafetyFrame = window.requestAnimationFrame(updateStickySafety);
      };

      window.addEventListener('resize', requestStickySafetyUpdate, { passive: true });
      desktopResultsQuery.addEventListener('change', requestStickySafetyUpdate);
      if ('ResizeObserver' in window) {
        new ResizeObserver(requestStickySafetyUpdate).observe(resultsStickyColumn);
      }
      requestStickySafetyUpdate();
    }

    const formatSnapshotMetric = (element: HTMLElement, value: number) => {
      const decimals = Number(element.dataset.decimals || '0');
      const prefix = element.dataset.prefix || '';
      const suffix = element.dataset.suffix || '';
      const decimalSeparator = element.dataset.decimalSeparator || '.';
      const thousandsSeparator = element.dataset.thousandsSeparator || '';
      const [integerPart, decimalPart] = value.toFixed(decimals).split('.');
      const groupedInteger = thousandsSeparator
        ? integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, thousandsSeparator)
        : integerPart;
      const formattedValue = decimalPart
        ? `${groupedInteger}${decimalSeparator}${decimalPart}`
        : groupedInteger;

      return `${prefix}${formattedValue}${suffix}`;
    };

    if (snapshotCounters.length && !prefersReducedMotion && 'IntersectionObserver' in window) {
      snapshotCounters.forEach((metric) => {
        metric.textContent = formatSnapshotMetric(metric, 0);
      });

      const counterObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const metric = entry.target as HTMLElement;
          const target = Number(metric.dataset.target || '0');
          const duration = 1250;
          const startTime = performance.now();

          const updateCounter = (currentTime: number) => {
            const progress = Math.min((currentTime - startTime) / duration, 1);
            const easedProgress = 1 - Math.pow(1 - progress, 3);
            metric.textContent = formatSnapshotMetric(metric, target * easedProgress);

            if (progress < 1) {
              window.requestAnimationFrame(updateCounter);
            } else {
              metric.textContent = formatSnapshotMetric(metric, target);
            }
          };

          window.requestAnimationFrame(updateCounter);
          observer.unobserve(metric);
        });
      }, { threshold: 0.35 });

      snapshotCounters.forEach((metric) => counterObserver.observe(metric));
    }

    const parallaxRoot = document.querySelector('.suoi-parallax-root');
    if (parallaxRoot instanceof HTMLElement && !prefersReducedMotion) {
      const parallaxItems = [...parallaxRoot.querySelectorAll<HTMLElement>('[data-case-parallax]')];
      const activeParallaxItems = new Set<HTMLElement>();
      const parallaxObserver = new IntersectionObserver((entries) => {
        entries.forEach(({ target, isIntersecting }) => {
          if (!(target instanceof HTMLElement)) return;
          activeParallaxItems[isIntersecting ? 'add' : 'delete'](target);
        });
      }, { rootMargin: '20% 0px', threshold: 0 });

      parallaxItems.forEach((item) => parallaxObserver.observe(item));

      let parallaxFrame = 0;
      const updateParallax = () => {
        parallaxFrame = 0;
        const factor = window.innerWidth < 768 ? 0 : window.innerWidth < 1024 ? 0.5 : 1;

        activeParallaxItems.forEach((item) => {
          const rect = item.getBoundingClientRect();
          const progress = (rect.top + rect.height / 2 - window.innerHeight / 2) / window.innerHeight;
          const kind = item.dataset.caseParallax || 'image';
          const distance = kind === 'hero-decor' ? 12 : kind === 'hero-content' ? 5 : kind === 'metrics' ? 7 : 16;
          item.style.transform = `translate3d(0, ${Math.max(-1, Math.min(1, progress)) * distance * factor}px, 0)`;
          item.style.opacity = kind === 'hero-content' ? `${Math.min(1, 0.88 + (1 - Math.abs(progress)) * 0.12)}` : '';
        });
      };

      const requestParallaxUpdate = () => {
        if (!parallaxFrame) parallaxFrame = window.requestAnimationFrame(updateParallax);
      };

      window.addEventListener('scroll', requestParallaxUpdate, { passive: true });
      window.addEventListener('resize', requestParallaxUpdate, { passive: true });
      requestParallaxUpdate();
    }

    // Interactive SEO Problems Section logic for Suối Tiên (scoped)
    const suoiProblemsSection = document.querySelector('#suoi-problems-section');
    if (suoiProblemsSection) {
      const tabButtons = suoiProblemsSection.querySelectorAll('.problems-module');
      const tabPanels = suoiProblemsSection.querySelectorAll('.problems-panel-content');
      const mobilePanels = suoiProblemsSection.querySelectorAll('.problems-mobile-panel');

      const isMobileQuery = window.matchMedia('(max-width: 1023.98px)');
      const isMobile = () => isMobileQuery.matches;

      let currentActiveId = 'suoi-problem-panel-01'; // Default active panel ID on desktop

      const updateActiveState = (activePanelId) => {
        const activeNum = activePanelId ? activePanelId.replace('suoi-problems-mobile-panel-', '').replace('suoi-problem-panel-', '') : null;

        tabButtons.forEach(btn => {
          const num = btn.getAttribute('data-problem-id');
          const isActive = activeNum === num;

          btn.setAttribute('aria-expanded', isActive ? 'true' : 'false');
          if (isActive) {
            btn.classList.add('is-active');
          } else {
            btn.classList.remove('is-active');
          }
        });

        tabPanels.forEach(panel => {
          const num = panel.id.replace('suoi-problem-panel-', '');
          const isActive = activeNum === num;
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          if (isActive) {
            panel.classList.add('is-active');
          } else {
            panel.classList.remove('is-active');
          }
        });

        mobilePanels.forEach(panel => {
          const num = panel.id.replace('suoi-problems-mobile-panel-', '');
          const isActive = activeNum === num;
          panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          if (isActive) {
            panel.classList.add('is-active');
          } else {
            panel.classList.remove('is-active');
          }
        });
      };

      // Set initial active state
      updateActiveState(currentActiveId);

      // Listen for window resize/media changes
      isMobileQuery.addEventListener('change', () => {
        if (!isMobile() && !currentActiveId) {
          currentActiveId = 'suoi-problem-panel-01';
        }
        updateActiveState(currentActiveId);
      });

      tabButtons.forEach(btn => {
        const num = btn.getAttribute('data-problem-id');

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const isMobileView = isMobile();
          const isActive = btn.classList.contains('is-active');

          if (isMobileView) {
            if (isActive) {
              // Collapse it
              currentActiveId = null;
              updateActiveState(null);
            } else {
              // Expand it
              currentActiveId = `suoi-problems-mobile-panel-${num}`;
              updateActiveState(currentActiveId);
            }
          } else {
            // Desktop: click activates
            currentActiveId = `suoi-problem-panel-${num}`;
            updateActiveState(currentActiveId);
          }
        });
      });
    }
  });
</script>
</BaseLayout>

