  /* Mobile panel tweaks */
  .problems-mobile-panel .problem-impact,
  .problems-mobile-panel .problem-response {
    padding: 14px 16px;
  }

  .problems-mobile-panel .problem-impact h4,
  .problems-mobile-panel .problem-response h4 {
