---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatsStrip from "../../components/ui/StatsStrip.astro";
import EvidenceCard from "../../components/ui/EvidenceCard.astro";
import DonutChart from "../../components/ui/DonutChart.astro";
import TimelineChart from "../../components/ui/TimelineChart.astro";
import WorkflowScroller from "../../components/ui/WorkflowScroller.astro";
import MetricCard from "../../components/ui/MetricCard.astro";

const keyMetrics = [
  {
    value: 77,
    label: "Keyword Top 3",
    format: "integer",
    animated: true
  },
  {
    value: 94,
    label: "Keyword Top 5",
    format: "integer",
    animated: true
  },
  {
    value: 32198,
    label: "Organic sessions nghiệm thu",
    format: "thousand-dot",
    animated: true
  },
  {
    value: 100.8,
    suffix: "%",
    label: "KPI Traffic",
    format: "decimal",
    decimals: 1,
    animated: true
  }
] as const;

const trafficEvidence = [
  {
    title: "Organic traffic theo timeline triển khai",
    sourceLabel: "GA4",
    imageSrc: "/img/suoitien-traffic.jpg",
    placeholder: "Thêm ảnh GA4 organic timeline",
    alt: "Biểu đồ GA4 thể hiện organic traffic của Suối Tiên trong timeline triển khai SEO",
    caption: "Organic sessions tháng nghiệm thu đạt 32.198, vượt KPI cam kết 31.957 sessions.",
    insights: [
      "Theo dõi xu hướng organic traffic trong suốt quá trình triển khai.",
      "Đối chiếu tăng trưởng traffic với các giai đoạn technical, content và internal link.",
      "Dữ liệu có thể được làm mờ một phần trước khi public."
    ]
  },
  {
    title: "Clicks & impressions từ Google Search Console",
    sourceLabel: "GSC",
    imageSrc: "/img/suoitien-click-impression.jpg",
    placeholder: "Thêm ảnh GSC clicks & impressions",
    alt: "Biểu đồ Google Search Console thể hiện clicks và impressions của Suối Tiên trong quá trình triển khai SEO",
    caption: "Clicks và impressions giúp bổ sung góc nhìn về độ phủ tìm kiếm, không chỉ organic sessions từ GA4.",
    insights: [
      "Impressions phản ánh độ mở rộng hiện diện tìm kiếm.",
      "Clicks cho thấy khả năng chuyển đổi visibility thành traffic.",
      "Dữ liệu GSC sẽ được dùng như bằng chứng hỗ trợ cho kết quả ranking và organic traffic."
    ]
  }
];

const seoProblems = [
  {
    num: '01',
    title: 'Rủi ro sau chuyển đổi domain',
    shortLabel: 'Migration & Domain Risk',
    severity: 'Critical',
    shortDesc: 'Chuyển từ .com sang .vn có thể làm đứt tín hiệu SEO nếu redirect, schema và URL cũ không được kiểm soát.',
    impact: 'Nguy cơ mất tín hiệu ranking và sụt traffic organic nếu migration handling không chính xác.',
    response: 'Xây dựng bản đồ redirect 1:1, kiểm soát URL cũ/mới, rà soát schema và theo dõi tín hiệu index sau migration.',
    tags: ['Migration risk', 'Redirect', 'Domain signals']
  },
  {
    num: '02',
    title: 'Technical foundation chưa ổn định',
    shortLabel: 'Technical Foundation',
    severity: 'High priority',
    shortDesc: 'URL spam, sitemap thiếu, robots.txt sai cấu hình và schema chưa đồng bộ với domain mới làm nền tảng kỹ thuật thiếu ổn định.',
    impact: 'Crawl/index bị ảnh hưởng, khiến tốc độ phục hồi ranking chậm và làm giảm hiệu quả SEO tổng thể.',
    response: 'Audit technical foundation, xử lý sitemap/robots.txt, kiểm soát URL spam, chuẩn hóa schema và theo dõi crawl/index sau triển khai.',
    tags: ['Crawl/index', 'URL spam', 'Schema']
  },
  {
    num: '03',
    title: 'Non-brand keyword chưa được khai thác',
    shortLabel: 'Non-brand Growth Gap',
    severity: 'Growth blocker',
    shortDesc: 'Các nhóm keyword giá trị như team building, sự kiện, tiệc cưới chưa có cụm content SEO tương xứng.',
    impact: 'Bỏ lỡ demand ngoài brand và mất cơ hội mở rộng traffic từ nhóm người dùng mới.',
    response: 'Mở rộng topical map ngoài brand, xây cụm nội dung theo nhóm dịch vụ trọng tâm và tối ưu internal link để tăng độ phủ non-brand.',
    tags: ['Non-brand demand', 'Content gap', 'Growth']
  },
  {
    num: '04',
    title: 'Content chưa đủ sâu theo intent',
    shortLabel: 'Intent Depth',
    severity: 'High priority',
    shortDesc: 'Một số topic dịch vụ còn thiếu nội dung chuyên biệt, chưa đủ depth và trust để cạnh tranh.',
    impact: 'Khó cạnh tranh ở nhóm từ khóa thương mại và hạn chế khả năng vào Top 5 bền vững.',
    response: 'Tối ưu nội dung theo search intent, bổ sung depth cho topic dịch vụ, tăng tín hiệu trust và liên kết nội bộ đến các trang trọng tâm.',
    tags: ['Search intent', 'Content depth', 'Trust']
  }
] as const;
---
<BaseLayout 
  title="Case Study SEO Suối Tiên | TruThrive" 
  description="Case study SEO Suối Tiên: kiểm soát migration từ suoitien.com sang suoitien.vn, tối ưu Technical SEO và đạt 100,8% KPI với 32.198 Organic Sessions."
>
  <!-- 1. Hero / Case Intro -->
  <section class="section hero-section suoi-parallax-root">
    <div class="container">
      <div class="section-heading text-center" data-case-parallax="hero-content" style="max-width: 840px; margin-left: auto; margin-right: auto; margin-bottom: 20px;">
        <span class="pill" style="margin-bottom: 16px;">SEO Case Study · Domain Migration</span>
        <h1 class="hero-title" style="margin-bottom: 8px;">Suối Tiên</h1>
        <p class="hero-subtitle" style="font-size: 1.2rem; font-weight: 500; color: var(--text-primary); margin-bottom: 20px; opacity: 0.78;">Domain Migration, Technical SEO &amp; Organic Performance</p>
        <p class="hero-description" style="margin-left: auto; margin-right: auto; max-width: 610px; margin-bottom: 12px;">
          Lập kế hoạch và kiểm soát quá trình chuyển đổi website suoitien.com → suoitien.vn, tập trung bảo toàn tín hiệu SEO, hạn chế thất thoát Organic Traffic và duy trì khả năng hiển thị của website sau migration.
        </p>

        <!-- Hero result hook -->
        <div class="hero-result-hook" style="display: flex; justify-content: center; margin-top: 8px;">
          <span class="hook-pill">
            <svg class="hook-pill-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path d="M3 14.5 7.25 10l3 2.75L17 5.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M12.75 5.5H17v4.25" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            URL Mapping → Redirect Control → Post-migration Growth
          </span>
        </div>
      </div>

      <!-- 2. Snapshot / Project Brief -->
      <div class="case-snapshot">
        <img
          src="/images/logos/suoi-tien-logo.png"
          alt=""
          class="case-snapshot-watermark"
          data-case-parallax="hero-decor"
          aria-hidden="true"
          draggable="false"
        />
        <span class="snapshot-section-label">TỔNG QUAN DỰ ÁN</span>
        <div class="case-snapshot-top">
          <!-- Column 1: Client -->
          <div class="snapshot-col col-client">
            <div class="snapshot-heading">
              <svg class="snapshot-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <rect x="3" y="4" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5"></rect>
                <path d="M7 8h6M7 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
              <span class="snapshot-label">Client</span>
            </div>
            <div class="client-info">
              <div class="client-logo-frame">
                <img src="/images/logos/suoi-tien-logo.png" alt="Logo Suối Tiên" class="client-logo" />
              </div>
              <span class="snapshot-value">suoitien.vn</span>
            </div>
          </div>

          <!-- Column 2: Timeline -->
          <div class="snapshot-col col-timeline">
            <div class="snapshot-heading">
              <svg class="snapshot-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"></circle>
                <path d="M10 6v4l2.75 1.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span class="snapshot-label">Timeline</span>
            </div>
            <div class="snapshot-value-group">
              <span class="snapshot-value">SEO Domain Migration Project</span>
              <span class="snapshot-subvalue snapshot-subvalue-lines">
                <span>Pre-migration planning</span>
                <span>Post-migration monitoring</span>
              </span>
            </div>
          </div>

          <!-- Column 3: Industry -->
          <div class="snapshot-col col-industry">
            <div class="snapshot-heading">
              <svg class="snapshot-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M3.5 16.5h13M5 16.5V7.25l5-3.75 5 3.75v9.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M8 16.5v-4h4v4M8 8.5h.01M12 8.5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
              <span class="snapshot-label">Ngành</span>
            </div>
            <div class="snapshot-value-group">
              <span class="snapshot-value">Khu du lịch và giải trí</span>
              <span class="snapshot-subvalue snapshot-subvalue-lines">
                <span>Tourism &amp; Entertainment</span>
                <span>Destination Search</span>
              </span>
            </div>
          </div>

          <!-- Column 4: Role -->
          <div class="snapshot-col col-role">
            <div class="snapshot-heading">
              <svg class="snapshot-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <circle cx="10" cy="6.25" r="2.75" stroke="currentColor" stroke-width="1.5"></circle>
                <path d="M4.5 16c.5-3 2.45-4.5 5.5-4.5s5 1.5 5.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
              <span class="snapshot-label">Vai trò</span>
            </div>
            <div class="snapshot-value-group">
              <span class="snapshot-value">SEO Project Lead · Technical SEO</span>
              <span class="snapshot-subvalue snapshot-subvalue-lines">
                <span>Migration Strategy · URL Mapping · Redirect Control</span>
                <span>Indexation Monitoring · SEO Performance Tracking</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Key Results Row -->
        <div class="case-snapshot-results" data-case-parallax="metrics">
          <span class="snapshot-label">KẾT QUẢ CHÍNH</span>
          <div class="case-snapshot-results-grid">
            <div class="case-snapshot-result-item">
              <svg class="snapshot-result-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 17 9 12l3.5 3.5L20 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M15 8h5v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <strong class="snapshot-result-metric" data-snapshot-counter data-target="32198" data-decimals="0" data-thousands-separator="." aria-label="32.198 Organic Sessions">32.198</strong>
              <span class="snapshot-result-label">Organic Sessions</span>
              <span class="snapshot-result-caption">Hiệu suất Organic sau triển khai</span>
            </div>
            <div class="case-snapshot-result-item">
              <svg class="snapshot-result-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <circle cx="12" cy="8" r="4.5" stroke="currentColor" stroke-width="1.7"></circle>
                <path d="m8.7 11.2-1 9 4.3-2.5 4.3 2.5-1-9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="m10.2 8 1.2 1.2L14 6.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <strong class="snapshot-result-metric" data-snapshot-counter data-target="100.8" data-decimals="1" data-suffix="%" data-decimal-separator="," aria-label="100,8%">100,8%</strong>
              <span class="snapshot-result-label">KPI Completion</span>
              <span class="snapshot-result-caption">Hoàn thành KPI dự án</span>
            </div>
            <div class="case-snapshot-result-item">
              <svg class="snapshot-result-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.7"></rect>
                <path d="M8 21h8M12 17v4M7 8h5M7 11h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
              </svg>
              <strong class="snapshot-result-metric" data-snapshot-counter data-target="77" data-decimals="0" aria-label="77 từ khóa Top 3">77</strong>
              <span class="snapshot-result-label">Keywords Top 3</span>
              <span class="snapshot-result-caption">Bộ từ khóa mục tiêu</span>
            </div>
            <div class="case-snapshot-result-item">
              <svg class="snapshot-result-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M12 3.5 13.4 8l4.6 1.4-4.6 1.4L12 15.5l-1.4-4.7L6 9.4 10.6 8 12 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
                <path d="m18.5 15 .7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7.7-2.3ZM5 14l.6 1.8 1.9.6-1.9.6-.6 1.9-.6-1.9-1.9-.6 1.9-.6L5 14Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
              </svg>
              <strong class="snapshot-result-metric" data-snapshot-counter data-target="94" data-decimals="0" aria-label="94 từ khóa Top 5">94</strong>
              <span class="snapshot-result-label">Keywords Top 5</span>
              <span class="snapshot-result-caption">Bộ từ khóa mục tiêu</span>
            </div>
          </div>
        </div>

        <!-- Scope Row -->
        <div class="case-snapshot-bottom">
          <span class="snapshot-label">PHẠM VI DỰ ÁN</span>
          <div class="snapshot-chips">
            <span class="snapshot-chip">Domain Migration</span>
            <span class="snapshot-chip">Technical SEO</span>
            <span class="snapshot-chip">URL Mapping</span>
            <span class="snapshot-chip">Redirect Control</span>
            <span class="snapshot-chip">Indexation Monitoring</span>
            <span class="snapshot-chip">Post-migration Tracking</span>
          </div>
        </div>
      </div>

      <div class="btn-group center" style="margin-top: 40px;">
        <a href="#results" class="btn btn-primary">Xem kết quả</a>
        <a href="#migration" class="btn btn-secondary">Quy trình Migration</a>
      </div>
    </div>
  </section>

  <!-- 2. Project Context — 3 Insight Cards -->
  <section class="section">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">BỐI CẢNH DỰ ÁN</p>
        <h2 class="section-title">3 yếu tố định hình chiến lược SEO</h2>
        <p class="section-subtitle">Hiểu đúng bối cảnh giúp định hướng chiến lược triển khai phù hợp.</p>
      </div>
      <div class="cs-context-grid">
        <article class="card cs-context-card">
          <div class="cs-context-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
          </div>
          <h3 class="cs-context-title">Phụ thuộc traffic thương hiệu</h3>
          <p class="cs-context-desc">
            Khoảng 80% organic traffic đến từ các truy vấn thương hiệu Suối Tiên. Đây là cơ hội lớn để mở rộng non-brand SEO.
          </p>
        </article>
        <article class="card cs-context-card">
          <div class="cs-context-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path></svg>
          </div>
          <h3 class="cs-context-title">Tiềm năng non-brand keyword</h3>
          <p class="cs-context-desc">
            Các nhóm keyword du lịch, vui chơi, team building, tổ chức sự kiện, hội nghị và tiệc cưới chưa được khai thác đúng mức.
          </p>
        </article>
        <article class="card cs-context-card">
          <div class="cs-context-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          </div>
          <h3 class="cs-context-title">Rủi ro chuyển đổi domain</h3>
          <p class="cs-context-desc">
            Migration từ suoitien.com sang suoitien.vn đặt ra yêu cầu kiểm soát redirect, de-indexing và technical signals để bảo toàn ranking.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. My Role -->
  <section class="section section-muted">
    <div class="container">
      <div class="cs-role-card card" style="max-width: 900px; margin: 0 auto;">
        <div class="cs-role-header">
          <p class="section-kicker">VAI TRÒ CỦA TÔI</p>
          <h2 class="section-title" style="font-size: 1.8rem;">SEO Project Lead & Hands-on SEO Executive</h2>
          <p class="cs-role-subtitle" style="font-weight: 700; color: var(--color-accent); margin-top: -8px; margin-bottom: 16px; font-size: 1.05rem;">Lead triển khai SEO & trực tiếp phụ trách execution</p>
        </div>
        <p class="cs-role-desc">
          Tôi lead quá trình triển khai SEO cho dự án Suối Tiên, đồng thời trực tiếp tham gia các hạng mục execution trọng tâm: technical audit, content & on-page optimization, internal link planning, tracking ranking/traffic và phối hợp cùng Content, Dev, Account để đảm bảo tiến độ KPI.
        </p>
        <div class="cs-role-tags">
          <span class="cs-role-tag">SEO Leadership</span>
          <span class="cs-role-tag">Technical Audit</span>
          <span class="cs-role-tag">Content & On-page</span>
          <span class="cs-role-tag">Internal Link Planning</span>
          <span class="cs-role-tag">Tracking & Reporting</span>
          <span class="cs-role-tag">Team Coordination</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SEO Problems — Interactive Section -->
  <section id="suoi-problems-section" class="section section-muted">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">VẤN ĐỀ CẦN GIẢI QUYẾT</p>
        <h2 class="section-title">4 vấn đề SEO cốt lõi</h2>
        <p class="section-subtitle">Những rủi ro có thể làm chậm tăng trưởng organic nếu không được xử lý đúng ưu tiên.</p>
      </div>

      <div class="problems-layout">
        <!-- Left Column: Interactive Modules (Clickable buttons) -->
        <div class="problems-modules">
          {seoProblems.map((prob, index) => {
            const isActive = index === 0;
            return (
              <div class="problems-accordion-item">
                <button 
                  id={`suoi-problem-btn-${prob.num}`}
                  class={`problems-module ${isActive ? 'is-active' : ''}`}
                  aria-expanded={isActive ? "true" : "false"}
                  aria-controls={`suoi-problems-mobile-panel-${prob.num}`}
                  data-problem-id={prob.num}
                >
                  <div class="problems-module__header">
                    <span class="problems-num">{prob.num}</span>
                    <h4 class="problems-module__title">{prob.title}</h4>
                  </div>
                  <p class="problems-module__outcome">{prob.shortDesc}</p>
                  <span class="problems-module__label">{prob.shortLabel}</span>
                </button>
                
                <!-- Mobile accordion inline detail panel -->
                <div 
                  id={`suoi-problems-mobile-panel-${prob.num}`}
                  class={`problems-mobile-panel ${isActive ? 'is-active' : ''}`}
                  aria-hidden={isActive ? "false" : "true"}
                  role="region"
                  aria-labelledby={`suoi-problem-btn-${prob.num}`}
                >
                  <div class="problems-mobile-panel-header">
                    <span class="severity-badge">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="warning-icon"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                      {prob.severity}
                    </span>
                  </div>

                  <div class="problems-detail-section">
                    <h4 class="problems-section-title">Mô tả vấn đề:</h4>
                    <p class="problems-panel-desc">{prob.shortDesc}</p>
                  </div>

                  <div class="problem-outcome-stack">
                    <div class="problem-impact">
                      <h4>Hậu quả & Tác động (Impact)</h4>
                      <p>{prob.impact}</p>
                    </div>

                    <div class="problem-response">
                      <h4>Giải pháp xử lý (Response)</h4>
                      <p>{prob.response}</p>
                    </div>
                  </div>

                  {prob.tags && prob.tags.length > 0 && (
                    <div class="case-problem-card__tags" style="margin-top: 16px;">
