    padding: 32px 28px;
  }

  .cs-strategy-block-wrapper:nth-child(odd) .cs-strategy-block {
    float: left;
  }

  .cs-strategy-block-wrapper:nth-child(even) .cs-strategy-block {
    float: right;
  }

  /* Timeline dots */
  .cs-strategy-block-wrapper::before {
    content: '';
