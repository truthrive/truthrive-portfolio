---
import BaseLayout from "../layouts/BaseLayout.astro";

// --- Contact Configuration ---
const contactConfig = {
  email: "bt.thinh2010@gmail.com",
  phone: "0779666784",
  linkedIn: "https://www.linkedin.com/in/truongthinhseo/",
  location: "TP. Hồ Chí Minh, Việt Nam",
  auditPage: "/request-seo-audit/" // Keep consistent with Header
};

const title = "Liên hệ TruThrive | SEO Audit & Consulting";
const description = "Liên hệ TruThrive để trao đổi về SEO Audit, Technical SEO, Content Strategy và SEO Automation cho website của bạn.";
---

<BaseLayout title={title} description={description}>
  <!-- Contact Hero -->
  <section class="section hero-section">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">LIÊN HỆ TRUTHRIVE</p>
        <h1 class="hero-title">Bạn đang cần một góc nhìn rõ ràng hơn về SEO?</h1>
        <p class="section-subtitle">
          Hãy gửi thông tin cơ bản về website hoặc dự án, tôi sẽ phản hồi với hướng tiếp cận phù hợp để giúp bạn tối ưu hóa tăng trưởng.
        </p>
        <div class="btn-group center" style="margin-top: 32px;">
          <a href="#contact-form" class="btn btn-primary">Gửi yêu cầu liên hệ</a>
          <a href="/case-studies/suoi-tien-seo/" class="btn btn-secondary">Xem Case Study</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Options Section -->
  <section class="section section-muted">
    <div class="container">
      <div class="contact-options-grid">
        <article class="card contact-option-card">
          <div class="card-icon">🔍</div>
          <h3>Request SEO Audit</h3>
          <p>Phù hợp nếu bạn muốn kiểm tra technical foundation, content system, organic traffic hoặc ranking hiện tại.</p>
          <a href="#contact-form" class="btn btn-secondary btn-sm">Gửi yêu cầu audit</a>
        </article>

        <article class="card contact-option-card">
          <div class="card-icon">🚀</div>
          <h3>Project Discussion</h3>
          <p>Phù hợp nếu bạn đang cần tư vấn chiến lược SEO, content roadmap hoặc automation workflow cho dự án mới.</p>
          <a href="#contact-form" class="btn btn-secondary btn-sm">Trao đổi dự án</a>
        </article>

        <article class="card contact-option-card">
          <div class="card-icon">🤝</div>
          <h3>Partnership</h3>
          <p>Phù hợp với agency, team marketing hoặc business owner muốn xây dựng mối quan hệ hợp tác dài hạn.</p>
          <a href="#contact-form" class="btn btn-secondary btn-sm">Kết nối hợp tác</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Contact Form & Info -->
  <section id="contact-form" class="section">
    <div class="container">
      <div class="contact-layout">
        <!-- Form UI (Static) -->
        <div class="contact-form-container">
          <div class="card">
            <h2 class="section-title" style="font-size: 1.75rem; margin-bottom: 24px;">Thông tin dự án</h2>
            
            <!-- 
              TODO: Backend/Form handling integration will be added here.
              Current UI is for demonstration of the contact flow.
            -->
            <form class="contact-form" onsubmit="event.preventDefault(); alert('Cảm ơn bạn! Tính năng gửi form sẽ được tích hợp sớm.');">
              <div class="form-group">
                <label for="name">Họ và tên</label>
                <input type="text" id="name" name="name" placeholder="Ví dụ: Nguyễn Văn A" required />
              </div>

              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="email@example.com" required />
              </div>

              <div class="form-group">
                <label for="website">Website / Domain</label>
                <input type="url" id="website" name="website" placeholder="https://example.com" />
              </div>

              <div class="form-group">
                <label for="goal">Mục tiêu liên hệ</label>
                <select id="goal" name="goal">
                  <option value="audit">SEO Audit</option>
                  <option value="technical">Technical SEO</option>
                  <option value="content">Content Strategy</option>
                  <option value="automation">SEO Automation</option>
                  <option value="partnership">Partnership</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message">Nội dung cần trao đổi</label>
                <textarea id="message" name="message" rows="5" placeholder="Chia sẻ thêm về tình trạng website hoặc mục tiêu của bạn..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary" style="width: 100%;">Gửi thông tin</button>
            </form>
          </div>
        </div>

        <!-- Direct Contact & Info -->
        <div class="contact-info-sidebar">
          <div class="card info-card">
            <h3 class="info-card-title">Thông tin trực tiếp</h3>
            <div class="info-list">
              <div class="info-item">
                <span class="info-icon">📧</span>
                <div class="info-text">
                  <span class="info-label">Email</span>
                  <a href={`mailto:${contactConfig.email}`}>{contactConfig.email}</a>
                </div>
              </div>
              <div class="info-item">
                <span class="info-icon">📞</span>
                <div class="info-text">
                  <span class="info-label">Điện thoại</span>
                  <a href={`tel:${contactConfig.phone}`}>{contactConfig.phone}</a>
                </div>
              </div>
              <div class="info-item">
                <span class="info-icon info-icon--img">
                  <img 
                    src="/images/logos/linkedIn-logo-social.webp" 
                    alt="LinkedIn Logo" 
                    class="social-icon-img"
                    width="24"
                    height="24"
                  />
                </span>
                <div class="info-text">
                  <span class="info-label">LinkedIn</span>
                  <a href={contactConfig.linkedIn} target="_blank" rel="noopener noreferrer">Kết nối Profile</a>
                </div>
              </div>
              <div class="info-item">
                <span class="info-icon">📍</span>
                <div class="info-text">
                  <span class="info-label">Địa điểm</span>
                  <span>{contactConfig.location}</span>
                </div>
              </div>
            </div>
          </div>

          <div class="project-fit-card">
            <h3 class="info-card-title">Phù hợp nếu bạn đang gặp các vấn đề:</h3>
            <ul class="fit-list">
              <li>
                <span class="fit-bullet"></span>
                <span>Organic traffic giảm hoặc tăng trưởng chậm</span>
              </li>
              <li>
                <span class="fit-bullet"></span>
                <span>Website có vấn đề technical SEO, crawl/index hoặc Core Web Vitals</span>
              </li>
              <li>
                <span class="fit-bullet"></span>
                <span>Content nhiều nhưng chưa tạo traffic hoặc chuyển đổi</span>
              </li>
              <li>
                <span class="fit-bullet"></span>
                <span>Cần hệ thống audit / automation để tối ưu SEO ở scale lớn</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-heading text-center" style="margin-bottom: 0;">
        <h2 class="section-title">Cần một chẩn đoán SEO rõ ràng hơn?</h2>
        <p class="section-subtitle">
          Gửi thông tin website hoặc mục tiêu hiện tại, tôi sẽ giúp bạn xác định vấn đề ưu tiên trước khi scale organic traffic.
        </p>
        <div class="btn-group center" style="margin-top: 32px;">
          <a href={contactConfig.auditPage} class="btn btn-primary">Request SEO Audit</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Contact Options Grid */
  .contact-options-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-grid-gap);
  }
  .contact-option-card {
    display: flex;
    flex-direction: column;
    text-align: center;
    align-items: center;
  }
  .card-icon {
    font-size: 2.5rem;
    margin-bottom: 20px;
  }
  .contact-option-card h3 {
    font-size: 1.25rem;
    margin-bottom: 12px;
  }
  .contact-option-card p {
    margin-bottom: 24px;
    font-size: 0.95rem;
    color: var(--color-muted-text);
    flex: 1;
  }
  .btn-sm {
    padding: 10px 20px;
    font-size: 14px;
  }

  /* Contact Layout */
  .contact-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: start;
  }

  /* Form Styling */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .form-group label {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .form-group input, 
  .form-group select, 
  .form-group textarea {
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-text);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-group input:focus, 
  .form-group select:focus, 
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(193, 18, 31, 0.1);
  }

  /* Sidebar Info Cards */
  .info-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--color-text);
  }
  .info-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .info-icon {
    font-size: 1.5rem;
    line-height: 1;
  }
  .info-icon--img {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-top: 2px;
  }
  .social-icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .info-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .info-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }
  .info-text a, .info-text span {
    font-weight: 600;
    color: var(--color-text);
  }
  .info-text a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .project-fit-card {
    margin-top: 32px;
    padding: 32px;
    background-color: var(--color-muted-section);
    border-radius: var(--radius-lg);
  }
  .fit-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .fit-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.95rem;
    color: var(--color-muted-text);
    line-height: 1.5;
  }
  .fit-bullet {
    width: 6px;
    height: 6px;
    background-color: var(--color-accent);
    border-radius: 50%;
    margin-top: 8px;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact-options-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .contact-info-sidebar {
      order: -1;
    }
  }
  @media (max-width: 768px) {
    .contact-options-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
