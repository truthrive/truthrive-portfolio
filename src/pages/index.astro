---
import BaseLayout from "../layouts/BaseLayout.astro";
import { personSchema } from "../data/schema";
import BrandMarquee from "../components/BrandMarquee.astro";


const caseStudies = [
  {
    seq: '01',
    title: 'Suối Tiên',
    badge: 'Domain Migration · Tourism SEO',
    logoSrc: '/images/logos/suoi-tien-logo.png',
    logoAlt: 'Suối Tiên logo',
    monogram: 'ST',
    status: 'available',
    href: '/case-studies/suoi-tien-seo/',
    compactRole: 'Project Lead & Technical SEO',
    summary: 'Migration từ suoitien.com sang suoitien.vn, duy trì hiệu suất kỹ thuật và mở rộng độ phủ từ khóa phi thương hiệu.',
    challenge: [
      'Duy trì hiệu suất SEO trong quá trình migration tên miền.',
      'Mở rộng độ phủ từ khóa phi thương hiệu sau migration.'
    ],
    role: [
      'Project Lead & Hands-on SEO Executive',
      'Technical Audit',
      'Migration Roadmap',
      'On-page Structure',
      'Measurement Setup'
    ],
    actions: [
      'Xây dựng bản đồ redirect 1:1 chi tiết',
      'Cấu hình tín hiệu thực thể và kỹ thuật di chuyển',
      'Tối ưu topical map và hệ thống GSC/GA4'
    ],
    metrics: [
      { value: '32.198', label: 'Sessions', countTo: '32198', format: 'vi-dot' },
      { value: '77', label: 'Keywords Top 3', countTo: '77' },
      { value: '500', label: 'AIO Traffic (GA4)', countTo: '500' }
    ]
  },
  {
    seq: '02',
    title: 'DOL Grammar',
    badge: 'New Website SEO · Topical Authority',
    logoSrc: '/images/logos/dol-grammar-logo-logo.png',
    logoAlt: 'DOL Grammar logo',
    monogram: 'DOL',
    status: 'available',
    href: '/case-studies/dol-grammar-seo/',
    compactRole: 'SEO Strategy & Project Lead',
    summary: 'Xây nền tảng SEO cho website mới từ giai đoạn launch, tập trung topical authority, cấu trúc nội dung và workflow có thể mở rộng.',
    challenge: [
      'Xây topical authority cho một website hoàn toàn mới.',
      'Chuẩn hóa cấu trúc nội dung và workflow có thể mở rộng.'
    ],
    role: [
      'Middle SEO / SEO Project Leader',
      'SEO Strategy',
      'KPI/OKR Planning',
      'Topical Map & Site Structure',
      'Content Optimization Workflow'
    ],
    actions: [
      'Xây topical map và cấu trúc website theo cụm chủ đề Grammar',
      'Chuẩn hóa tiêu chuẩn content, on-page và internal linking',
      'Triển khai schema, author, PR/entity và kế hoạch live web'
    ],
    metrics: [
      { value: '66.000', label: 'Organic Traffic', countTo: '66000', format: 'vi-dot' },
      { value: '252', label: 'Ranking Keywords', countTo: '252' },
      { value: '16%', label: 'Keywords Top 1–3', countTo: '16', suffix: '%' }
    ]
  },
  {
    seq: '03',
    title: 'Hoàng Long Computer',
    badge: 'SEO Recovery · E-commerce SEO · AI/GEO Growth',
    logoSrc: '/images/logos/hoang-long-logo.png',
    logoAlt: 'Hoàng Long Computer logo',
    monogram: 'HLC',
    status: 'available',
    href: '/case-studies/hoang-long-computer-seo/',
    compactRole: 'SEO Project Leader',
    summary: 'Phục hồi và mở rộng SEO e-commerce ngành PC/Gaming, kết hợp Technical SEO, Content Strategy và đo lường tăng trưởng AI/GEO.',
    challenge: [
      'Khắc phục các vấn đề Technical SEO từ custom CMS.',
      'Phục hồi ranking và mở rộng traffic có giá trị chuyển đổi.'
    ],
    role: [
      'SEO Project Leader',
      'KPI Planning & Forecasting',
      'Technical Audit',
      'Content Strategy',
      'SEO Execution Direction'
    ],
    actions: [
      'Chuẩn hóa KPI theo nhóm maintenance và growth keywords',
      'Audit technical, content structure và search intent',
      'Mở rộng SEO theo nhóm PC gaming, bộ PC, RTX, màn hình và linh kiện'
    ],
    metrics: [
      { value: '980.965', label: 'Organic Search sessions', countTo: '980965', format: 'vi-dot' },
      { value: '15.302', label: 'AI Chats sessions', countTo: '15302', format: 'vi-dot' },
      { value: '67%', label: 'Top 3 nhóm từ khóa duy trì', countTo: '67', suffix: '%' }
    ]
  },
  {
    seq: '04',
    title: 'Hikid',
    badge: 'Coming soon',
    logoSrc: '/images/logos/hikid-logo.png',
    logoAlt: 'Hikid logo',
    monogram: 'HKD',
    status: 'coming-soon',
    href: '',
    compactRole: 'Case study đang biên soạn',
    summary: 'Dự án SEO cho thương hiệu dinh dưỡng cao cấp; case study đang được chuẩn hóa dữ liệu và hoàn thiện nội dung.',
    challenge: [
      'Xây nền tảng SEO cho thương hiệu dinh dưỡng cao cấp.',
      'Dữ liệu kết quả đang được chuẩn hóa để hoàn thiện case study.'
    ],
    role: [
      'SEO Project Leader',
      'SEO Strategy & Execution',
      'Technical & Content Audit',
      'Performance Tracking'
    ],
    actions: [
      'Nghiên cứu thị trường và hành vi tìm kiếm ngành hàng dinh dưỡng',
      'Xây dựng topical map và kiến trúc thông tin website',
      'Chuẩn hóa quy trình tối ưu Technical & Content'
    ],
    metrics: [
      { value: '••.•••', label: 'Organic Sessions', countTo: '0' },
      { value: '••%', label: 'Top 3 Keywords', countTo: '0' },
      { value: '•••+', label: 'Conversion Intent', countTo: '0' }
    ]
  }
];


const capabilities = [
  {
    num: '01',
    title: 'Technical SEO Foundation',
    shortLabel: 'Nền tảng kỹ thuật tối ưu',
    outcome: 'Đảm bảo website có nền tảng crawl, index và cấu trúc kỹ thuật đủ tốt để tăng trưởng.',
    explanation: 'Tôi chẩn đoán và xử lý chuyên sâu các rào cản kỹ thuật, giúp công cụ tìm kiếm thu thập thông tin dễ dàng và lập chỉ mục tối đa các trang mang lại giá trị kinh doanh.',
    whatItSolves: [
      'Ngăn chặn lãng phí ngân sách cào dữ liệu (Crawl Budget) trên hệ thống lớn',
      'Xử lý triệt để lỗi lập chỉ mục chậm, lỗi trùng lặp nội dung hoặc canonical',
      'Cải thiện trải nghiệm người dùng thực tế thông qua tối ưu Core Web Vitals',
      'Cấu trúc Schema nâng cao giúp tối ưu hóa khả năng hiển thị trên SERP'
    ],
    chips: ['Crawlability', 'Indexation', 'Schema', 'Core Web Vitals']
  },
  {
    num: '02',
    title: 'Content & Topical Authority',
    shortLabel: 'Chiến lược bao phủ chủ đề',
    outcome: 'Xây dựng hệ thống nội dung theo intent, topical map và authority để mở rộng ranking bền vững.',
    explanation: 'Tôi thiết lập cấu trúc nội dung có hệ thống (Topical Map), giúp thương hiệu xác lập vị trí chuyên gia trong ngành và phủ toàn bộ phễu nhu cầu của khách hàng.',
    whatItSolves: [
      'Khắc phục tình trạng nội dung mỏng, thiếu chuyên sâu hoặc trùng lặp intent',
      'Xác định và khai thác khoảng trống từ khóa (Keyword Gap) so với đối thủ',
      'Đồng bộ hóa nội dung chính xác theo Search Intent để tối ưu chuyển đổi',
      'Audit hệ thống URL hiện tại để gộp/xóa các trang kém hiệu suất'
    ],
    chips: ['Topical Map', 'Content Audit', 'Search Intent', 'Silo Structure']
  },
  {
    num: '03',
    title: 'Organic Growth & SEO Project Leadership',
    shortLabel: 'Lộ trình thực thi chiến lược',
    outcome: 'Chuyển mục tiêu kinh doanh thành KPI, roadmap, workflow và kế hoạch triển khai thực tế.',
    explanation: 'Tôi chuyển dịch mục tiêu kinh doanh thành các kế hoạch hành động cụ thể, làm cầu nối tối ưu hiệu quả làm việc giữa đội ngũ lập trình (Dev) và nội dung (Content).',
    whatItSolves: [
      'Định hình lộ trình SEO ưu tiên theo ma trận Impact vs. Effort thực tế',
      'Xây dựng các bộ checklist, workflow bàn giao rõ ràng cho Dev và Content',
      'Bảo toàn sức khỏe SEO và thứ hạng khi di chuyển tên miền (Migration)',
      'Giám sát sức khỏe dự án qua GA4, GSC và dashboard báo cáo trực quan'
    ],
    chips: ['SEO Roadmap', 'KPI Tracking', 'Dev Alignment', 'Domain Migration']
  },
  {
    num: '04',
    title: 'SEO Systems & Automation',
    shortLabel: 'Chuẩn hóa & Tự động hóa',
    outcome: 'Quy chuẩn hóa quy trình thực thi SEO và tự động hóa tác vụ phân tích để scale hiệu quả organic.',
    explanation: 'Tôi thiết kế các workflow, checklist, audit framework và internal tools giúp giảm thiểu sai sót thủ công, chuẩn hóa năng lực thực thi của đội ngũ và giải phóng thời gian phân tích dữ liệu lớn.',
    whatItSolves: [
      'Chuẩn hóa năng lực thực thi SEO giữa các nhân sự thông qua bộ quy chuẩn thông minh',
      'Cắt giảm 80% thời gian xử lý thủ công các tác vụ lặp đi lặp lại bằng công cụ nội bộ',
      'Tự động hóa logfile audit, content review, on-page và textlink filtering bằng script',
      'Tối ưu hóa và giám sát tín hiệu thực thể chuẩn bị cho kỷ nguyên AI Search (GEO/AIO)'
    ],
    chips: ['SEO Tooling', 'Apps Script', 'AI Systems', 'Workflow Design'],
    href: '/seo-systems/',
    cta: 'Khám phá Hệ thống SEO →'
  }
];
---

<BaseLayout title="Bùi Trường Thịnh — Senior SEO Specialist & AI Builder | TruThrive" schema={personSchema}>
  <!-- Hero Section -->
  <section class="section hero-section">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-left">
          <span class="pill">TruThrive — Personal Portfolio</span>
          <h1 class="hero-title" style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin-bottom: 16px;">
            Bùi Trường Thịnh
            <span style="display: block; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: var(--color-accent); margin-top: 8px;">
              Senior SEO Specialist & AI Builder
            </span>
          </h1>

          <!-- Compact Contact Row -->
          <div class="hero-quick-contact">
            <a href="tel:0779666784" class="hero-contact-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>0779 666 784</span>
            </a>
            <a href="mailto:bt.thinh2010@gmail.com" class="hero-contact-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>bt.thinh2010@gmail.com</span>
            </a>
            <span class="hero-contact-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>TP. Hồ Chí Minh</span>
            </span>
          </div>

          <!-- Hero Actions -->
          <div class="btn-group hero-actions-group">
            <a href="#case-showcase-wrapper" class="btn btn-primary hero-btn-main">Xem Case Studies</a>
            <div class="hero-actions-row-2">
              <button id="open-cv-modal" data-open-cv-modal type="button" class="btn btn-secondary hero-btn-sub">Xem nhanh CV</button>
              <a 
                href="https://linkedin.com/in/truongthinhseo" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-icon-linkedin"
                aria-label="Xem LinkedIn của Bùi Trường Thịnh"
                title="LinkedIn"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
        
        <div class="hero-right">
          <div class="card hero-profile-card">
            <div class="headshot-container">
              <img 
                src="/images/profile/bui-truong-thinh-portrait-update.jpeg" 
                alt="Chân dung Bùi Trường Thịnh" 
                class="headshot-img-refined" 
              />
            </div>
            <h3 class="hero-card-heading">Năng lực cốt lõi</h3>
            <p class="hero-card-subtitle">Strategy · Technical · Growth · AI Search</p>
            <div class="hero-skills-clean-grid">
              <div class="hero-skill-clean-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-skill-icon" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                </svg>
                <span class="hero-skill-text">SEO Strategy & Project Leadership</span>
              </div>
              <div class="hero-skill-clean-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-skill-icon" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
                <span class="hero-skill-text">Technical SEO & Website Recovery</span>
              </div>
              <div class="hero-skill-clean-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-skill-icon" aria-hidden="true">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                  <polyline points="17 6 23 6 23 12"/>
                </svg>
                <span class="hero-skill-text">Content Strategy & Organic Growth</span>
              </div>
              <div class="hero-skill-clean-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-skill-icon" aria-hidden="true">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3z"/>
                </svg>
                <span class="hero-skill-text">GEO/AIO & SEO Automation</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Proof (Executive Dashboard) -->
  <section class="section section-muted prof-metrics-section">
    <div class="container">
      <div class="card-grid prof-metrics-grid">
        <div class="card metric-card">
          <div class="metric-icon-badge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="metric-number text-value">Gần 5 năm</div>
          <div class="metric-label">Kinh Nghiệm SEO</div>
        </div>
        <div class="card metric-card">
          <div class="metric-icon-badge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <div class="metric-number"><strong class="animated-number" data-count-to="8" data-count-suffix="+">8+</strong></div>
          <div class="metric-label">Dự Án SEO Dẫn Dắt</div>
        </div>
        <div class="card metric-card">
          <div class="metric-icon-badge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <div class="metric-number"><strong class="animated-number" data-count-to="4">4</strong></div>
          <div class="metric-label">Case Study Nổi Bật</div>
        </div>
        <div class="card metric-card">
          <div class="metric-icon-badge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </div>
          <div class="metric-number"><strong class="animated-number" data-count-to="5" data-count-suffix="+">5+</strong></div>
          <div class="metric-label">Tools & Workflows</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Personal Quote / About Preview Section -->
  <section class="section personal-quote-section" id="audience">
    <div class="container">
      <div class="personal-quote-grid">
        <div class="personal-quote-content">
          <p class="section-kicker">GÓC NHÌN CỦA TÔI</p>
          
          <div class="quote-border-block">
            <div class="quote-mark-icon-open" aria-hidden="true">
              <svg width="32" height="26" viewBox="0 0 48 40" fill="currentColor">
                <path d="M0 24C0 10.7452 10.7452 0 24 0V8C15.1634 8 8 15.1634 8 24H16V40H0V24ZM24 24C24 10.7452 34.7452 0 48 0V8C39.1634 8 32 15.1634 32 24H40V40H24V24Z" />
              </svg>
            </div>

            <blockquote class="personal-quote-text">
              SEO với tôi không chỉ là cải thiện thứ hạng, mà là xây dựng một <strong class="quote-highlight">hệ thống tăng trưởng organic có thể đo lường, lặp lại và mở rộng</strong> — bằng cách kết hợp Technical SEO, Content Strategy, dữ liệu và AI-assisted workflows.<span class="quote-mark-closing" aria-hidden="true">”</span>
            </blockquote>

            <p class="personal-supporting-text">
