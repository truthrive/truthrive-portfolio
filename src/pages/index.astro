<script>
  function initAnimatedCounters() {
    const counters = document.querySelectorAll('.animated-number');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    const formatNumber = (value: number, format?: string, decimals?: number) => {
      if (format === 'vi-dot') return Math.round(value).toLocaleString('vi-VN');
      if (format === 'decimal-comma') return value.toFixed(decimals || 1).replace('.', ',');
      if (format === 'decimal') return value.toFixed(decimals || 1);
      return Math.round(value).toString();
    };

    const animateCounter = (el: HTMLElement) => {
      const target = Number(el.dataset.countTo || 0);
      const prefix = el.dataset.countPrefix || '';
      const suffix = el.dataset.countSuffix || '';
      const format = el.dataset.countFormat || '';
      const decimals = Number(el.dataset.countDecimals || 0);
      const duration = 1200;
      
      if (prefersReducedMotion) {
        return;
      }
      
      el.textContent = prefix + formatNumber(0, format, decimals) + suffix;
      const startTime = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = target * eased;
        
        el.textContent = prefix + formatNumber(current, format, decimals) + suffix;

        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          el.textContent = prefix + formatNumber(target, format, decimals) + suffix;
        }
      };

      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        animateCounter(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.35 });

    counters.forEach((counter) => observer.observe(counter));
  }

  document.addEventListener('DOMContentLoaded', () => {
    initCvModal();
    initAnimatedCounters();
  });
  document.addEventListener('astro:page-load', () => {
    initCvModal();
    initAnimatedCounters();
  });
</script>

