---
import BaseLayout from "../layouts/BaseLayout.astro";
import { personSchema } from "../data/schema";

const caseStudies = [
  {
    title: 'Suối Tiên',
    badge: 'Domain Migration · Tourism SEO',
    logoSrc: null,
    logoAlt: 'Suối Tiên logo',
    status: 'available',
    href: '/case-studies/suoi-tien-seo/',
    summary: 'Dự án di chuyển tên miền (migration) quy mô lớn từ suoitiien.com sang suoitiien.vn, bảo vệ hiệu suất kỹ thuật toàn diện và mở rộng tối đa tệp từ khóa phi thương hiệu.',
    challenge: [
      'Bảo toàn hiệu suất khi di chuyển từ suoitiien.com sang suoitiien.vn',
      'Duy trì sức khỏe kỹ thuật và mở rộng tệp từ khóa phi thương hiệu'
    ],
    role: [
      'Technical Audit',
      'Migration Roadmap',
      'On-page Structure',
      'Measurement Setup'
    ],
    actions: [
      'Xây dựng bản đồ redirect 1:1 chi tiết',
      'Cấu hình tín hiệu thực thể và kỹ thuật di chuyển',
      'Tối ưu Topical Map và hệ thống GSC/GA4'
    ],
    metrics: [
      { value: '32.198', label: 'Sessions (100,8% KPI)', countTo: '32198', format: 'vi-dot' },
      { value: '77', label: 'Keywords Top 3 (35%)', countTo: '77' },
      { value: '500', label: 'AIO Traffic (GA4)', countTo: '500' }
    ]
  },
  {
    title: 'Content System SEO',
    badge: 'Content Strategy · Topical Authority',
    logoSrc: null,
    logoAlt: '',
    status: 'coming-soon',
    summary: 'Xây dựng hệ thống nội dung chuyên sâu phục vụ chuyển đổi và xác lập Topical Authority ngành.',
    chips: ['Content System', 'Topical Authority', 'Measurement']
  },
  {
    title: 'Technical SEO Audit',
    badge: 'Technical SEO · Crawl & Indexing',
    logoSrc: null,
    logoAlt: '',
    status: 'coming-soon',
    summary: 'Chẩn đoán và xử lý lỗi crawlability, indexing quy mô lớn cho website thương mại điện tử.',
    chips: ['Technical SEO', 'Crawl', 'Indexing']
  }
];

const capabilities = [
  {
    num: '01',
    title: 'Technical SEO Foundation',
    shortLabel: 'Nền tảng kỹ thuật tối ưu',
    outcome: 'Đảm bảo website có nền tảng crawl, index và cấu trúc kỹ thuật đủ tốt để tăng trưởng.',
    explanation: 'Tôi chẩn đoán và xử lý chuyên sâu các rào cản kỹ thuật, giúp công cụ tìm kiếm thu thập thông tin dễ dàng và lập chỉ mục tối đa các trang mang lại giá trị kinh doanh.',
    whatItSolves: [
      'Ngăn chặn lãng phí ngân sách cào dữ liệu (Crawl Budget) trên hệ thống lớn',
      'Xử lý triệt để lỗi lập chỉ mục chậm, lỗi trùng lặp nội dung hoặc canonical',
      'Cải thiện trải nghiệm người dùng thực tế thông qua tối ưu Core Web Vitals',
      'Cấu trúc Schema nâng cao giúp tối ưu hóa khả năng hiển thị trên SERP'
    ],
    chips: ['Crawlability', 'Indexation', 'Schema', 'Core Web Vitals']
  },
  {
    num: '02',
    title: 'Content & Topical Authority',
    shortLabel: 'Chiến lược bao phủ chủ đề',
    outcome: 'Xây dựng hệ thống nội dung theo intent, topical map và authority để mở rộng ranking bền vững.',
    explanation: 'Tôi thiết lập cấu trúc nội dung có hệ thống (Topical Map), giúp thương hiệu xác lập vị trí chuyên gia trong ngành và phủ toàn bộ phễu nhu cầu của khách hàng.',
    whatItSolves: [
      'Khắc phục tình trạng nội dung mỏng, thiếu chuyên sâu hoặc trùng lặp intent',
      'Xác định và khai thác khoảng trống từ khóa (Keyword Gap) so với đối thủ',
      'Đồng bộ hóa nội dung chính xác theo Search Intent để tối ưu chuyển đổi',
      'Audit hệ thống URL hiện tại để gộp/xóa các trang kém hiệu suất'
    ],
    chips: ['Topical Map', 'Content Audit', 'Search Intent', 'Silo Structure']
  },
  {
    num: '03',
    title: 'Organic Growth & SEO Project Leadership',
    shortLabel: 'Lộ trình thực thi chiến lược',
    outcome: 'Chuyển mục tiêu kinh doanh thành KPI, roadmap, workflow và kế hoạch triển khai thực tế.',
    explanation: 'Tôi chuyển dịch mục tiêu kinh doanh thành các kế hoạch hành động cụ thể, làm cầu nối tối ưu hiệu quả làm việc giữa đội ngũ lập trình (Dev) và nội dung (Content).',
    whatItSolves: [
      'Định hình lộ trình SEO ưu tiên theo ma trận Impact vs. Effort thực tế',
      'Xây dựng các bộ checklist, workflow bàn giao rõ ràng cho Dev và Content',
      'Bảo toàn sức khỏe SEO và thứ hạng khi di chuyển tên miền (Migration)',
      'Giám sát sức khỏe dự án qua GA4, GSC và dashboard báo cáo trực quan'
    ],
    chips: ['SEO Roadmap', 'KPI Tracking', 'Dev Alignment', 'Domain Migration']
  },
  {
    num: '04',
    title: 'AI-assisted SEO Automation & GEO/AIO',
    shortLabel: 'Tự động hóa & Sẵn sàng cho AI',
    outcome: 'Tự động hóa các tác vụ lặp lại và chuẩn bị hệ thống SEO cho AI Search.',
    explanation: 'Tôi viết các script tự động hóa để cắt giảm thời gian xử lý thủ công các tác vụ lặp lại, đồng thời tối ưu cấu trúc thực thể chuẩn bị cho kỷ nguyên tìm kiếm AI (GEO/AIO).',
    whatItSolves: [
      'Tự động hóa việc theo dõi lỗi kỹ thuật và gửi thông báo cảnh báo sớm',
      'Xây dựng các script tùy biến kết xuất dữ liệu qua API GSC, Semrush',
      'Tối ưu hóa Entity và Schema cấu trúc nhằm tương thích với AI Search',
      'Thiết kế dashboard báo cáo động giúp biến dữ liệu thành quyết định'
    ],
    chips: ['SEO Tooling', 'GEO/AIO', 'Apps Script', 'Entity SEO']
  }
];
---

<BaseLayout title="Bùi Trường Thịnh — SEO Specialist | TruThrive" schema={personSchema}>
  <!-- Hero Section -->
  <section class="section hero-section">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-left">
          <span class="pill">TruThrive — Personal Portfolio</span>
          <h1 class="hero-title" style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin-bottom: 16px;">
            Bùi Trường Thịnh
            <span style="display: block; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: var(--color-accent); margin-top: 8px;">
              Senior SEO Specialist / SEO Project Leader
            </span>
          </h1>
          <p class="hero-description" style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 32px; color: var(--color-muted-text);">
            Tôi đồng hành cùng doanh nghiệp xây dựng nền tảng tăng trưởng organic bền vững. Bằng sự kết hợp giữa Technical SEO chuyên sâu, chiến lược Content & Topical Authority tối ưu và các giải pháp SEO Automation hiện đại, tôi giúp tối ưu hóa hiệu suất và chuẩn bị sẵn sàng cho kỷ nguyên tìm kiếm AI (GEO/AIO).
          </p>
          <div class="btn-group">
            <a href="#case-showcase-wrapper" class="btn btn-primary">Xem Case Studies</a>
            <a href="https://linkedin.com/in/your-profile" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Kết nối LinkedIn</a>
          </div>
        </div>
        
        <div class="hero-right">
          <div class="card hero-profile-card" style="border: 1px solid var(--color-border); box-shadow: var(--shadow-card);">
            <div class="headshot-placeholder-container">
              <div class="headshot-placeholder monogram" style="background-color: rgba(193, 18, 31, 0.05); color: var(--color-accent); border: 1px solid rgba(193, 18, 31, 0.15);">BT</div>
              <span class="headshot-helper">Bùi Trường Thịnh</span>
            </div>
            <h3 style="text-align: center; margin-bottom: 4px;">Profile Overview</h3>
            <p class="title" style="text-align: center; font-size: 0.95rem; color: var(--color-muted-text); margin-bottom: 20px;">SEO Project Leader</p>
            <ul class="hero-focus-list" style="margin-bottom: 0; padding-top: 16px; border-top: 1px solid var(--color-border);">
              <li style="font-size: 0.95rem; margin-bottom: 10px; color: var(--color-text); font-weight: 500;"><span class="focus-icon" style="color: var(--color-accent); margin-right: 8px;">✓</span> Technical SEO & Site Architecture</li>
              <li style="font-size: 0.95rem; margin-bottom: 10px; color: var(--color-text); font-weight: 500;"><span class="focus-icon" style="color: var(--color-accent); margin-right: 8px;">✓</span> Content Strategy & Topical Authority</li>
              <li style="font-size: 0.95rem; margin-bottom: 10px; color: var(--color-text); font-weight: 500;"><span class="focus-icon" style="color: var(--color-accent); margin-right: 8px;">✓</span> SEO Automation & Workflow Solutions</li>
              <li style="font-size: 0.95rem; color: var(--color-text); font-weight: 500;"><span class="focus-icon" style="color: var(--color-accent); margin-right: 8px;">✓</span> Generative Search (GEO/AIO) Readiness</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Proof (Executive Dashboard) -->
  <section class="section section-muted" style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 48px 0;">
    <div class="container">
      <div class="card-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px;">
        <div class="card metric-card" style="padding: 24px; display: flex; flex-direction: column; justify-content: center; min-height: 120px;">
          <div class="metric-number" style="font-size: 2.25rem; font-weight: 800; color: var(--color-accent); margin-bottom: 4px;"><strong class="animated-number" data-count-to="4" data-count-suffix="+">4+</strong></div>
          <div class="metric-label" style="font-size: 0.9rem; font-weight: 700; color: var(--color-muted-text); text-transform: uppercase; letter-spacing: 0.05em;">Năm Kinh Nghiệm SEO</div>
        </div>
        <div class="card metric-card" style="padding: 24px; display: flex; flex-direction: column; justify-content: center; min-height: 120px;">
          <div class="metric-number" style="font-size: 2.25rem; font-weight: 800; color: var(--color-accent); margin-bottom: 4px;"><strong class="animated-number" data-count-to="8" data-count-suffix="+">8+</strong></div>
          <div class="metric-label" style="font-size: 0.9rem; font-weight: 700; color: var(--color-muted-text); text-transform: uppercase; letter-spacing: 0.05em;">Dự Án SEO Dẫn Dắt</div>
        </div>
        <div class="card metric-card" style="padding: 24px; display: flex; flex-direction: column; justify-content: center; min-height: 120px;">
          <div class="metric-number" style="font-size: 1.5rem; font-weight: 800; color: var(--color-accent); margin-bottom: 4px; line-height: 1.2;">Agency & In-house</div>
          <div class="metric-label" style="font-size: 0.9rem; font-weight: 700; color: var(--color-muted-text); text-transform: uppercase; letter-spacing: 0.05em;">Kinh Nghiệm Đa Dạng</div>
        </div>
        <div class="card metric-card" style="padding: 24px; display: flex; flex-direction: column; justify-content: center; min-height: 120px;">
          <div class="metric-number" style="font-size: 2.25rem; font-weight: 800; color: var(--color-accent); margin-bottom: 4px;"><strong class="animated-number" data-count-to="32198" data-count-format="vi-dot">32.198</strong></div>
          <div class="metric-label" style="font-size: 0.9rem; font-weight: 700; color: var(--color-muted-text); text-transform: uppercase; letter-spacing: 0.05em;">Sessions (Case Tiêu Biểu)</div>
        </div>
      </div>
    </div>
  </section>


  <!-- Featured Case Study Showcase (Pinned Scroll on Desktop) -->
  <section class="case-showcase-wrapper" id="case-showcase-wrapper">
    <div class="case-showcase-sticky">
      <!-- section padding added here so the sticky area covers it -->
      <div class="section case-showcase-inner">
        <div class="container">
          <div class="section-heading case-showcase-heading">
            <p class="section-kicker">SELECTED SEO CASE STUDIES</p>
            <h2 class="section-title">Case Study nổi bật</h2>
            <p class="section-subtitle">
              Mỗi case tóm tắt bối cảnh dự án, vai trò của tôi, hành động cốt lõi và kết quả SEO đo lường được.
            </p>
          </div>
          <div class="case-showcase-viewport">
            <div class="case-showcase__track" id="case-showcase-track">
              {caseStudies.map((cs) => (
                <article class={`card case-card case-card--${cs.status}`}>
                  {/* Logo + Badge row */}
                  <div class="case-card__top">
                    <div class="case-card__top-info">
                      <div class="case-card__logo">
                        {cs.logoSrc ? (
                          <img src={cs.logoSrc} alt={cs.logoAlt} loading="lazy" width="64" height="64" />
                        ) : (
                          <span>📁</span>
                        )}
                      </div>
                      <span class="pill" style="margin-bottom: 0;">{cs.badge}</span>
                    </div>
                    {cs.status === 'available' && cs.href && (
                      <a class="btn case-card__cta" href={cs.href}>Xem Case Study</a>
                    )}
                  </div>

                  {/* Body */}
                  <div class="case-card__body">
                    <h3>{cs.title}</h3>
                    <p style="font-size: 1rem; color: var(--color-muted-text); margin-bottom: 24px;">{cs.summary}</p>

                    {cs.status === 'available' ? (
                      <>
                        <div class="case-detail-grid">
                          <div class="case-detail-group">
                            <strong class="case-detail-label">Thách thức (Challenge)</strong>
                            <ul class="case-detail-list">
                              {cs.challenge.map(item => <li>{item}</li>)}
                            </ul>
                          </div>
                          <div class="case-detail-group">
                            <strong class="case-detail-label">Vai trò của tôi (My Role)</strong>
                            <ul class="case-detail-list">
                              {cs.role.map(item => <li>{item}</li>)}
                            </ul>
                          </div>
                          <div class="case-detail-group">
                            <strong class="case-detail-label">Hành động cốt lõi (Key Actions)</strong>
                            <ul class="case-detail-list">
                              {cs.actions.map(item => <li>{item}</li>)}
                            </ul>
                          </div>
                        </div>

                        <div class="case-card__footer">
                          {cs.metrics && cs.metrics.length > 0 && (
                            <>
                              <div class="case-results-header">
                                <div class="case-results-divider"></div>
                                <strong class="case-results-label">KẾT QUẢ ĐO LƯỜNG</strong>
                              </div>
                              <div class="case-metrics">
                                {cs.metrics.map((m) => (
                                  <div class="case-metric">
                                    <strong
                                      class="animated-number"
                                      data-count-to={m.countTo}
                                      {...(m.format ? { 'data-count-format': m.format } : {})}
                                      {...(m.suffix ? { 'data-count-suffix': m.suffix } : {})}
                                      {...(m.decimals ? { 'data-count-decimals': m.decimals } : {})}
                                    >{m.value}</strong>
                                    <span>{m.label}</span>
                                  </div>
                                ))}
                              </div>
                            </>
                          )}
                        </div>
                      </>
                    ) : (
                      <div class="case-card-soon-footer">
                        <span class="case-status">Đang hoàn thiện case</span>
                        {cs.chips && cs.chips.length > 0 && (
                          <div class="case-chips">
                            {cs.chips.map((chip) => (
                              <span>{chip}</span>
                            ))}
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const wrapper = document.getElementById('case-showcase-wrapper');
      const track = document.getElementById('case-showcase-track');
      if (!wrapper || !track) return;

      let scrollWidth = 0;
      let viewportWidth = 0;
      let isDesktop = false;
      let prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let maxTranslate = 0;
      
      const calculateDimensions = () => {
        isDesktop = window.matchMedia('(min-width: 1680px) and (min-height: 900px)').matches;
        
        if (isDesktop && !prefersReducedMotion) {
          // Reset transform to calculate real width
          track.style.transform = 'translate3d(0, 0, 0)';
          
          viewportWidth = track.parentElement.clientWidth;
          scrollWidth = track.scrollWidth;
          maxTranslate = scrollWidth - viewportWidth;
          
          // Only pin if track is wider than viewport
          if (maxTranslate > 0) {
            // Set wrapper height to create scrollable space (viewport height + horizontal travel distance)
            wrapper.style.height = `calc(100vh + ${maxTranslate}px)`;
            wrapper.classList.add('is-pinned-mode');
          } else {
            wrapper.style.height = 'auto';
            wrapper.classList.remove('is-pinned-mode');
          }
        } else {
          // Mobile / Reduced Motion: clear inline styles
          wrapper.style.height = '';
          track.style.transform = '';
          wrapper.classList.remove('is-pinned-mode');
        }
      };

      // Recalculate on load/resize
      calculateDimensions();
      window.addEventListener('resize', calculateDimensions);
      // Extra recalculate after fonts load
      if (document.fonts) {
        document.fonts.ready.then(calculateDimensions);
      }

      // Scroll logic with rAF
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!isDesktop || prefersReducedMotion || !wrapper.classList.contains('is-pinned-mode')) return;
        
        if (!ticking) {
          window.requestAnimationFrame(() => {
            const rect = wrapper.getBoundingClientRect();
            // How far we have scrolled past the top of the wrapper
            // rect.top is 0 when sticky starts, becomes negative as we scroll down the wrapper
            let progress = 0;
            
            // Wait until the sticky top is reached (rect.top <= 0)
            if (rect.top <= 0) {
              const scrolledDistance = Math.abs(rect.top);
              // Max distance we can scroll is wrapper height - 100vh
              const maxScrollDistance = wrapper.offsetHeight - window.innerHeight;
              
              progress = Math.min(Math.max(scrolledDistance / maxScrollDistance, 0), 1);
            }
            
            const translate = progress * maxTranslate;
            track.style.transform = `translate3d(-${translate}px, 0, 0)`;
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    });
  </script>

  <!-- Core Expertise -->
  <section id="expertise" class="section section-muted">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">NĂNG LỰC CỐT LÕI</p>
        <h2 class="section-title">Khả năng giải quyết bài toán SEO</h2>
        <p class="section-subtitle">
          Tôi tập trung vào 4 nhóm năng lực cốt lõi để xây dựng hệ thống tăng trưởng organic toàn diện và bền vững.
        </p>
      </div>

      <div class="expertise-layout expertise-interactive">
        <!-- Left Column: System Panel containing stacked panels -->
        <div class="card expertise-system-panel desktop-panel-only">
          <span class="pill" style="width: fit-content; margin-bottom: 16px;">System Model</span>
          
          <div class="expertise-panels-stack">
            {capabilities.map((cap, index) => {
              const isActive = index === 0;
              return (
                <div 
                  id={`panel-${cap.num}`}
                  class={`expertise-panel-content ${isActive ? 'is-active' : ''}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${cap.num}`}
                  aria-hidden={isActive ? "false" : "true"}
                >
                  <div class="expertise-panel-header" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                    <span class="expertise-panel-num" style="font-size: 0.95rem; font-weight: 800; color: var(--color-accent); background: rgba(193, 18, 31, 0.06); padding: 2px 8px; border-radius: var(--radius-sm); letter-spacing: 0.02em;">{cap.num}</span>
                    <h3 class="expertise-panel-title" style="font-size: 1.5rem; font-weight: 800; color: var(--color-text); margin: 0; line-height: 1.2;">{cap.title}</h3>
                  </div>
                  <p class="expertise-panel-explanation" style="font-size: 1.02rem; line-height: 1.6; color: var(--color-muted-text); margin: 0 0 24px 0;">{cap.explanation}</p>
                  
                  <div class="expertise-panel-solves-section" style="margin-bottom: 24px;">
                    <h4 class="expertise-panel-solves-title" style="font-size: 0.85rem; font-weight: 800; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 12px 0;">Vấn đề giải quyết (What this solves):</h4>
                    <ul class="expertise-panel-solves-list" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                      {cap.whatItSolves.map(bullet => (
                        <li style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.92rem; color: var(--color-text); line-height: 1.45; font-weight: 500;">
                          <span class="bullet-icon" style="color: var(--color-accent); font-weight: bold; flex-shrink: 0;">✓</span>
                          <span>{bullet}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  
                  <div class="expertise-panel-footer" style="margin-top: auto; padding-top: 16px; border-top: 1px solid rgba(216, 207, 196, 0.4);">
                    <div class="expertise-panel-chips-title" style="font-size: 0.78rem; font-weight: 800; color: var(--color-muted-text); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Đầu ra kỹ thuật (Output chips):</div>
                    <div class="expertise-chips">
