---
import BaseLayout from "../layouts/BaseLayout.astro";
import { personSchema } from "../data/schema";

const caseStudies = [
  {
    title: 'Suối Tiên',
    badge: 'Domain Migration · Tourism SEO',
    logoSrc: null,
    logoAlt: 'Suối Tiên logo',
    status: 'available',
    href: '/case-studies/suoi-tien-seo/',
    summary: 'Case domain migration từ suoitien.com sang suoitien.vn, kết hợp technical SEO, content direction và tracking để bảo vệ/tăng trưởng organic performance.',
    problem: 'Kiểm soát rủi ro migration và mở rộng non-brand traffic cho nhóm dịch vụ trọng tâm.',
    role: 'Technical audit, migration control, content direction, tracking setup và tối ưu liên tục dựa trên dữ liệu.',
    result: '77 keyword Top 3, 94 keyword Top 5, 32.198 organic sessions tháng nghiệm thu và đạt 100,8% KPI Traffic.',
    metrics: [
      { value: '77', label: 'keyword Top 3', countTo: '77' },
      { value: '94', label: 'keyword Top 5', countTo: '94' },
      { value: '32.198', label: 'organic sessions', countTo: '32198', format: 'vi-dot' },
      { value: '100,8%', label: 'KPI Traffic', countTo: '100.8', suffix: '%', format: 'decimal', decimals: '1' }
    ]
  },
  {
    title: 'Content System SEO',
    badge: 'Content Strategy · Topical Authority',
    logoSrc: null,
    logoAlt: '',
    status: 'coming-soon',
    summary: 'Case đang được cập nhật khi có đủ dữ liệu và bằng chứng đo lường.',
    chips: ['Content System', 'Topical Authority', 'Measurement']
  },
  {
    title: 'Technical SEO Audit',
    badge: 'Technical SEO · Crawl & Indexing',
    logoSrc: null,
    logoAlt: '',
    status: 'coming-soon',
    summary: 'Case đang được cập nhật khi có đủ dữ liệu và bằng chứng đo lường.',
    chips: ['Technical SEO', 'Crawl', 'Indexing']
  }
];
---

