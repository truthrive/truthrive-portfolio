---
import BaseLayout from "../layouts/BaseLayout.astro";
import { personSchema } from "../data/schema";
---

<BaseLayout title="TruThrive | True SEO. Sustainable Growth." schema={personSchema}>
  <!-- Hero Section -->
  <section class="section hero-section">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-left">
          <span class="pill">TruThrive — True SEO. Sustainable Growth.</span>
          <h1 class="hero-title">
            SEO bền vững từ Technical SEO, Content Strategy & Automation
          </h1>
          <p class="hero-description">
            Tôi giúp doanh nghiệp tăng trưởng organic traffic bằng dữ liệu, nền tảng kỹ thuật vững chắc và chiến lược nội dung rõ ràng.
          </p>
          <div class="btn-group">
            <a href="/case-studies/suoi-tien-seo/" class="btn btn-primary">Xem Case Study</a>
            <a href="/request-seo-audit/" class="btn btn-secondary">Yêu cầu SEO Audit</a>
          </div>
        </div>
        
        <div class="hero-right">
          <div class="card hero-profile-card">
            <div class="headshot-placeholder-container">
              <div class="headshot-placeholder monogram">BT</div>
              <span class="headshot-helper">Ảnh chân dung sẽ cập nhật sau</span>
            </div>
            <h3>Bùi Trường Thịnh</h3>
            <p class="title">SEO Specialist / Automation Builder</p>
            <ul class="hero-focus-list">
              <li><span class="focus-icon">✓</span> Technical SEO Audit</li>
              <li><span class="focus-icon">✓</span> Content Strategy dựa trên dữ liệu</li>
              <li><span class="focus-icon">✓</span> SEO Workflow & Automation</li>
            </ul>
            <div class="hero-stats">
              <div>
                <strong>4+</strong>
                <span>Năm kinh nghiệm SEO</span>
              </div>
              <div>
                <strong>10+</strong>
                <span>Dự án SEO</span>
              </div>
              <div>
                <strong>5+</strong>
                <span>Ngành đã triển khai</span>  
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Metrics Section -->
  <section class="section section-muted">
    <div class="container">
      <div class="card-grid">
        <div class="card metric-card">
          <div class="metric-number"><strong class="animated-number" data-count-to="4" data-count-suffix="+">0</strong></div>
          <div class="metric-label">Năm kinh nghiệm SEO</div>
        </div>
        <div class="card metric-card">
          <div class="metric-number"><strong class="animated-number" data-count-to="66000" data-count-format="vi-dot">0</strong></div>
          <div class="metric-label">Organic traffic cho DOL Grammar</div>
        </div>
        <div class="card metric-card">
          <div class="metric-number"><strong class="animated-number" data-count-to="125000" data-count-format="vi-dot">0</strong></div>
          <div class="metric-label">Organic traffic cho GTVSEO</div>
        </div>
        <div class="card metric-card">
          <div class="metric-number"><strong class="animated-number" data-count-to="70">0</strong></div>
          <div class="metric-label">Keyword Top 3 cho case Suối Tiên</div>
        </div>
      </div>
    </div>
  </section>


  <!-- Featured Case Study -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="section-kicker">DỰ ÁN TIÊU BIỂU</p>
        <h2 class="section-title">Case Study nổi bật</h2>
      </div>

      <article class="card two-col-card">
        <div class="case-info">
          <span class="pill">Domain Migration · Tourism SEO</span>
          <h3 class="section-title">Suối Tiên</h3>
          <ul class="case-summary-list">
            <li>
              <strong>Vấn đề:</strong>
              <span>Domain migration tiềm ẩn rủi ro giảm traffic và thứ hạng.</span>
            </li>
            <li>
              <strong>Hành động SEO:</strong>
              <span>Technical audit, redirect mapping và kiểm soát migration.</span>
            </li>
            <li>
              <strong>Kết quả:</strong>
              <span>Đạt +236% KPI Top 3 dựa trên các chỉ số đã báo cáo.</span>
            </li>
            <li>
              <strong>Ý nghĩa SEO:</strong>
              <span>Bảo vệ an toàn organic traffic trong suốt quá trình chuyển đổi.</span>
            </li>
          </ul>
          <a class="btn btn-primary" href="/case-studies/suoi-tien-seo/">
            Xem Case Study
          </a>
        </div>

        <div class="case-metrics">
          <div class="card metric-card">
            <div class="metric-number"><strong class="animated-number" data-count-to="70">0</strong></div>
            <div class="metric-label">keyword Top 3</div>
          </div>
          <div class="card metric-card">
            <div class="metric-number"><strong class="animated-number" data-count-to="93">0</strong></div>
            <div class="metric-label">keyword Top 5</div>
          </div>
          <div class="card metric-card">
            <div class="metric-number"><strong class="animated-number" data-count-to="32189" data-count-format="vi-dot">0</strong></div>
            <div class="metric-label">organic sessions</div>
          </div>
          <div class="card metric-card">
            <div class="metric-number"><strong class="animated-number" data-count-to="236" data-count-suffix="%">0</strong></div>
            <div class="metric-label">KPI Top 3</div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Core Expertise -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-heading text-center">
        <p class="section-kicker">NĂNG LỰC SEO</p>
        <h2 class="section-title">Năng lực chuyên môn</h2>
        <p class="section-subtitle">
          Những năng lực SEO cốt lõi giúp chẩn đoán vấn đề, xây dựng technical foundation, automation và đo lường tăng trưởng.
        </p>
      </div>

      <div class="card-grid">
        {[
          { num: '01', title: 'Technical SEO Audit', desc: 'Phân tích crawlability, indexability, sitemap, robots.txt, canonical, structured data và hiệu suất kỹ thuật.' },
          { num: '02', title: 'Content Strategy', desc: 'Xây dựng topical map, content architecture và chiến lược nội dung theo search intent và business impact.' },
          { num: '03', title: 'Content Audit', desc: 'Phân loại URL cần giữ, update, gộp, xóa hoặc noindex dựa trên dữ liệu GSC, GA4 và crawl data.' },
          { num: '04', title: 'Entity SEO', desc: 'Củng cố tín hiệu thực thể, schema, brand trust và độ nhất quán thông tin trên hệ sinh thái tìm kiếm.' },
          { num: '05', title: 'Offpage SEO', desc: 'Lập kế hoạch backlink, textlink, syndication và kiểm soát rủi ro footprint trong chiến dịch off-page.' },
          { num: '06', title: 'SEO Automation', desc: 'Tự động hóa audit, reporting và workflow SEO bằng Google Sheets, Apps Script, AI và vibe coding.' },
          { num: '07', title: 'Reporting/Data', desc: 'Thiết kế báo cáo KPI, dashboard và action-oriented reporting để biến dữ liệu thành quyết định triển khai.' },
          { num: '08', title: 'GEO & AIO', desc: 'Tối ưu nội dung và entity để thích nghi với AI Overview, generative search và thay đổi hành vi tìm kiếm.' }
        ].map(skill => (
          <article class="card feature-card">
            <span class="pill">{skill.num}</span>
            <h3>{skill.title}</h3>
            <p>{skill.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Working Approach -->
  <section class="section">
    <div class="container">
      <div class="section-heading text-center">
        <h2 class="section-title">Quy trình làm việc</h2>
        <p class="section-subtitle">
          Quy trình SEO của tôi đi từ chẩn đoán thực tế, xác định chiến lược, triển khai ưu tiên đến đo lường và tối ưu liên tục.
        </p>
      </div>

      <div class="card-grid">
        {[
          { num: '01', title: 'Audit & Chẩn đoán', desc: 'Đánh giá toàn diện hiện trạng website, dữ liệu GSC/GA4, crawl, content và technical foundation.' },
          { num: '02', title: 'Chiến lược & Ưu tiên', desc: 'Xác định root cause, ưu tiên hạng mục theo impact, effort và khả năng tạo tăng trưởng.' },
          { num: '03', title: 'Triển khai cùng SEO/Content/Dev', desc: 'Chuyển insight thành task rõ ràng và phối hợp triển khai cùng content, dev và stakeholder.' },
          { num: '04', title: 'Đo lường & Tối ưu lặp lại', desc: 'Theo dõi ranking, traffic, indexation và liên tục tối ưu dựa trên dữ liệu thực tế.' }
        ].map(step => (
          <article class="card feature-card">
            <span class="pill">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="section section-muted">
    <div class="container">
      <div class="card two-col-card">
        <div class="about-preview-content">
          <p class="section-kicker">GIỚI THIỆU</p>
          <h2 class="section-title">Bùi Trường Thịnh</h2>
          <p class="desc">
            Tôi là Trường Thịnh, SEO Specialist với kinh nghiệm thực chiến về Technical SEO, Content Strategy và SEO Automation.
          </p>
          <div class="btn-group">
            <a class="btn btn-secondary" href="/about/">Tìm hiểu sâu hơn</a>
          </div>
        </div>

        <div class="card about-snapshot">
          <span class="pill">Profile Snapshot</span>
          
          <div class="metric-number"><strong class="animated-number" data-count-to="4" data-count-suffix="+">0</strong></div>
          <div class="metric-label" style="margin-bottom: 24px;">Năm kinh nghiệm SEO</div>

          <div class="chip-group">
            <span class="chip">Technical SEO</span>
            <span class="chip">Content Audit</span>
            <span class="chip">SEO Automation</span>
            <span class="chip">Domain Migration</span>
            <span class="chip">GSC/GA4 Reporting</span>
            <span class="chip">Screaming Frog</span>
          </div>

          <div class="profile-meta">
            TP.HCM / Remote
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-heading text-center">
        <h2 class="section-title">Cần một chẩn đoán SEO rõ ràng trước khi tăng trưởng organic traffic?</h2>
        <p class="section-subtitle">
          Từ audit technical chuyên sâu đến lộ trình tăng trưởng bền vững.
        </p>
        <div class="btn-group center" style="margin-top: 32px;">
          <a class="btn btn-primary" href="/request-seo-audit/">Yêu cầu SEO Audit</a>
          <a class="btn btn-light" href="/case-studies/suoi-tien-seo/">Xem Case Study</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const counters = document.querySelectorAll('.animated-number');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    const formatNumber = (value, format) => {
      if (format === 'vi-dot') return Math.round(value).toLocaleString('vi-VN');
      return Math.round(value).toString();
    };

    const animateCounter = (el) => {
      const target = Number(el.dataset.countTo || 0);
      const suffix = el.dataset.countSuffix || '';
      const format = el.dataset.countFormat || '';
      const duration = 1200;
      
      if (prefersReducedMotion) {
        el.textContent = formatNumber(target, format) + suffix;
        return;
      }
      
      const startTime = performance.now();

      const tick = (now) => {
        const progress = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = target * eased;
        
        el.textContent = formatNumber(current, format) + suffix;

        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          el.textContent = formatNumber(target, format) + suffix;
        }
      };

      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        animateCounter(entry.target);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.35 });

    counters.forEach((counter) => observer.observe(counter));
  });
</script>
