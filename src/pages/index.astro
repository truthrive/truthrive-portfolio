  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const wrapper = document.getElementById('case-showcase-wrapper');
      const sticky = document.getElementById('case-showcase-sticky');
      const track = document.getElementById('case-showcase-track');
      const header = document.querySelector('header');
      const currentNumEl = document.getElementById('story-current-num');
      const fillEl = document.getElementById('story-progress-fill');
      const cards = Array.from(track.children);
      
      if (!wrapper || !sticky || !track) return;

      const cardCount = cards.length;
      let scrollWidth = 0;
      let viewportWidth = 0;
      let isDesktop = false;
      let prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let maxTranslate = 0;
      let headerHeight = 0;
      let scrollRange = 0;

      const calculateDimensions = () => {
        isDesktop = window.innerWidth >= 1024;
        headerHeight = header ? header.offsetHeight : 80;

        if (isDesktop && !prefersReducedMotion) {
          wrapper.style.height = '';
          track.style.transform = 'translate3d(0, 0, 0)';
          track.style.paddingRight = '';
          sticky.style.top = '';
          sticky.style.height = '';
          
          viewportWidth = track.parentElement.clientWidth;

          const lastCard = cards[cards.length - 1];
          const cardWidth = lastCard ? lastCard.offsetWidth : 0;
          const centeringOffset = cardWidth > 0
            ? Math.max(0, (viewportWidth - cardWidth) / 2)
            : 0;

          if (centeringOffset > 0) {
            track.style.paddingRight = `${centeringOffset}px`;
          }

          scrollWidth = track.scrollWidth;
          maxTranslate = scrollWidth - viewportWidth;

          if (maxTranslate > 0) {
            sticky.style.top = `${headerHeight}px`;
            const availableStickyHeight = window.innerHeight - headerHeight;
            sticky.style.height = `${availableStickyHeight}px`;

            const vhStep = window.innerHeight * 0.55;
            const stepScroll = Math.min(Math.max(vhStep, 360), 560);
            scrollRange = (cardCount - 1) * stepScroll;

            const stickyHeight = sticky.offsetHeight;
            wrapper.style.height = `${stickyHeight + scrollRange}px`;
            wrapper.classList.add('is-pinned-mode');
          } else {
            wrapper.style.height = 'auto';
            track.style.transform = '';
            track.style.paddingRight = '';
            sticky.style.top = '';
            sticky.style.height = '';
            wrapper.classList.remove('is-pinned-mode');
          }
        } else {
          wrapper.style.height = '';
          track.style.transform = '';
          track.style.paddingRight = '';
          sticky.style.top = '';
          sticky.style.height = '';
          wrapper.classList.remove('is-pinned-mode');
        }
      };

      calculateDimensions();
      window.addEventListener('resize', calculateDimensions);
      if (document.fonts) {
        document.fonts.ready.then(calculateDimensions);
      }
      if (window.ResizeObserver) {
        const ro = new ResizeObserver(() => calculateDimensions());
        ro.observe(track);
      }

      const SCRAMBLE_CHARS = '0123456789';
      const REVEAL_STEP_MS = 50;
      const SCRAMBLE_FRAMES = 6;
      const FRAME_MS = 40;

      const elTimers = new WeakMap();

      const scrambleEl = (el) => {
        const finalText = el.dataset.final;
        if (!finalText || !/\d/.test(finalText)) return;

        if (prefersReducedMotion) {
          el.textContent = finalText;
          return;
        }

        const existing = elTimers.get(el);
        if (existing) { clearTimeout(existing); elTimers.delete(el); }

        const chars = finalText.split('');
        const digitPositions = chars
          .map((c, i) => (/\d/.test(c) ? i : null))
          .filter(i => i !== null);

        let revealedCount = 0;
        const totalDigits = digitPositions.length;
        const frameCounters = new Array(totalDigits).fill(0);

        const randomChar = () => SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];

        const buildDisplay = () => {
          const out = chars.slice();
          digitPositions.forEach((pos, di) => {
            if (di < revealedCount) {
              out[pos] = chars[pos];
            } else {
              out[pos] = randomChar();
            }
          });
          return out.join('');
        };

        const tick = () => {
          if (revealedCount >= totalDigits) {
            el.textContent = finalText;
            elTimers.delete(el);
            return;
          }

          frameCounters[revealedCount]++;
          if (frameCounters[revealedCount] >= SCRAMBLE_FRAMES) {
            revealedCount++;
          }

          el.textContent = buildDisplay();
          elTimers.set(el, setTimeout(tick, revealedCount >= totalDigits ? REVEAL_STEP_MS : FRAME_MS));
        };

        tick();
      };

      const triggerScrambleForCard = (card) => {
        card.querySelectorAll('[data-scramble]').forEach(el => {
          if (prefersReducedMotion) {
            el.textContent = el.dataset.final || el.textContent;
            return;
          }
          scrambleEl(el);
        });
      };

      let lastActiveIndex = -1;

      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!isDesktop || prefersReducedMotion || !wrapper.classList.contains('is-pinned-mode')) return;

        if (!ticking) {
          window.requestAnimationFrame(() => {
            const rect = wrapper.getBoundingClientRect();
            let progress = 0;

            if (rect.top <= headerHeight) {
              const scrolledDistance = headerHeight - rect.top;
              if (scrollRange > 0) {
                progress = Math.min(Math.max(scrolledDistance / scrollRange, 0), 1);
              }
            }

            const translate = progress * maxTranslate;
            track.style.transform = `translate3d(-${translate}px, 0, 0)`;

            const activeIndex = Math.min(
              Math.floor(progress * cardCount * 0.999),
              cardCount - 1
            );

            cards.forEach((card, idx) => {
              if (idx === activeIndex) {
                card.classList.add('is-active');
              } else {
                card.classList.remove('is-active');
              }
            });

            if (activeIndex !== lastActiveIndex) {
              triggerScrambleForCard(cards[activeIndex]);
              lastActiveIndex = activeIndex;
            }

            if (currentNumEl) {
              currentNumEl.textContent = `0${activeIndex + 1}`;
            }
            if (fillEl) {
              fillEl.style.width = `${Math.max(25, (progress * 100))}%`;
            }

            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });

      const mobilePrevBtn = document.getElementById('cs-mobile-prev');
      const mobileNextBtn = document.getElementById('cs-mobile-next');
      const mobileDotsContainer = document.getElementById('cs-mobile-dots');
      const mobileDots = mobileDotsContainer ? Array.from(mobileDotsContainer.querySelectorAll('.cs-mobile-dot')) : [];

      let isTrackScrolling = false;

      const getActiveMobileIndex = () => {
        const trackRect = track.getBoundingClientRect();
        const viewportCenter = trackRect.left + trackRect.width / 2;
        let closestIndex = 0;
        let minDistance = Infinity;

        cards.forEach((card, idx) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(cardCenter - viewportCenter);

          if (distance < minDistance) {
            minDistance = distance;
            closestIndex = idx;
          }
        });

        return closestIndex;
      };

      const updateMobileSlider = () => {
        if (isDesktop || !cards.length) return;

        const activeIndex = getActiveMobileIndex();

        cards.forEach((card, idx) => {
          if (idx === activeIndex) {
            card.classList.add('is-active');
          } else {
            card.classList.remove('is-active');
          }
        });

        mobileDots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.classList.add('is-active');
          } else {
            dot.classList.remove('is-active');
          }
        });

        if (mobilePrevBtn) mobilePrevBtn.disabled = activeIndex === 0;
        if (mobileNextBtn) mobileNextBtn.disabled = activeIndex === cardCount - 1;

        if (activeIndex !== lastActiveIndex) {
          triggerScrambleForCard(cards[activeIndex]);
          lastActiveIndex = activeIndex;
        }
      };

      track.addEventListener('scroll', () => {
        if (isDesktop) return;
        if (!isTrackScrolling) {
          window.requestAnimationFrame(() => {
            updateMobileSlider();
            isTrackScrolling = false;
          });
          isTrackScrolling = true;
        }
      }, { passive: true });

      if (mobilePrevBtn) {
        mobilePrevBtn.addEventListener('click', () => {
          if (isDesktop) return;
          const currentIndex = getActiveMobileIndex();
          const targetIndex = Math.max(0, currentIndex - 1);
          const targetCard = cards[targetIndex];
          if (targetCard) {
            targetCard.scrollIntoView({
              behavior: prefersReducedMotion ? 'auto' : 'smooth',
              inline: 'center',
              block: 'nearest'
            });
          }
        });
      }

      if (mobileNextBtn) {
        mobileNextBtn.addEventListener('click', () => {
          if (isDesktop) return;
          const currentIndex = getActiveMobileIndex();
          const targetIndex = Math.min(cardCount - 1, currentIndex + 1);
          const targetCard = cards[targetIndex];
          if (targetCard) {
            targetCard.scrollIntoView({
              behavior: prefersReducedMotion ? 'auto' : 'smooth',
              inline: 'center',
              block: 'nearest'
            });
          }
        });
      }

      mobileDots.forEach((dot) => {
        dot.addEventListener('click', () => {
          if (isDesktop) return;
          const slideIdx = parseInt(dot.dataset.slideIndex || '0', 10);
          const targetCard = cards[slideIdx];
          if (targetCard) {
            targetCard.scrollIntoView({
              behavior: prefersReducedMotion ? 'auto' : 'smooth',
              inline: 'center',
              block: 'nearest'
            });
          }
        });
      });

      if (!prefersReducedMotion && cards.length > 0) {
        setTimeout(() => {
          if (!isDesktop) updateMobileSlider();
          triggerScrambleForCard(cards[0]);
        }, 600);
      }
    });
  </script>


  <!-- Explore My Work (Navigation Bridge) -->
  <section class="section" id="explore-work" style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding-top: 72px; padding-bottom: 72px;">
    <div class="container">
      <div class="section-heading text-center" style="max-width: 900px; margin-left: auto; margin-right: auto; margin-bottom: 40px;">
        <p class="section-kicker">EXPLORE MY WORK</p>
        <h2 class="section-title" style="max-width: 800px; margin-left: auto; margin-right: auto; font-size: clamp(1.8rem, 3.5vw, 2.3rem); line-height: 1.25; margin-bottom: 16px;">Khám phá năng lực qua dự án và hệ thống</h2>
        <p class="section-subtitle" style="max-width: 820px; margin-left: auto; margin-right: auto; font-size: 1.02rem; line-height: 1.65; color: var(--color-muted-text);">
          Bạn có thể xem các case SEO thực tế đã nghiệm thu hoặc khám phá những hệ thống, checklist và công cụ tôi dùng để vận hành SEO có quy trình.
