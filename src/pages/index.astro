      <script>
        document.addEventListener('DOMContentLoaded', () => {
          const expertiseSection = document.querySelector('#expertise');
          if (!expertiseSection) return;

          const tabButtons = expertiseSection.querySelectorAll('[role="tab"]');
          const tabPanels = expertiseSection.querySelectorAll('[role="tabpanel"]');
          const mobilePanels = expertiseSection.querySelectorAll('.expertise-mobile-panel');
          const modulesContainer = expertiseSection.querySelector('.expertise-modules');

          // Media query for mobile detection matching the CSS breakpoint
          const isMobileQuery = window.matchMedia('(max-width: 1023.98px)');
          const isMobile = () => isMobileQuery.matches;

          let currentActiveId = 'panel-01'; // Default active panel ID

          const updateActiveState = (activePanelId) => {
            // Safely extract the capability numeric part (e.g. "01", "02") to bypass fragile string replacements
            const activeNum = activePanelId ? activePanelId.replace('mobile-panel-', '').replace('panel-', '') : null;

            tabButtons.forEach(btn => {
              const num = btn.id.replace('tab-', '');
              const isActive = activeNum === num;

              btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
              btn.setAttribute('aria-expanded', isActive ? 'true' : 'false');

              let isFocusable = isActive;
              if (!activePanelId) {
                const buttonsArray = Array.from(tabButtons);
                isFocusable = btn === buttonsArray[0];
              }
              btn.setAttribute('tabindex', isFocusable ? '0' : '-1');

              if (isActive) {
                btn.classList.add('is-active');
              } else {
                btn.classList.remove('is-active');
              }
            });

            tabPanels.forEach(panel => {
              const num = panel.id.replace('panel-', '');
              const isActive = activeNum === num;
              panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
              if (isActive) {
                panel.classList.add('is-active');
              } else {
                panel.classList.remove('is-active');
              }
            });

            mobilePanels.forEach(panel => {
              const num = panel.id.replace('mobile-panel-', '');
              const isActive = activeNum === num;
              panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
              if (isActive) {
                panel.classList.add('is-active');
              } else {
                panel.classList.remove('is-active');
              }
            });
          };

          // Dynamically update aria-controls to reflect current responsive structure
          const updateAriaControls = () => {
            const isMobileView = isMobile();
            tabButtons.forEach(btn => {
              const num = btn.id.replace('tab-', '');
              if (isMobileView) {
                btn.setAttribute('aria-controls', `mobile-panel-${num}`);
              } else {
                btn.setAttribute('aria-controls', `panel-${num}`);
              }
            });
          };

          // Run initial ARIA controls setup
          updateAriaControls();
          // Synchronize active states properly
          updateActiveState(currentActiveId);

          // Update controls on media query change
          isMobileQuery.addEventListener('change', () => {
            updateAriaControls();
            // Ensure a valid state is selected when returning to desktop from a collapsed mobile state
            if (!isMobile() && !currentActiveId) {
              currentActiveId = 'panel-01';
            }
            updateActiveState(currentActiveId);
          });

          tabButtons.forEach(btn => {
            // Click listener
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              const targetPanelId = btn.getAttribute('aria-controls');

              if (isMobile() && btn.classList.contains('is-active')) {
                // Tap active mobile accordion to collapse it
                currentActiveId = null;
                updateActiveState(null);
              } else {
                // Otherwise open it
                currentActiveId = targetPanelId;
                updateActiveState(currentActiveId);
              }
            });

            // Focus listener (only on desktop for keyboard users; mobile uses deliberate click/tap only)
            btn.addEventListener('focus', () => {
              if (!isMobile()) {
                const targetPanelId = btn.getAttribute('aria-controls');
                currentActiveId = targetPanelId;
                updateActiveState(currentActiveId);
              }
            });

            // Hover preview listener (only on desktop)
            btn.addEventListener('mouseenter', () => {
              if (!isMobile()) {
                const targetPanelId = btn.getAttribute('aria-controls');
                updateActiveState(targetPanelId);
              }
            });
          });

          // Revert preview on mouse leave (only on desktop)
          if (modulesContainer) {
            modulesContainer.addEventListener('mouseleave', () => {
              if (!isMobile()) {
                updateActiveState(currentActiveId);
              }
            });
          }

          // Keyboard arrow key navigation inside the tablist
          const tablist = expertiseSection.querySelector('[role="tablist"]');
          if (tablist) {
            tablist.addEventListener('keydown', (e) => {
              const target = e.target;
              if (target.getAttribute('role') !== 'tab') return;

              let targetIndex = -1;
              const buttonsArray = Array.from(tabButtons);
              const currentIndex = buttonsArray.indexOf(target);

              if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
                e.preventDefault();
                targetIndex = (currentIndex + 1) % buttonsArray.length;
              } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
                e.preventDefault();
                targetIndex = (currentIndex - 1 + buttonsArray.length) % buttonsArray.length;
              } else if (e.key === 'Home') {
                e.preventDefault();
                targetIndex = 0;
              } else if (e.key === 'End') {
                e.preventDefault();
                targetIndex = buttonsArray.length - 1;
              }

              if (targetIndex !== -1) {
                const targetBtn = buttonsArray[targetIndex];
                targetBtn.focus();
              }
            });
          }
        });
      </script>
    </div>
  </section>

  <!-- How I Work (Consultant Process) -->
