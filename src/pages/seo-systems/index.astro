<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ============ DESKTOP: Vertical Tab Switching ============
    const desktopWorkspace = document.querySelector('.workspace-desktop');
    if (desktopWorkspace) {
      const tabs = Array.from(desktopWorkspace.querySelectorAll('.tool-tab')) as HTMLButtonElement[];
      const panels = Array.from(desktopWorkspace.querySelectorAll('.tool-detail')) as HTMLElement[];

      const activateDesktopTab = (targetId: string) => {
        tabs.forEach((tab) => {
          const isTarget = tab.getAttribute('data-tool-id') === targetId;
          tab.classList.toggle('is-active', isTarget);
          tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
          tab.setAttribute('tabindex', isTarget ? '0' : '-1');
        });

        panels.forEach((panel) => {
          const panelId = panel.id.replace('desktop-panel-', '');
          const isTarget = panelId === targetId;
          panel.classList.toggle('is-active', isTarget);
          panel.setAttribute('aria-hidden', isTarget ? 'false' : 'true');
        });
      };

      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', (e) => {
          e.preventDefault();
          const toolId = tab.getAttribute('data-tool-id');
          if (toolId) activateDesktopTab(toolId);
        });

        tab.addEventListener('keydown', (e: KeyboardEvent) => {
          let targetIdx = idx;

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            targetIdx = (idx + 1) % tabs.length;
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            targetIdx = (idx - 1 + tabs.length) % tabs.length;
          } else if (e.key === 'Home') {
            e.preventDefault();
            targetIdx = 0;
          } else if (e.key === 'End') {
            e.preventDefault();
            targetIdx = tabs.length - 1;
          } else {
            return;
          }

          tabs[targetIdx].focus();
          const toolId = tabs[targetIdx].getAttribute('data-tool-id');
          if (toolId) activateDesktopTab(toolId);
        });
      });
    }

    // ============ MOBILE: Accordion ============
    const mobileWorkspace = document.querySelector('.workspace-mobile');
    if (mobileWorkspace) {
      const triggers = Array.from(mobileWorkspace.querySelectorAll('.accordion-trigger')) as HTMLButtonElement[];

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          const item = trigger.closest('.accordion-item') as HTMLElement;
          if (!item) return;

          const isAlreadyOpen = item.classList.contains('is-open');

          // Close all accordion items
          const allItems = Array.from(mobileWorkspace.querySelectorAll('.accordion-item')) as HTMLElement[];
          allItems.forEach((accItem) => {
            accItem.classList.remove('is-open');
            const accTrigger = accItem.querySelector('.accordion-trigger') as HTMLButtonElement;
            if (accTrigger) accTrigger.setAttribute('aria-expanded', 'false');
          });

          // Toggle the clicked item (if it wasn't already open)
          if (!isAlreadyOpen) {
            item.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });
    }
  });
</script>
