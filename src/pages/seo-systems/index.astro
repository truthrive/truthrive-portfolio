---
// src/pages/seo-systems/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";

const cvUrl = "/files/Bui_Truong_Thinh_Senior_SEO_Specialist.pdf";

interface ToolItem {
  id: string;
  hash: string;
  name: string;
  status: "Built" | "Working MVP" | "Baseline Testing" | "In Development";
  positioning: string;
  icon: string;
  for: string;
  solves: string;
  input: string;
  logic: string;
  review: string;
  outputStep: string;
  outputDesc: string;
  ctaText: string;
  ctaLink: string;
  ctaDisabled?: boolean;
  category?: string;
  capabilities?: string[];
  technology?: string[];
  tags?: string[];
}

const builtTools: ToolItem[] = [
  {
    id: "google-indexing",
    hash: "google-indexing-tool",
    name: "Google Indexing Tool",
    status: "Working MVP",
    positioning: "Batch URL submission workflow for Google Indexing API.",
    icon: "↗",
    for: "SEO Specialist, Technical SEO, Developer",
    solves: "Standardizes validation and submission of multiple URLs through hostname verification and server-side authentication, reducing repetitive manual indexing requests.",
    input: "Batch URL List",
    logic: "Validate + Normalize",
    review: "Hostname Verification",
    outputStep: "Indexing API Submission",
    outputDesc: "Validated URL batches ready for submission to Google Indexing API.",
    ctaText: "View workflow",
    ctaLink: "#philosophy",
    category: "SEO Automation",
    capabilities: [
      "Batch URL Submission",
      "URL Validation",
      "URL Normalization",
      "Exact Hostname Verification",
      "Google Indexing API Integration",
      "Server-side Authentication"
    ],
    technology: [
      "Next.js",
      "TypeScript",
      "Google Indexing API",
      "Google Service Account",
      "Tailwind CSS"
    ],
    tags: ["SEO Automation", "Google Indexing API", "Developer Tool", "Internal System"]
  },
  {
    id: "content-audit",
    hash: "baseline-content-audit",
    name: "Content Audit Tool",
    status: "Baseline Testing",
    positioning: "Chuẩn hóa kiểm duyệt chất lượng nội dung & Search Intent hàng loạt.",
    icon: "📋",
    for: "SEO Specialist, Content Lead, Project Leader",
    solves: "Content audit thủ công dễ thiếu tiêu chí, khó định lượng và khó đồng bộ chất lượng giữa các thành viên.",
    input: "URL + Keyword",
    logic: "Audit Checklist",
    review: "Search Intent Match",
    outputStep: "Refresh Priority",
    outputDesc: "Priority, confidence, issue/opportunity và action sơ bộ phục vụ Content/SEO review.",
    ctaText: "View workflow",
    ctaLink: "#philosophy"
  },
  {
    id: "logfile-audit",
    hash: "seo-log-audit",
    name: "Logfile Audit Tool",
    status: "Built",
    positioning: "Phân tích hành vi cào dữ liệu thực tế của Googlebot để tối ưu crawl budget.",
    icon: "⚙️",
    for: "Technical SEO, SEO Project Leader",
    solves: "Khó nhận diện crawl waste, bot behavior và lỗi phản hồi thực tế từ Googlebot nếu chỉ giả lập cào.",
    input: "Raw Logfile",
    logic: "User-Agent Filter",
    review: "URL Grouping",
    outputStep: "Crawl Optimization",
    outputDesc: "Báo cáo phân bổ lượt crawl, danh sách mẫu URL lãng phí và đề xuất cải thiện cấu trúc.",
    ctaText: "View logic",
    ctaLink: "#philosophy"
  },
  {
    id: "textlink-filter",
    hash: "textlink-filtering-tool",
    name: "Textlink Filtering Tool",
    status: "Built",
    positioning: "Tự động hóa lọc & đánh giá chất lượng URL đặt textlink theo bộ tiêu chuẩn.",
    icon: "🔗",
    for: "SEO Specialist, Off-page SEO, Project Leader",
    solves: "Lọc danh sách URL đặt textlink thủ công mất thời gian và dễ chọn nhầm URL kém chất lượng.",
    input: "Raw URLs + Keyword",
    logic: "Rule Filtering",
    review: "Quality Check",
    outputStep: "Link Shortlist",
    outputDesc: "Danh sách URL sạch đạt chuẩn chất lượng và file order textlink tự động cho dự án.",
    ctaText: "View demo snapshot",
    ctaLink: "#philosophy"
  }
];

const devTools: ToolItem[] = [
  {
    id: "technical-audit",
    hash: "technical-audit-tool",
    name: "Technical Audit Tool",
    status: "In Development",
    positioning: "Quản lý và gom nhóm lỗi technical tự động theo mức độ nghiêm trọng.",
    icon: "🛠️",
    for: "Technical SEO, SEO Project Leader",
    solves: "Lỗi technical bị phân tán ở nhiều checklist, crawl exports và notes thủ công.",
    input: "Crawl Data",
    logic: "Rule Engine",
    review: "Issue Classify",
    outputStep: "Action Plan",
    outputDesc: "Danh sách lỗi kỹ thuật phân nhóm, độ ưu tiên xử lý và chỉ định template.",
    ctaText: "Coming soon",
    ctaLink: "#dev-tools",
    ctaDisabled: true
  },
  {
    id: "reporting-system",
    hash: "seo-reporting-system",
    name: "SEO Reporting System",
    status: "In Development",
    positioning: "Tự động tổng hợp và ánh xạ KPI từ GSC, rankings và traffic định kỳ.",
    icon: "📊",
    for: "Project Leader, SEO team, Client Reporting",
    solves: "Mất nhiều thời gian gom số liệu từ nhiều nguồn, tính lũy kế và viết báo cáo thủ công.",
    input: "GSC + Rankings",
    logic: "KPI Mapping",
    review: "Period Compare",
    outputStep: "Dashboard Reports",
    outputDesc: "Báo cáo tiến độ KPI tự động, biểu đồ tăng trưởng và ghi chú đề xuất chiến dịch.",
    ctaText: "Coming soon",
    ctaLink: "#dev-tools",
    ctaDisabled: true
  }
];

const allTools = [...builtTools, ...devTools];

const contentAuditIntroduction = "Baseline Content Audit Tool chuyển workflow audit content thủ công thành một quy trình sàng lọc và phân loại URL dựa trên dữ liệu, giúp Content Team có một baseline chung trước khi chuyển sang SEO review/QC.";
const contentAuditSupportingIntroduction = "Tool kết hợp dữ liệu Screaming Frog, GSC và GA4 để phát hiện issue/opportunity, gợi ý priority và action sơ bộ — không thay thế quyết định cuối cùng của SEO Specialist.";
const contentAuditBuiltFor = ["Content Team", "SEO Specialist", "SEO Project Leader"];
const contentAuditSolves = [
  "SEO & Content dễ lệch tiêu chuẩn khi audit cùng một website.",
  "Audit hàng trăm URL thủ công tạo nhiều vòng review.",
  "Checklist dễ bị áp dụng máy móc, thiếu context theo từng URL.",
  "Khó chuyển dữ liệu SF + GSC + GA4 thành priority và action nhất quán."
];
const contentAuditOutputs = [
  "Priority & Confidence",
  "Issue & Opportunity Detection",
  "Action Recommendations",
  "Google Sheets Report",
  "Interactive Dashboard"
];
const contentAuditTestingNote = "Tool hiện phục vụ screening và prioritization trong giai đoạn baseline testing. Output cần được Content/SEO review; các quyết định cần semantic judgment như search intent, content quality, cannibalization hoặc merge/delete/301 vẫn do người phụ trách xác nhận.";
const contentAuditToolUrl = "https://script.google.com/macros/s/AKfycbyteqGIdYX_xlpN5TfnmxinWQVKB0GCVGhqjiiq-ZS0u0Wj5xfmus8Qxc2LIJLGnZO_/exec";
const googleIndexingBuiltFor = ["SEO Specialist", "SEO Leader", "Website Manager"];
const googleIndexingSolves = [
  "Gửi từng URL thủ công mất nhiều thao tác.",
  "Danh sách URL dễ chứa duplicate hoặc sai định dạng.",
  "Khó kiểm soát URL khác hostname trong cùng một lượt.",
  "Google Service Account cần được bảo vệ phía server."
];
const googleIndexingOutputs = [
  "Batch URL Submission",
  "URL Validation",
  "Duplicate Filtering",
  "Hostname Verification",
  "Per-URL Status",
  "Google API Response"
];
const googleIndexingToolUrl = "https://google-indexing-tool-rust.vercel.app/";
const seoLogAuditBuiltFor = ["Technical SEO Specialist", "SEO Leader", "Website Developer"];
const seoLogAuditSolves = [
  "Logfile thô khó đọc và chưa được chuẩn hóa.",
  "Khó phân tích hành vi crawl trên lượng request lớn.",
  "Bot, status code và crawl waste phải tổng hợp thủ công.",
  "Dữ liệu kỹ thuật khó chuyển thành Action Plan rõ ràng."
];
const seoLogAuditOutputs = [
  "Googlebot Analysis",
  "Crawl Behavior Audit",
  "Status & Performance Report",
  "Issue Summary",
  "Google Sheet Action Plan",
  "Interactive Dashboard"
];
const seoLogAuditToolUrl = "https://script.google.com/macros/s/AKfycbzDvd6gjENay8qquNBETNSENoZ5jgYdIBIySudBvINcUSEjkkl3FCmdT-DNPGr3mn93eg/exec";
---

<BaseLayout 
  title="SEO Tools & Internal Systems | TruThrive" 
  description="Khám phá các công cụ và hệ thống tối ưu nội bộ được thiết kế và xây dựng để quy chuẩn hóa audit, lọc dữ liệu và tăng hiệu suất vận hành SEO thực tế."
>
  <!-- Section 1: Hero Section -->
  <section class="section systems-hero" id="top">
    <div class="container systems-hero__inner">
      <span class="pill">SEO Tools & Systems</span>
      <h1 class="systems-hero__title">
        SEO Tools & Internal Systems
      </h1>
      <p class="systems-hero__desc">
        Các công cụ tôi tự xây từ nhu cầu thực tế khi triển khai nhiều dự án SEO: giảm thao tác thủ công, chuẩn hóa audit và giúp SEO team ra quyết định nhanh hơn.
      </p>
      <div class="systems-hero__chips">
        <span class="hero-chip">Built from real SEO operations</span>
        <span class="hero-chip">Audit, logfile, textlink & reporting workflows</span>
        <span class="hero-chip">Designed for SEO Specialist / Project Leader</span>
      </div>
      <div class="btn-group center" style="margin-top: 28px;">
        <a href="#tool-explorer" class="btn btn-primary">Khám phá tools</a>
        <a href="#dev-tools" class="btn btn-outline">Tools đang phát triển</a>
      </div>
    </div>
  </section>

  <!-- Section 2: Why I Build These Tools -->
  <section class="section systems-why">
    <div class="container">
      <div class="systems-why__heading">
        <p class="section-kicker">Bối cảnh</p>
        <h2 class="section-title">Vì sao tôi xây các công cụ này?</h2>
        <p class="section-subtitle">
          Mỗi tool được tạo ra từ một vấn đề vận hành SEO thực tế: thao tác lặp lại, dữ liệu phân tán và chất lượng audit khó đồng bộ.
        </p>
      </div>
      <div class="systems-why__grid">
        <div class="why-block">
          <span class="why-block__icon">⚡</span>
          <h3 class="why-block__title">Reduce Manual Work</h3>
          <p class="why-block__desc">Giảm các thao tác lọc, kiểm tra, copy/paste và tổng hợp dữ liệu thủ công.</p>
        </div>
        <div class="why-block">
          <span class="why-block__icon">✅</span>
          <h3 class="why-block__title">Standardize Audit Quality</h3>
          <p class="why-block__desc">Chuẩn hóa input, rule, review layer và output để kết quả audit nhất quán hơn.</p>
        </div>
        <div class="why-block">
          <span class="why-block__icon">🎯</span>
          <h3 class="why-block__title">Support Better SEO Decisions</h3>
          <p class="why-block__desc">Tool không thay thế tư duy SEO, mà giúp SEOer nhìn vấn đề nhanh và có cơ sở dữ liệu hơn.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Tool Explorer Workspace -->
  <section class="section" id="tool-explorer" style="padding-top: 24px; padding-bottom: 80px; scroll-margin-top: 80px;">
    <div class="container">
      
      <div class="workspace-heading">
        <h2 class="workspace-heading__title">Tool Explorer</h2>
        <p class="workspace-heading__subtitle">
          Các công cụ tôi xây để chuẩn hóa audit, lọc dữ liệu, phân tích kỹ thuật và tăng tốc vận hành SEO.
        </p>
      </div>

      <!-- ================== DESKTOP: Vertical Tab Workspace ================== -->
      <div class="workspace-desktop" aria-label="SEO Tools Workspace">
        <!-- LEFT: Tool Index Panel -->
        <div class="tool-index-panel" role="tablist" aria-orientation="vertical">
          <div class="tool-group-label">Built & Available</div>
          {builtTools.map((tool, idx) => (
            <button 
              class={`tool-tab ${idx === 0 ? "is-active" : ""}`}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`desktop-panel-${tool.id}`}
              id={`desktop-tab-${tool.id}`}
              tabindex={idx === 0 ? "0" : "-1"}
              data-tool-id={tool.id}
              data-tool-hash={tool.hash}
            >
              <span class="tool-tab__icon">{tool.icon}</span>
              <div class="tool-tab__text">
                <span class="tool-tab__name">{tool.name}</span>
                <span class="tool-tab__summary">{tool.positioning}</span>
              </div>
              <span class={`tool-badge tool-badge--${tool.status === "In Development" ? "dev" : "built"}`}>{tool.id === "content-audit" ? "Testing" : tool.status}</span>
            </button>
          ))}

          <div class="tool-group-label" id="dev-tools">Under Development</div>
          {devTools.map((tool) => (
            <button 
              class="tool-tab"
              role="tab"
              aria-selected="false"
              aria-controls={`desktop-panel-${tool.id}`}
              id={`desktop-tab-${tool.id}`}
              tabindex="-1"
              data-tool-id={tool.id}
              data-tool-hash={tool.hash}
            >
              <span class="tool-tab__icon">{tool.icon}</span>
              <div class="tool-tab__text">
                <span class="tool-tab__name">{tool.name}</span>
                <span class="tool-tab__summary">{tool.positioning}</span>
              </div>
              <span class="tool-badge tool-badge--dev">{tool.status}</span>
            </button>
          ))}
        </div>

        <!-- RIGHT: Tool Detail Panel -->
        <div class="tool-detail-panel">
          {allTools.map((tool, idx) => (
            <div 
              class={`tool-detail ${idx === 0 ? "is-active" : ""}`}
              role="tabpanel"
              id={`desktop-panel-${tool.id}`}
              aria-labelledby={`desktop-tab-${tool.id}`}
              aria-hidden={idx === 0 ? "false" : "true"}
            >
              <div class="tool-detail__header">
                {tool.id === "content-audit" ? (
                  <div class="content-audit-title-block">
                    <h3 class="tool-detail__title">Baseline Content Audit Tool</h3>
                    <div class="content-audit-header-meta" aria-label="Tool metadata">
                      <span>Baseline Testing</span>
                      <span>Google Apps Script</span>
                      <span>Updated Aug 2026</span>
                    </div>
                  </div>
                ) : tool.id === "google-indexing" ? (
                  <div class="content-audit-title-block">
                    <h3 class="tool-detail__title">Google Indexing Tool</h3>
                    <div class="content-audit-header-meta" aria-label="Tool metadata">
                      <span>Working MVP</span>
                      <span>Next.js</span>
                      <span>Updated Aug 2026</span>
                    </div>
                  </div>
                ) : tool.id === "logfile-audit" ? (
                  <div class="content-audit-title-block">
                    <h3 class="tool-detail__title">SEO Log Audit</h3>
                    <div class="content-audit-header-meta" aria-label="Tool metadata">
                      <span>Working MVP</span>
                      <span>Google Apps Script</span>
                      <span>Updated Aug 2026</span>
                    </div>
                  </div>
                ) : <h3 class="tool-detail__title">{tool.name}</h3>}
                {tool.id === "content-audit" ? (
                  <div class="content-audit-header-actions">
                    <span class="tool-badge tool-badge--built">Baseline Testing</span>
                    <a href={contentAuditToolUrl} class="btn btn-primary content-audit-header-cta" target="_blank" rel="noopener noreferrer" aria-label="Mở Baseline Content Audit Tool trong tab mới">Try Baseline Tool ↗</a>
                  </div>
                ) : tool.id === "logfile-audit" ? (
                  <div class="content-audit-header-actions">
                    <span class="tool-badge tool-badge--built">Built</span>
                    <a href={seoLogAuditToolUrl} class="btn btn-primary content-audit-header-cta" target="_blank" rel="noopener noreferrer" aria-label="Mở SEO Log Audit trong tab mới">Open Tool ↗</a>
                  </div>
                ) : (
                  <span class={`tool-badge tool-badge--${tool.status === "In Development" ? "dev" : "built"}`}>{tool.status}</span>
                )}
              </div>
              {tool.id === "content-audit" ? (
                <div class="content-audit-intro-group">
                  <p class="tool-detail__positioning content-audit-intro">{contentAuditIntroduction}</p>
                  <p class="content-audit-intro-supporting">{contentAuditSupportingIntroduction}</p>
                </div>
              ) : (
                <p class={`tool-detail__positioning ${tool.id === "google-indexing" || tool.id === "logfile-audit" ? "content-audit-intro" : ""}`}>
                  {tool.id === "google-indexing" ? "Google Indexing Tool giúp kiểm tra, chuẩn hóa và gửi tối đa 10 URL trong một lượt tới Google Indexing API. Hệ thống xử lý URL validation, duplicate, exact hostname và server-side authentication trong một workflow thống nhất." : tool.id === "logfile-audit" ? "SEO Log Audit tự động chuyển server logfile thành dữ liệu Technical SEO có thể hành động. Hệ thống phân tích Googlebot, crawl behavior, status code, crawl waste và hiệu năng, sau đó tạo Dashboard cùng Google Sheet Action Plan cho từng lần audit." : tool.positioning}
                </p>
              )}
              {tool.id === "content-audit" && (
                <div class="content-audit-testing-note" role="note">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5" /><path d="M10 9v4m0-7v.1" /></svg>
                  <div>
                    <span class="content-audit-testing-note__label">Baseline Testing</span>
                    <p>{contentAuditTestingNote}</p>
                  </div>
                </div>
              )}

              <!-- Visual Preview Area -->
              <div class={`tool-detail__preview ${tool.id === "content-audit" || tool.id === "google-indexing" || tool.id === "logfile-audit" ? "content-audit-preview-shell" : ""}`}>
                {tool.id === "google-indexing" && (
                  <a class="content-audit-preview-link" href={googleIndexingToolUrl} target="_blank" rel="noopener noreferrer" aria-label="Mở Google Indexing Tool trong tab mới">
                    <img class="content-audit-preview-image" src="/images/pages/tool-google-indexing-api.jpg" alt="Google Indexing Tool interface" loading="lazy" />
                    <span class="content-audit-preview-action" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M8 4h8v8m0-8-9 9M5 7H4v9h9v-1" /></svg></span>
                  </a>
                )}
                {tool.id === "content-audit" && (
                  <a class="content-audit-preview-link" href={contentAuditToolUrl} target="_blank" rel="noopener noreferrer" aria-label="Open Baseline Content Audit Tool in a new tab">
                    <img class="content-audit-preview-image" src="/images/pages/tool-audit-content.jpg" alt="Baseline Content Audit Tool interface" loading="lazy" />
                    <span class="content-audit-preview-action" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M8 4h8v8m0-8-9 9M5 7H4v9h9v-1" /></svg></span>
                  </a>
                )}

                {tool.id === "logfile-audit" && (
                  <a class="content-audit-preview-link" href={seoLogAuditToolUrl} target="_blank" rel="noopener noreferrer" aria-label="Mở SEO Log Audit trong tab mới">
                    <img class="content-audit-preview-image" src="/images/pages/tool-seo-log-audit.jpg" alt="SEO Log Audit interface" loading="lazy" />
                    <span class="content-audit-preview-action" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M8 4h8v8m0-8-9 9M5 7H4v9h9v-1" /></svg></span>
                  </a>
                )}

                {tool.id === "textlink-filter" && (
                  <div class="preview-mock preview-mock--textlink-filter">
                    <div class="mock-header">
                      <span class="mock-tag">Textlink URL Screener</span>
                      <span class="mock-badge">Filter Active</span>
                    </div>
                    <div class="mock-table">
                      <div class="table-header">
                        <span>Domain URL</span>
                        <span>Score</span>
                        <span>Duplicate</span>
                        <span>Select</span>
                      </div>
                      <div class="table-row">
                        <span>agency-review.vn/seo</span>
                        <span class="text-success">9.2</span>
                        <span>No</span>
                        <span class="text-accent">✓ Selected</span>
                      </div>
                      <div class="table-row">
                        <span>forum-tech.net/post-1</span>
                        <span class="text-error">4.1</span>
                        <span class="text-error">Yes</span>
                        <span class="text-muted">Filtered</span>
                      </div>
                      <div class="table-row">
                        <span>tintuc-news.com/marketing</span>
                        <span class="text-success">8.0</span>
                        <span>No</span>
                        <span class="text-accent">✓ Selected</span>
                      </div>
                    </div>
                  </div>
                )}


                {tool.id === "technical-audit" && (
                  <div class="preview-mock preview-mock--tech-audit">
                    <div class="mock-header">
                      <span class="mock-tag">Tech Crawl Diagnostics</span>
                      <span class="mock-badge">Mock Mode</span>
                    </div>
                    <div class="mock-rows">
                      <div class="mock-row">
                        <span class="mock-row-title">404 Redirect Loops</span>
                        <span class="mock-row-badge badge-error">Critical</span>
                      </div>
                      <div class="mock-row">
                        <span class="mock-row-title">Missing Canonical URLs</span>
                        <span class="mock-row-badge badge-error">High</span>
                      </div>
                      <div class="mock-row">
                        <span class="mock-row-title">Missing Schema markup</span>
                        <span class="mock-row-badge badge-warning">Medium</span>
                      </div>
                    </div>
                  </div>
                )}

                {tool.id === "reporting-system" && (
                  <div class="preview-mock preview-mock--reporting">
                    <div class="mock-header">
                      <span class="mock-tag">Client Performance Reporting</span>
                      <span class="mock-badge">Active Sheet</span>
                    </div>
                    <div class="mock-metrics">
                      <div class="metric-box">
                        <span class="metric-title">GSC Organic Clicks</span>
