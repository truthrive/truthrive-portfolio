---
// src/pages/seo-systems/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";

const cvUrl = "/files/Bui_Truong_Thinh_Senior_SEO_Specialist.pdf";

interface ToolItem {
  id: string;
  name: string;
  status: "Built" | "In Development";
  positioning: string;
  icon: string;
  for: string;
  solves: string;
  input: string;
  logic: string;
  review: string;
  outputStep: string;
  outputDesc: string;
  ctaText: string;
  ctaLink: string;
  ctaDisabled?: boolean;
}

const builtTools: ToolItem[] = [
  {
    id: "content-audit",
    name: "Content Audit Tool",
    status: "Built",
    positioning: "Chuẩn hóa kiểm duyệt chất lượng nội dung & Search Intent hàng loạt.",
    icon: "📋",
    for: "SEO Specialist, Content Lead, Project Leader",
    solves: "Content audit thủ công dễ thiếu tiêu chí, khó định lượng và khó đồng bộ chất lượng giữa các thành viên.",
    input: "URL + Keyword",
    logic: "Audit Checklist",
    review: "Search Intent Match",
    outputStep: "Refresh Priority",
    outputDesc: "Danh sách khoảng trống nội dung (content gap), lỗi on-page và thứ tự ưu tiên tối ưu lại.",
    ctaText: "View workflow",
    ctaLink: "#philosophy"
  },
  {
    id: "logfile-audit",
    name: "Logfile Audit Tool",
    status: "Built",
    positioning: "Phân tích hành vi cào dữ liệu thực tế của Googlebot để tối ưu crawl budget.",
    icon: "⚙️",
    for: "Technical SEO, SEO Project Leader",
    solves: "Khó nhận diện crawl waste, bot behavior và lỗi phản hồi thực tế từ Googlebot nếu chỉ giả lập cào.",
    input: "Raw Logfile",
    logic: "User-Agent Filter",
    review: "URL Grouping",
    outputStep: "Crawl Optimization",
    outputDesc: "Báo cáo phân bổ lượt crawl, danh sách mẫu URL lãng phí và đề xuất cải thiện cấu trúc.",
    ctaText: "View logic",
    ctaLink: "#philosophy"
  },
  {
    id: "textlink-filter",
    name: "Textlink Filtering Tool",
    status: "Built",
    positioning: "Tự động hóa lọc & đánh giá chất lượng URL đặt textlink theo bộ tiêu chuẩn.",
    icon: "🔗",
    for: "SEO Specialist, Off-page SEO, Project Leader",
    solves: "Lọc danh sách URL đặt textlink thủ công mất thời gian và dễ chọn nhầm URL kém chất lượng.",
    input: "Raw URLs + Keyword",
    logic: "Rule Filtering",
    review: "Quality Check",
    outputStep: "Link Shortlist",
    outputDesc: "Danh sách URL sạch đạt chuẩn chất lượng và file order textlink tự động cho dự án.",
    ctaText: "View demo snapshot",
    ctaLink: "#philosophy"
  },
  {
    id: "portfolio-system",
    name: "Personal SEO Portfolio System",
    status: "Built",
    positioning: "Hệ thống quản lý thông tin năng lực, dự án và case study chuẩn SEO.",
    icon: "💼",
    for: "SEO Specialist, freelancer, personal brand",
    solves: "Thiếu cấu trúc chuyên nghiệp để trình bày các case study sâu sắc và chứng minh tư duy hệ thống.",
    input: "Case Study Data",
    logic: "Design Rules",
    review: "Layout Check",
    outputStep: "SEO Portfolio Site",
    outputDesc: "Trang web portfolio chuẩn SEO, Case Study hub trực quan và project highlight tabs.",
    ctaText: "View live page",
    ctaLink: "/case-studies/"
  }
];

const devTools: ToolItem[] = [
  {
    id: "technical-audit",
    name: "Technical Audit Tool",
    status: "In Development",
    positioning: "Quản lý và gom nhóm lỗi technical tự động theo mức độ nghiêm trọng.",
    icon: "🛠️",
    for: "Technical SEO, SEO Project Leader",
    solves: "Lỗi technical bị phân tán ở nhiều checklist, crawl exports và notes thủ công.",
    input: "Crawl Data",
    logic: "Rule Engine",
    review: "Issue Classify",
    outputStep: "Action Plan",
    outputDesc: "Danh sách lỗi kỹ thuật phân nhóm, độ ưu tiên xử lý và chỉ định template.",
    ctaText: "Coming soon",
    ctaLink: "#dev-tools",
    ctaDisabled: true
  },
  {
    id: "reporting-system",
    name: "SEO Reporting System",
    status: "In Development",
    positioning: "Tự động tổng hợp và ánh xạ KPI từ GSC, rankings và traffic định kỳ.",
    icon: "📊",
    for: "Project Leader, SEO team, Client Reporting",
    solves: "Mất nhiều thời gian gom số liệu từ nhiều nguồn, tính lũy kế và viết báo cáo thủ công.",
    input: "GSC + Rankings",
    logic: "KPI Mapping",
    review: "Period Compare",
    outputStep: "Dashboard Reports",
    outputDesc: "Báo cáo tiến độ KPI tự động, biểu đồ tăng trưởng và ghi chú đề xuất chiến dịch.",
    ctaText: "Coming soon",
    ctaLink: "#dev-tools",
    ctaDisabled: true
  }
];

const allTools = [...builtTools, ...devTools];
---

<BaseLayout 
  title="SEO Tools & Internal Systems | TruThrive" 
  description="Khám phá các công cụ và hệ thống tối ưu nội bộ được thiết kế và xây dựng để quy chuẩn hóa audit, lọc dữ liệu và tăng hiệu suất vận hành SEO thực tế."
>
  <!-- Section 1: Hero Section -->
  <section class="section systems-hero" id="top">
    <div class="container systems-hero__inner">
      <span class="pill">SEO Tools & Systems</span>
      <h1 class="systems-hero__title">
        SEO Tools & Internal Systems
      </h1>
      <p class="systems-hero__desc">
        Các công cụ tôi tự xây từ nhu cầu thực tế khi triển khai nhiều dự án SEO: giảm thao tác thủ công, chuẩn hóa audit và giúp SEO team ra quyết định nhanh hơn.
      </p>
      <div class="systems-hero__chips">
        <span class="hero-chip">Built from real SEO operations</span>
        <span class="hero-chip">Audit, logfile, textlink & reporting workflows</span>
        <span class="hero-chip">Designed for SEO Specialist / Project Leader</span>
      </div>
      <div class="btn-group center" style="margin-top: 28px;">
        <a href="#tool-explorer" class="btn btn-primary">Khám phá tools</a>
        <a href="#dev-tools" class="btn btn-outline">Tools đang phát triển</a>
      </div>
    </div>
  </section>

  <!-- Section 2: Why I Build These Tools -->
  <section class="section systems-why">
    <div class="container">
      <div class="systems-why__heading">
        <p class="section-kicker">Bối cảnh</p>
        <h2 class="section-title">Vì sao tôi xây các công cụ này?</h2>
        <p class="section-subtitle">
          Mỗi tool được tạo ra từ một vấn đề vận hành SEO thực tế: thao tác lặp lại, dữ liệu phân tán và chất lượng audit khó đồng bộ.
        </p>
      </div>
      <div class="systems-why__grid">
        <div class="why-block">
          <span class="why-block__icon">⚡</span>
          <h3 class="why-block__title">Reduce Manual Work</h3>
          <p class="why-block__desc">Giảm các thao tác lọc, kiểm tra, copy/paste và tổng hợp dữ liệu thủ công.</p>
        </div>
        <div class="why-block">
          <span class="why-block__icon">✅</span>
          <h3 class="why-block__title">Standardize Audit Quality</h3>
          <p class="why-block__desc">Chuẩn hóa input, rule, review layer và output để kết quả audit nhất quán hơn.</p>
        </div>
        <div class="why-block">
          <span class="why-block__icon">🎯</span>
          <h3 class="why-block__title">Support Better SEO Decisions</h3>
          <p class="why-block__desc">Tool không thay thế tư duy SEO, mà giúp SEOer nhìn vấn đề nhanh và có cơ sở dữ liệu hơn.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Tool Explorer Workspace -->
  <section class="section" id="tool-explorer" style="padding-top: 24px; padding-bottom: 80px; scroll-margin-top: 80px;">
    <div class="container">
      
      <div class="workspace-heading">
        <h2 class="workspace-heading__title">Tool Explorer</h2>
        <p class="workspace-heading__subtitle">
          Các công cụ tôi xây để chuẩn hóa audit, lọc dữ liệu, phân tích kỹ thuật và tăng tốc vận hành SEO.
        </p>
      </div>

      <!-- ================== DESKTOP: Vertical Tab Workspace ================== -->
      <div class="workspace-desktop" aria-label="SEO Tools Workspace">
        <!-- LEFT: Tool Index Panel -->
        <div class="tool-index-panel" role="tablist" aria-orientation="vertical">
          <div class="tool-group-label">Built & Available</div>
          {builtTools.map((tool, idx) => (
            <button 
              class={`tool-tab ${idx === 0 ? "is-active" : ""}`}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`desktop-panel-${tool.id}`}
              id={`desktop-tab-${tool.id}`}
              tabindex={idx === 0 ? "0" : "-1"}
              data-tool-id={tool.id}
            >
              <span class="tool-tab__icon">{tool.icon}</span>
              <div class="tool-tab__text">
                <span class="tool-tab__name">{tool.name}</span>
                <span class="tool-tab__summary">{tool.positioning}</span>
              </div>
              <span class={`tool-badge tool-badge--${tool.status === "Built" ? "built" : "dev"}`}>{tool.status}</span>
            </button>
          ))}

          <div class="tool-group-label" id="dev-tools">Under Development</div>
          {devTools.map((tool) => (
            <button 
              class="tool-tab"
              role="tab"
              aria-selected="false"
              aria-controls={`desktop-panel-${tool.id}`}
              id={`desktop-tab-${tool.id}`}
              tabindex="-1"
              data-tool-id={tool.id}
            >
              <span class="tool-tab__icon">{tool.icon}</span>
              <div class="tool-tab__text">
                <span class="tool-tab__name">{tool.name}</span>
                <span class="tool-tab__summary">{tool.positioning}</span>
              </div>
              <span class="tool-badge tool-badge--dev">{tool.status}</span>
            </button>
          ))}
        </div>

        <!-- RIGHT: Tool Detail Panel -->
        <div class="tool-detail-panel">
          {allTools.map((tool, idx) => (
            <div 
              class={`tool-detail ${idx === 0 ? "is-active" : ""}`}
              role="tabpanel"
              id={`desktop-panel-${tool.id}`}
              aria-labelledby={`desktop-tab-${tool.id}`}
              aria-hidden={idx === 0 ? "false" : "true"}
            >
              <div class="tool-detail__header">
                <h3 class="tool-detail__title">{tool.name}</h3>
                <span class={`tool-badge tool-badge--${tool.status === "Built" ? "built" : "dev"}`}>{tool.status}</span>
              </div>
              <p class="tool-detail__positioning">{tool.positioning}</p>

              <!-- Visual Preview Area -->
              <div class="tool-detail__preview">
                {tool.id === "content-audit" && (
                  <div class="preview-mock preview-mock--content-audit">
                    <div class="mock-header">
                      <span class="mock-tag">URL Audit: /seo-strategy-v2</span>
                      <span class="mock-badge">Intent: Information</span>
                    </div>
                    <div class="mock-score-row">
                      <span class="mock-score-label">Priority SEO Score</span>
                      <div class="mock-score-bar-wrapper">
                        <div class="mock-score-bar" style="width: 85%;"></div>
                      </div>
                      <span class="mock-score-val">85/100</span>
                    </div>
                    <div class="mock-rows">
                      <div class="mock-row">
                        <span class="mock-row-title">Search Intent Coverage</span>
                        <span class="mock-row-badge badge-warning">Needs Optimization</span>
                      </div>
                      <div class="mock-row">
                        <span class="mock-row-title">Content Gap Analysis</span>
                        <span class="mock-row-badge badge-error">Missing 3 LSI keywords</span>
                      </div>
                      <div class="mock-row">
                        <span class="mock-row-title">Headings Structure (H2/H3)</span>
                        <span class="mock-row-badge badge-success">Passed</span>
                      </div>
                    </div>
                  </div>
                )}

                {tool.id === "logfile-audit" && (
                  <div class="preview-mock preview-mock--logfile-audit">
                    <div class="mock-header">
                      <span class="mock-tag">Googlebot Activity Log</span>
                      <span class="mock-badge">24h Crawl Stats</span>
                    </div>
                    <div class="mock-chart-row">
                      <div class="mock-chart-bar" style="height: 30%;"></div>
                      <div class="mock-chart-bar" style="height: 55%;"></div>
                      <div class="mock-chart-bar" style="height: 40%;"></div>
                      <div class="mock-chart-bar" style="height: 75%;"></div>
                      <div class="mock-chart-bar" style="height: 25%;"></div>
                      <div class="mock-chart-bar" style="height: 60%;"></div>
                      <div class="mock-chart-bar" style="height: 45%;"></div>
                      <div class="mock-chart-bar" style="height: 80%;"></div>
                    </div>
                    <div class="mock-chips">
                      <span class="mock-chip active">Googlebot (Mobile)</span>
                      <span class="mock-chip active">Googlebot (Desktop)</span>
                      <span class="mock-chip muted">AhrefsBot (Blocked)</span>
                    </div>
                    <div class="mock-rows">
                      <div class="mock-row">
                        <span class="mock-row-title">/tag/* crawl waste detected</span>
                        <span class="mock-row-badge badge-error">42% waste</span>
                      </div>
                    </div>
                  </div>
                )}

                {tool.id === "textlink-filter" && (
                  <div class="preview-mock preview-mock--textlink-filter">
                    <div class="mock-header">
                      <span class="mock-tag">Textlink URL Screener</span>
                      <span class="mock-badge">Filter Active</span>
                    </div>
                    <div class="mock-table">
                      <div class="table-header">
                        <span>Domain URL</span>
                        <span>Score</span>
                        <span>Duplicate</span>
                        <span>Select</span>
                      </div>
                      <div class="table-row">
                        <span>agency-review.vn/seo</span>
                        <span class="text-success">9.2</span>
                        <span>No</span>
                        <span class="text-accent">✓ Selected</span>
                      </div>
                      <div class="table-row">
                        <span>forum-tech.net/post-1</span>
                        <span class="text-error">4.1</span>
                        <span class="text-error">Yes</span>
                        <span class="text-muted">Filtered</span>
                      </div>
                      <div class="table-row">
                        <span>tintuc-news.com/marketing</span>
                        <span class="text-success">8.0</span>
                        <span>No</span>
                        <span class="text-accent">✓ Selected</span>
                      </div>
                    </div>
                  </div>
                )}

                {tool.id === "portfolio-system" && (
                  <div class="preview-mock preview-mock--portfolio">
                    <div class="mock-header">
                      <span class="mock-tag">SEO Portfolio Viewport</span>
                      <span class="mock-badge">Static Mode</span>
                    </div>
                    <div class="mock-layout">
                      <div class="mock-profile">
                        <div class="mock-avatar"></div>
                        <div class="mock-lines">
                          <div class="mock-line short"></div>
                          <div class="mock-line long"></div>
                        </div>
                      </div>
                      <div class="mock-cards">
                        <div class="mock-card">
                          <div class="mock-card-title">Suối Tiên Case Study</div>
                          <div class="mock-card-metric">+100% KPI</div>
                        </div>
                        <div class="mock-card">
                          <div class="mock-card-title">DOL Grammar Case Study</div>
                          <div class="mock-card-metric">66.8k traffic</div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {tool.id === "technical-audit" && (
                  <div class="preview-mock preview-mock--tech-audit">
                    <div class="mock-header">
                      <span class="mock-tag">Tech Crawl Diagnostics</span>
                      <span class="mock-badge">Mock Mode</span>
                    </div>
                    <div class="mock-rows">
                      <div class="mock-row">
                        <span class="mock-row-title">404 Redirect Loops</span>
                        <span class="mock-row-badge badge-error">Critical</span>
                      </div>
                      <div class="mock-row">
                        <span class="mock-row-title">Missing Canonical URLs</span>
                        <span class="mock-row-badge badge-error">High</span>
                      </div>
                      <div class="mock-row">
                        <span class="mock-row-title">Missing Schema markup</span>
                        <span class="mock-row-badge badge-warning">Medium</span>
                      </div>
                    </div>
                  </div>
                )}

                {tool.id === "reporting-system" && (
                  <div class="preview-mock preview-mock--reporting">
                    <div class="mock-header">
                      <span class="mock-tag">Client Performance Reporting</span>
                      <span class="mock-badge">Active Sheet</span>
                    </div>
                    <div class="mock-metrics">
                      <div class="metric-box">
                        <span class="metric-title">GSC Organic Clicks</span>
                        <span class="metric-val text-success">+32.4%</span>
                      </div>
                      <div class="metric-box">
                        <span class="metric-title">KPI Achievement Rate</span>
                        <span class="metric-val">94.8%</span>
                      </div>
                    </div>
                    <div class="mock-progress-bar-wrapper">
                      <div class="mock-progress-bar" style="width: 94%;"></div>
                    </div>
                  </div>
                )}
              </div>

              <!-- Product metadata -->
              <div class="tool-detail__meta">
                <div class="tool-detail__meta-row">
                  <span class="tool-detail__meta-label">Built for</span>
                  <span class="tool-detail__meta-val">{tool.for}</span>
                </div>
                <div class="tool-detail__meta-row">
                  <span class="tool-detail__meta-label">Solves</span>
                  <span class="tool-detail__meta-val">{tool.solves}</span>
                </div>
                <div class="tool-detail__meta-row">
                  <span class="tool-detail__meta-label">Output</span>
                  <span class="tool-detail__meta-val"><strong>{tool.outputDesc}</strong></span>
                </div>
              </div>

              <!-- Logic flow horizontal chain -->
              <div class="tool-detail__logic">
                <span class="tool-detail__logic-title">Logic Flow Pipeline</span>
                <div class="tool-logic-flow__chips">
                  <div class="logic-chip">
                    <span class="logic-chip-label">Input</span>
                    <span class="logic-chip-val">{tool.input}</span>
                  </div>
                  <div class="logic-arrow">→</div>
                  <div class="logic-chip">
                    <span class="logic-chip-label">Processing</span>
                    <span class="logic-chip-val">{tool.logic}</span>
                  </div>
                  <div class="logic-arrow">→</div>
                  <div class="logic-chip">
                    <span class="logic-chip-label">Review</span>
                    <span class="logic-chip-val">{tool.review}</span>
                  </div>
                  <div class="logic-arrow">→</div>
                  <div class="logic-chip">
                    <span class="logic-chip-label">Output</span>
                    <span class="logic-chip-val">{tool.outputStep}</span>
                  </div>
                </div>
              </div>

              <!-- CTA -->
              <div class="tool-detail__footer">
                {tool.ctaDisabled ? (
                  <span class="btn btn-secondary" style="opacity: 0.6; cursor: not-allowed;">{tool.ctaText}</span>
                ) : (
                  <a href={tool.ctaLink} class="btn btn-primary">{tool.ctaText} →</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ================== MOBILE: Accordion Workspace ================== -->
      <div class="workspace-mobile">
        <div class="accordion-group-label">Built & Available</div>
        {builtTools.map((tool, idx) => (
          <div class={`accordion-item ${idx === 0 ? "is-open" : ""}`} data-tool-id={tool.id}>
            <button 
              class="accordion-trigger"
              aria-expanded={idx === 0 ? "true" : "false"}
              aria-controls={`mobile-panel-${tool.id}`}
              id={`mobile-trigger-${tool.id}`}
            >
              <span class="accordion-trigger__icon">{tool.icon}</span>
              <div class="accordion-trigger__text">
                <span class="accordion-trigger__name">{tool.name}</span>
              </div>
              <span class={`tool-badge tool-badge--${tool.status === "Built" ? "built" : "dev"}`}>{tool.status}</span>
              <span class="accordion-chevron" aria-hidden="true"></span>
            </button>

            <div 
              class="accordion-panel"
              id={`mobile-panel-${tool.id}`}
              aria-labelledby={`mobile-trigger-${tool.id}`}
              role="region"
            >
              <p class="accordion-panel__positioning">{tool.positioning}</p>

              <!-- Visual Preview Area (same markup as desktop) -->
              <div class="tool-detail__preview">
                {tool.id === "content-audit" && (
                  <div class="preview-mock preview-mock--content-audit">
                    <div class="mock-header">
                      <span class="mock-tag">URL Audit: /seo-strategy-v2</span>
                      <span class="mock-badge">Intent: Information</span>
                    </div>
                    <div class="mock-score-row">
                      <span class="mock-score-label">Priority SEO Score</span>
                      <div class="mock-score-bar-wrapper">
                        <div class="mock-score-bar" style="width: 85%;"></div>
                      </div>
                      <span class="mock-score-val">85/100</span>
                    </div>
                    <div class="mock-rows">
                      <div class="mock-row">
                        <span class="mock-row-title">Search Intent Coverage</span>
                        <span class="mock-row-badge badge-warning">Needs Optimization</span>
                      </div>
                      <div class="mock-row">
                        <span class="mock-row-title">Content Gap Analysis</span>
                        <span class="mock-row-badge badge-error">Missing 3 LSI keywords</span>
                      </div>
                      <div class="mock-row">
                        <span class="mock-row-title">Headings (H2/H3)</span>
                        <span class="mock-row-badge badge-success">Passed</span>
                      </div>
                    </div>
                  </div>
                )}
                {tool.id === "logfile-audit" && (
                  <div class="preview-mock preview-mock--logfile-audit">
                    <div class="mock-header">
                      <span class="mock-tag">Googlebot Activity Log</span>
                      <span class="mock-badge">24h Crawl Stats</span>
                    </div>
                    <div class="mock-chart-row">
                      <div class="mock-chart-bar" style="height: 30%;"></div>
                      <div class="mock-chart-bar" style="height: 55%;"></div>
                      <div class="mock-chart-bar" style="height: 40%;"></div>
                      <div class="mock-chart-bar" style="height: 75%;"></div>
                      <div class="mock-chart-bar" style="height: 25%;"></div>
                      <div class="mock-chart-bar" style="height: 60%;"></div>
                      <div class="mock-chart-bar" style="height: 45%;"></div>
                      <div class="mock-chart-bar" style="height: 80%;"></div>
                    </div>
                    <div class="mock-chips">
                      <span class="mock-chip active">Googlebot (Mobile)</span>
