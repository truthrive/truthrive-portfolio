                        <span class="mock-row-title">404 Redirect Loops</span>
                        <span class="mock-row-badge badge-error">Critical</span>
                      </div>
                      <div class="mock-row">
                        <span class="mock-row-title">Missing Canonical URLs</span>
                        <span class="mock-row-badge badge-error">High</span>
                      </div>
                      <div class="mock-row">
                        <span class="mock-row-title">Missing Schema</span>
                        <span class="mock-row-badge badge-warning">Medium</span>
                      </div>
                    </div>
                  </div>
                )}
                {tool.id === "reporting-system" && (
                  <div class="preview-mock preview-mock--reporting">
                    <div class="mock-header">
                      <span class="mock-tag">Performance Reporting</span>
                      <span class="mock-badge">Active Sheet</span>
                    </div>
                    <div class="mock-metrics">
                      <div class="metric-box">
                        <span class="metric-title">GSC Organic Clicks</span>
                        <span class="metric-val text-success">+32.4%</span>
                      </div>
                      <div class="metric-box">
                        <span class="metric-title">KPI Achievement Rate</span>
                        <span class="metric-val">94.8%</span>
                      </div>
                    </div>
                    <div class="mock-progress-bar-wrapper">
                      <div class="mock-progress-bar" style="width: 94%;"></div>
                    </div>
                  </div>
                )}
              </div>

              <div class="tool-detail__meta">
                <div class="tool-detail__meta-row">
                  <span class="tool-detail__meta-label">Built for</span>
                  <span class="tool-detail__meta-val">{tool.for}</span>
                </div>
                <div class="tool-detail__meta-row">
                  <span class="tool-detail__meta-label">Solves</span>
                  <span class="tool-detail__meta-val">{tool.solves}</span>
                </div>
                <div class="tool-detail__meta-row">
                  <span class="tool-detail__meta-label">Output</span>
                  <span class="tool-detail__meta-val"><strong>{tool.outputDesc}</strong></span>
                </div>
              </div>

              <div class="tool-detail__logic">
                <span class="tool-detail__logic-title">Logic Flow Pipeline</span>
                <div class="tool-logic-flow__chips">
                  <div class="logic-chip">
                    <span class="logic-chip-label">Input</span>
                    <span class="logic-chip-val">{tool.input}</span>
                  </div>
                  <div class="logic-arrow">↓</div>
                  <div class="logic-chip">
                    <span class="logic-chip-label">Processing</span>
                    <span class="logic-chip-val">{tool.logic}</span>
                  </div>
                  <div class="logic-arrow">↓</div>
                  <div class="logic-chip">
                    <span class="logic-chip-label">Review</span>
                    <span class="logic-chip-val">{tool.review}</span>
                  </div>
                  <div class="logic-arrow">↓</div>
                  <div class="logic-chip">
                    <span class="logic-chip-label">Output</span>
                    <span class="logic-chip-val">{tool.outputStep}</span>
                  </div>
                </div>
              </div>

              <div class="tool-detail__footer">
                <span class="btn btn-secondary" style="opacity: 0.6; cursor: not-allowed;">{tool.ctaText}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <p class="workspace-note">
        * Các công cụ này được thiết kế và lập trình hoàn toàn dựa trên kinh nghiệm giải quyết các bài toán vận hành thực tế của Senior SEO Specialist, không phải là sản phẩm thương mại thương hiệu (SaaS).
      </p>

    </div>
  </section>

  <!-- Section 3: System Design Philosophy -->
  <section id="philosophy" class="section section-muted" style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 72px 0 88px 0; scroll-margin-top: 100px;">
    <div class="container">
      <div class="section-heading text-center" style="max-width: 800px; margin-bottom: 56px;">
        <p class="section-kicker">Thiết kế hệ thống</p>
        <h2 class="section-title">Triết lý xử lý dữ liệu</h2>
        <p class="section-subtitle">
          Quy trình thiết kế chung cho mọi cấu trúc công cụ tôi phát triển, đảm bảo đầu ra luôn chính xác và có giá trị hành động.
        </p>
      </div>

      <div class="philosophy-pipeline">
        <!-- Step 1 -->
        <div class="philosophy-step">
          <span class="philosophy-step-num">01</span>
          <h3 class="philosophy-step-title">Input</h3>
          <p class="philosophy-step-desc">
            Dữ liệu từ GSC, crawl, logfile, keyword sheet hoặc sitemaps thô.
          </p>
        </div>

        <div class="pipeline-arrow">
          <span class="pipeline-arrow-desktop">→</span>
          <span class="pipeline-arrow-mobile">↓</span>
        </div>

        <!-- Step 2 -->
        <div class="philosophy-step">
          <span class="philosophy-step-num">02</span>
          <h3 class="philosophy-step-title">Rules</h3>
          <p class="philosophy-step-desc">
            Bộ tiêu chí, quy tắc kiểm duyệt chuẩn hóa theo từng mục tiêu tối ưu.
          </p>
        </div>

        <div class="pipeline-arrow">
          <span class="pipeline-arrow-desktop">→</span>
          <span class="pipeline-arrow-mobile">↓</span>
        </div>

        <!-- Step 3 -->
        <div class="philosophy-step">
          <span class="philosophy-step-num">03</span>
          <h3 class="philosophy-step-title">Scoring / Filtering</h3>
          <p class="philosophy-step-desc">
            Tự động sắp xếp mức độ ưu tiên, chấm điểm hoặc lọc bỏ dữ liệu nhiễu.
          </p>
        </div>

        <div class="pipeline-arrow">
          <span class="pipeline-arrow-desktop">→</span>
          <span class="pipeline-arrow-mobile">↓</span>
        </div>

        <!-- Step 4 -->
        <div class="philosophy-step">
          <span class="philosophy-step-num">04</span>
          <h3 class="philosophy-step-title">Review Layer</h3>
          <p class="philosophy-step-desc">
            Chuyên viên kiểm duyệt lại để đảm bảo tính thực tiễn và ngữ cảnh dự án.
          </p>
        </div>

        <div class="pipeline-arrow">
          <span class="pipeline-arrow-desktop">→</span>
          <span class="pipeline-arrow-mobile">↓</span>
        </div>

        <!-- Step 5 -->
        <div class="philosophy-step">
          <span class="philosophy-step-num">05</span>
          <h3 class="philosophy-step-title">Output</h3>
          <p class="philosophy-step-desc">
            Checklist hành động, shortlist hoặc dashboard chiến dịch sẵn sàng vận hành.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Final CTA Section -->
  <section class="section section-dark" style="padding: 80px 0; border-top: 1px solid rgba(255, 255, 255, 0.1);">
    <div class="container text-center" style="max-width: 800px; text-align: center; margin-inline: auto;">
      <p class="section-kicker" style="color: rgba(255, 248, 240, 0.65);">Áp dụng thực tế</p>
      <h2 class="section-title" style="color: var(--color-footer-text); margin-bottom: 20px;">Muốn xem các tool này được dùng trong dự án thực tế?</h2>
      <p class="section-subtitle" style="color: rgba(255, 248, 240, 0.75); margin-bottom: 40px; max-width: 600px; margin-left: auto; margin-right: auto;">
        Xem cách tôi áp dụng tooling, workflow và SEO strategy trong các case study đã triển khai.
      </p>
      <div class="btn-group center">
        <a href="/case-studies/" class="btn btn-primary">Xem Case Studies</a>
        <a href={cvUrl} download class="btn btn-light" aria-label="Tải xuống CV của Bùi Trường Thịnh">Tải xuống CV</a>
      </div>
    </div>
  </section>
</BaseLayout>

