<script>
  document.addEventListener('DOMContentLoaded', () => {
    const explorer = document.getElementById('tool-explorer');
    const desktopWorkspace = document.querySelector('.workspace-desktop');
    const mobileWorkspace = document.querySelector('.workspace-mobile');
    const tabs = desktopWorkspace ? Array.from(desktopWorkspace.querySelectorAll('.tool-tab')) as HTMLButtonElement[] : [];
    const panels = desktopWorkspace ? Array.from(desktopWorkspace.querySelectorAll('.tool-detail')) as HTMLElement[] : [];
    const mobileItems = mobileWorkspace ? Array.from(mobileWorkspace.querySelectorAll('.accordion-item')) as HTMLElement[] : [];
    const hashToToolId = new Map<string, string>();
    const toolIdToHash = new Map<string, string>();
    const defaultToolId = tabs.find((tab) => tab.classList.contains('is-active'))?.dataset.toolId;

    tabs.forEach((tab) => {
      const toolId = tab.dataset.toolId;
      const toolHash = tab.dataset.toolHash;
      if (toolId && toolHash) {
        hashToToolId.set(toolHash, toolId);
        toolIdToHash.set(toolId, toolHash);
      }
    });

    const activateDesktopTab = (targetId: string) => {
      tabs.forEach((tab) => {
        const isTarget = tab.dataset.toolId === targetId;
        tab.classList.toggle('is-active', isTarget);
        tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
        tab.setAttribute('tabindex', isTarget ? '0' : '-1');
      });

      panels.forEach((panel) => {
        const panelId = panel.id.replace('desktop-panel-', '');
        const isTarget = panelId === targetId;
        panel.classList.toggle('is-active', isTarget);
        panel.setAttribute('aria-hidden', isTarget ? 'false' : 'true');
      });
    };

    const activateMobileItem = (targetId: string) => {
      mobileItems.forEach((item) => {
        const isTarget = item.dataset.toolId === targetId;
        item.classList.toggle('is-open', isTarget);
        const trigger = item.querySelector('.accordion-trigger') as HTMLButtonElement | null;
        if (trigger) trigger.setAttribute('aria-expanded', isTarget ? 'true' : 'false');
      });
    };

    const activateTool = (targetId: string) => {
      if (!toolIdToHash.has(targetId)) return false;
      activateDesktopTab(targetId);
      activateMobileItem(targetId);
      return true;
    };

    const updateHashForTool = (toolId: string) => {
      const toolHash = toolIdToHash.get(toolId);
      if (!toolHash || window.location.hash === `#${toolHash}`) return;
      window.location.hash = toolHash;
    };

    const activateFromHash = (shouldScroll: boolean) => {
      const toolHash = decodeURIComponent(window.location.hash.slice(1));
      if (!toolHash) {
        if (!shouldScroll && defaultToolId) activateTool(defaultToolId);
        return;
      }

      const toolId = hashToToolId.get(toolHash);
      if (!toolId || !activateTool(toolId)) return;

      if (shouldScroll && explorer) {
        window.requestAnimationFrame(() => {
          explorer.scrollIntoView({ block: 'start' });
        });
      }
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        const toolId = tab.dataset.toolId;
        if (toolId && activateTool(toolId)) updateHashForTool(toolId);
      });

      tab.addEventListener('keydown', (event: KeyboardEvent) => {
        let targetIdx = idx;

        if (event.key === 'ArrowDown') {
          event.preventDefault();
          targetIdx = (idx + 1) % tabs.length;
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          targetIdx = (idx - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          event.preventDefault();
          targetIdx = 0;
        } else if (event.key === 'End') {
          event.preventDefault();
          targetIdx = tabs.length - 1;
        } else {
          return;
        }

        tabs[targetIdx].focus();
        const toolId = tabs[targetIdx].dataset.toolId;
        if (toolId && activateTool(toolId)) updateHashForTool(toolId);
      });
    });

    mobileItems.forEach((item) => {
      const trigger = item.querySelector('.accordion-trigger') as HTMLButtonElement | null;
      if (!trigger) return;

      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        const toolId = item.dataset.toolId;
        if (!toolId) return;

        if (item.classList.contains('is-open')) {
          item.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
          return;
        }

        if (activateTool(toolId)) updateHashForTool(toolId);
      });
    });

    window.addEventListener('hashchange', () => activateFromHash(false));
    activateFromHash(true);
  });
</script>
